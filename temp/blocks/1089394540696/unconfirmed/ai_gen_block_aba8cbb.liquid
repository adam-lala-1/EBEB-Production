{% doc %}
  @prompt
    generate a dealer hero banner with bg image and on the left side display the banner content for desktop and for mobile add opacity and display the content,  and in content we have eyebrow heading h1 descirption part and a two buttons consequitively with buttons icons as well
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-dealer-hero-{{ ai_gen_id }} {
    display: block;
    position: relative;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    min-height: {{ block.settings.banner_height }}px;
    overflow: hidden;
    background: {{ block.settings.background_color }};
    color: {{ block.settings.text_color }};
  }

  .ai-dealer-hero-{{ ai_gen_id }}__image,
  .ai-dealer-hero-{{ ai_gen_id }}__placeholder,
  .ai-dealer-hero-{{ ai_gen_id }}__shade {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .ai-dealer-hero-{{ ai_gen_id }}__image {
    object-fit: cover;
  }

  .ai-dealer-hero-{{ ai_gen_id }}__placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    background: #e9edf1;
  }

  .ai-dealer-hero-{{ ai_gen_id }}__placeholder svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-dealer-hero-{{ ai_gen_id }}__empty-text {
    position: absolute;
    bottom: 18px;
    left: 50%;
    transform: translateX(-50%);
    padding: 8px 12px;
    color: #1b2a4a;
    background: #fff;
    font-size: 13px;
    white-space: nowrap;
  }

  .ai-dealer-hero-{{ ai_gen_id }}__shade {
    background: linear-gradient(90deg, rgba(10, 24, 46, 0.72), rgba(10, 24, 46, 0.08) 72%);
    pointer-events: none;
  }

  .ai-dealer-hero-{{ ai_gen_id }}__content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    width: min(100%, 650px);
    min-height: {{ block.settings.banner_height }}px;
    padding: 56px clamp(24px, 7vw, 96px);
    box-sizing: border-box;
  }

  .ai-dealer-hero-{{ ai_gen_id }}__eyebrow {
    margin: 0 0 14px;
    color: {{ block.settings.eyebrow_color }};
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.12em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .ai-dealer-hero-{{ ai_gen_id }}__heading {
    margin: 0;
    color: {{ block.settings.text_color }};
    font-size: clamp(34px, 4.8vw, {{ block.settings.heading_size }}px);
    line-height: 1.08;
    font-weight: 750;
  }

  .ai-dealer-hero-{{ ai_gen_id }}__description {
    max-width: 540px;
    margin-top: 18px;
    color: {{ block.settings.text_color }};
    font-size: 16px;
    line-height: 1.6;
  }

  .ai-dealer-hero-{{ ai_gen_id }}__description p {
    margin: 0;
  }

  .ai-dealer-hero-{{ ai_gen_id }}__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 28px;
  }

  .ai-dealer-hero-{{ ai_gen_id }}__button {
    display: inline-flex;
    min-height: 48px;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 12px 20px;
    border: 2px solid {{ block.settings.primary_button_color }};
    border-radius: {{ block.settings.button_radius }}px;
    background: {{ block.settings.primary_button_color }};
    color: {{ block.settings.primary_button_text }};
    font-size: 15px;
    font-weight: 700;
    line-height: 1.2;
    text-decoration: none;
    transition: background-color 0.2s ease, color 0.2s ease;
  }

  .ai-dealer-hero-{{ ai_gen_id }}__button:hover {
    background: {{ block.settings.primary_hover_color }};
    border-color: {{ block.settings.primary_hover_color }};
    color: {{ block.settings.primary_button_text }};
  }

  .ai-dealer-hero-{{ ai_gen_id }}__button--secondary {
    border-color: {{ block.settings.secondary_button_border }};
    background: {{ block.settings.secondary_button_background }};
    color: {{ block.settings.secondary_button_text }};
  }

  .ai-dealer-hero-{{ ai_gen_id }}__button--secondary:hover {
    background: {{ block.settings.secondary_hover_color }};
    border-color: {{ block.settings.secondary_hover_color }};
    color: {{ block.settings.secondary_button_text }};
  }

  .ai-dealer-hero-{{ ai_gen_id }}__button svg {
    width: 18px;
    height: 18px;
    flex: 0 0 18px;
  }

  .ai-dealer-hero-{{ ai_gen_id }}__button:focus-visible {
    outline: 3px solid #fff;
    outline-offset: 3px;
  }

  @media screen and (max-width: 749px) {
    .ai-dealer-hero-{{ ai_gen_id }} {
      min-height: {{ block.settings.mobile_height }}px;
    }

    .ai-dealer-hero-{{ ai_gen_id }}__shade {
      background: rgba(10, 24, 46, {{ block.settings.mobile_overlay_opacity | divided_by: 100.0 }});
    }

    .ai-dealer-hero-{{ ai_gen_id }}__content {
      width: 100%;
      min-height: {{ block.settings.mobile_height }}px;
      padding: 36px 24px;
    }

    .ai-dealer-hero-{{ ai_gen_id }}__heading {
      font-size: clamp(32px, 9vw, 48px);
    }

    .ai-dealer-hero-{{ ai_gen_id }}__actions {
      flex-direction: column;
      align-items: stretch;
      width: 100%;
    }

    .ai-dealer-hero-{{ ai_gen_id }}__button {
      width: 100%;
      box-sizing: border-box;
    }
  }
{% endstyle %}

<div class="ai-dealer-hero-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.background_image != blank %}
    <img
      class="ai-dealer-hero-{{ ai_gen_id }}__image"
      src="{{ block.settings.background_image | image_url: width: 2400 }}"
      alt="{{ block.settings.background_image.alt | escape }}"
      width="{{ block.settings.background_image.width }}"
      height="{{ block.settings.background_image.height }}"
      loading="lazy"
    >
  {% else %}
    <div class="ai-dealer-hero-{{ ai_gen_id }}__placeholder">
      {{ 'hero-apparel-1' | placeholder_svg_tag }}
      <span class="ai-dealer-hero-{{ ai_gen_id }}__empty-text">Add a banner image to get started</span>
    </div>
  {% endif %}
  <div class="ai-dealer-hero-{{ ai_gen_id }}__shade" aria-hidden="true"></div>
  <div class="ai-dealer-hero-{{ ai_gen_id }}__content">
    {% if block.settings.eyebrow != blank %}<p class="ai-dealer-hero-{{ ai_gen_id }}__eyebrow">{{ block.settings.eyebrow | escape }}</p>{% endif %}
    {% if block.settings.heading != blank %}<h1 class="ai-dealer-hero-{{ ai_gen_id }}__heading">{{ block.settings.heading | escape }}</h1>{% endif %}
    {% if block.settings.description != blank %}<div class="ai-dealer-hero-{{ ai_gen_id }}__description">{{ block.settings.description }}</div>{% endif %}
    <div class="ai-dealer-hero-{{ ai_gen_id }}__actions">
      {% if block.settings.primary_label != blank and block.settings.primary_link != blank %}
        <a class="ai-dealer-hero-{{ ai_gen_id }}__button" href="{{ block.settings.primary_link }}">
          {{ block.settings.primary_label | escape }}
          {% if block.settings.primary_icon == 'arrow' %}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round"/></svg>{% elsif block.settings.primary_icon == 'external' %}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M14 4h6v6M20 4l-9 9" stroke-linecap="round" stroke-linejoin="round"/><path d="M18 13v6a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h6" stroke-linecap="round" stroke-linejoin="round"/></svg>{% endif %}
        </a>
      {% endif %}
      {% if block.settings.secondary_label != blank and block.settings.secondary_link != blank %}
        <a class="ai-dealer-hero-{{ ai_gen_id }}__button ai-dealer-hero-{{ ai_gen_id }}__button--secondary" href="{{ block.settings.secondary_link }}">
          {{ block.settings.secondary_label | escape }}
          {% if block.settings.secondary_icon == 'arrow' %}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round"/></svg>{% elsif block.settings.secondary_icon == 'external' %}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M14 4h6v6M20 4l-9 9" stroke-linecap="round" stroke-linejoin="round"/><path d="M18 13v6a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h6" stroke-linecap="round" stroke-linejoin="round"/></svg>{% endif %}
        </a>
      {% endif %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Dealer hero banner",
  "settings": [
    { "type": "image_picker", "id": "background_image", "label": "Background image" },
    { "type": "range", "id": "desktop_width_percent", "label": "Desktop width", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "range", "id": "banner_height", "label": "Desktop height", "min": 360, "max": 800, "step": 20, "unit": "px", "default": 560 },
    { "type": "range", "id": "mobile_height", "label": "Mobile height", "min": 400, "max": 800, "step": 20, "unit": "px", "default": 600 },
    { "type": "range", "id": "mobile_overlay_opacity", "label": "Mobile overlay opacity", "min": 0, "max": 90, "step": 10, "unit": "%", "default": 60 },
    { "type": "header", "content": "Banner content" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Find your local dealer" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Ride further, together" },
    { "type": "richtext", "id": "description", "label": "Description", "default": "<p>Discover trusted local dealers for expert advice, test rides and ongoing support.</p>" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#FFFFFF" },
    { "type": "color", "id": "eyebrow_color", "label": "Eyebrow", "default": "#FF9B5E" },
    { "type": "color", "id": "background_color", "label": "Fallback background", "default": "#1B2A4A" },
    { "type": "range", "id": "heading_size", "label": "Heading size", "min": 36, "max": 72, "step": 4, "unit": "px", "default": 56 },
    { "type": "header", "content": "First button" },
    { "type": "text", "id": "primary_label", "label": "Label", "default": "Find a dealer" },
    { "type": "url", "id": "primary_link", "label": "Link" },
    { "type": "select", "id": "primary_icon", "label": "Icon", "options": [{ "value": "arrow", "label": "Arrow" }, { "value": "external", "label": "External link" }, { "value": "none", "label": "No icon" }], "default": "arrow" },
    { "type": "color", "id": "primary_button_color", "label": "Background", "default": "#E86C2C" },
    { "type": "color", "id": "primary_button_text", "label": "Text", "default": "#FFFFFF" },
    { "type": "color", "id": "primary_hover_color", "label": "Hover background", "default": "#C94F13" },
    { "type": "header", "content": "Second button" },
    { "type": "text", "id": "secondary_label", "label": "Label", "default": "Become a dealer" },
    { "type": "url", "id": "secondary_link", "label": "Link" },
    { "type": "select", "id": "secondary_icon", "label": "Icon", "options": [{ "value": "arrow", "label": "Arrow" }, { "value": "external", "label": "External link" }, { "value": "none", "label": "No icon" }], "default": "arrow" },
    { "type": "color", "id": "secondary_button_background", "label": "Background", "default": "#FFFFFF" },
    { "type": "color", "id": "secondary_button_text", "label": "Text", "default": "#1B2A4A" },
    { "type": "color", "id": "secondary_button_border", "label": "Border", "default": "#FFFFFF" },
    { "type": "color", "id": "secondary_hover_color", "label": "Hover background", "default": "#E5E7EB" },
    { "type": "range", "id": "button_radius", "label": "Button corner radius", "min": 0, "max": 24, "step": 2, "unit": "px", "default": 8 }
  ],
  "presets": [{ "name": "Dealer hero banner" }],
  "tag": null,
  "class": "dealer-hero-banner"
}
{% endschema %}