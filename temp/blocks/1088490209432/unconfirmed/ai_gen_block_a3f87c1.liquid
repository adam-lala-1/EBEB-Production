{% doc %}
  @prompt
    one more usp section with light background different from home page, and it has 3 usps, left side image and right side heading and a apara and a divider in between  uso
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-usp-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    box-sizing: border-box;
    padding: {{ block.settings.padding }}px;
    background: {{ block.settings.background_color }};
    color: {{ block.settings.text_color }};
  }

  .ai-usp-{{ ai_gen_id }}__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 40px;
    align-items: center;
    max-width: 1280px;
    margin: 0 auto;
  }

  .ai-usp-{{ ai_gen_id }}__media {
    overflow: hidden;
    border-radius: {{ block.settings.image_radius }}px;
  }

  .ai-usp-{{ ai_gen_id }}__media img,
  .ai-usp-{{ ai_gen_id }}__placeholder svg {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  .ai-usp-{{ ai_gen_id }}__placeholder {
    position: relative;
    background: #e9e7e3;
  }

  .ai-usp-{{ ai_gen_id }}__placeholder svg {
    color: #777;
  }

  .ai-usp-{{ ai_gen_id }}__empty {
    position: absolute;
    left: 16px;
    right: 16px;
    bottom: 14px;
    padding: 9px 12px;
    background: rgba(255,255,255,.94);
    color: #333;
    font-size: 13px;
    text-align: center;
  }

  .ai-usp-{{ ai_gen_id }}__content { min-width: 0; }

  .ai-usp-{{ ai_gen_id }}__heading {
    margin: 0 0 20px;
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.heading_size }}px;
    line-height: 1.15;
  }

  .ai-usp-{{ ai_gen_id }}__list { display: grid; }

  .ai-usp-{{ ai_gen_id }}__item {
    padding: 18px 0;
    border-bottom: 1px solid {{ block.settings.divider_color }};
  }

  .ai-usp-{{ ai_gen_id }}__item:first-child { padding-top: 0; }
  .ai-usp-{{ ai_gen_id }}__item:last-child { border-bottom: 0; padding-bottom: 0; }

  .ai-usp-{{ ai_gen_id }}__title {
    margin: 0 0 6px;
    color: {{ block.settings.text_color }};
    font-size: 18px;
    line-height: 1.35;
    font-weight: 700;
  }

  .ai-usp-{{ ai_gen_id }}__text {
    color: {{ block.settings.text_color }};
    font-size: 15px;
    line-height: 1.6;
  }

  .ai-usp-{{ ai_gen_id }}__text p { margin: 0; }

  @media screen and (max-width: 749px) {
    .ai-usp-{{ ai_gen_id }} { padding: 28px 20px; }
    .ai-usp-{{ ai_gen_id }}__inner { grid-template-columns: 1fr; gap: 26px; }
    .ai-usp-{{ ai_gen_id }}__heading { font-size: {{ block.settings.heading_size | times: 0.8 }}px; }
  }
{% endstyle %}

<div class="ai-usp-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-usp-{{ ai_gen_id }}__inner">
    <div class="ai-usp-{{ ai_gen_id }}__media">
      {% if block.settings.image != blank %}
        <img src="{{ block.settings.image | image_url: width: 1400 }}" alt="{{ block.settings.image.alt | escape }}" loading="lazy" width="{{ block.settings.image.width }}" height="{{ block.settings.image.height }}">
      {% else %}
        <div class="ai-usp-{{ ai_gen_id }}__placeholder">
          {{ 'image' | placeholder_svg_tag }}
          <div class="ai-usp-{{ ai_gen_id }}__empty">Add an image to complete this section</div>
        </div>
      {% endif %}
    </div>
    <div class="ai-usp-{{ ai_gen_id }}__content">
      {% if block.settings.heading != blank %}<h2 class="ai-usp-{{ ai_gen_id }}__heading">{{ block.settings.heading | escape }}</h2>{% endif %}
      <div class="ai-usp-{{ ai_gen_id }}__list">
        {% for i in (1..3) %}
          {% liquid
            assign title_key = 'usp_' | append: i | append: '_title'
            assign text_key = 'usp_' | append: i | append: '_text'
            assign usp_title = block.settings[title_key]
            assign usp_text = block.settings[text_key]
          %}
          {% if usp_title != blank or usp_text != blank %}
            <div class="ai-usp-{{ ai_gen_id }}__item">
              {% if usp_title != blank %}<h3 class="ai-usp-{{ ai_gen_id }}__title">{{ usp_title | escape }}</h3>{% endif %}
              {% if usp_text != blank %}<div class="ai-usp-{{ ai_gen_id }}__text">{{ usp_text }}</div>{% endif %}
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Image and 3 USPs",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Why choose EveryBody eBikes?" },
    { "type": "text", "id": "usp_1_title", "label": "USP 1 heading", "default": "Made for every ride" },
    { "type": "richtext", "id": "usp_1_text", "label": "USP 1 description", "default": "<p>Find a comfortable, dependable ride for your everyday adventures.</p>" },
    { "type": "text", "id": "usp_2_title", "label": "USP 2 heading", "default": "Expert help, close to home" },
    { "type": "richtext", "id": "usp_2_text", "label": "USP 2 description", "default": "<p>Our team is here to help you choose the right eBike and get the most from it.</p>" },
    { "type": "text", "id": "usp_3_title", "label": "USP 3 heading", "default": "Support after you ride away" },
    { "type": "richtext", "id": "usp_3_text", "label": "USP 3 description", "default": "<p>Count on ongoing care and guidance throughout your eBike journey.</p>" },
    { "type": "header", "content": "Appearance" },
    { "type": "range", "id": "desktop_width_percent", "label": "Desktop width", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "range", "id": "padding", "label": "Section padding", "min": 20, "max": 80, "step": 5, "unit": "px", "default": 40 },
    { "type": "range", "id": "heading_size", "label": "Heading size", "min": 24, "max": 48, "step": 2, "unit": "px", "default": 34 },
    { "type": "range", "id": "image_radius", "label": "Image corner radius", "min": 0, "max": 30, "step": 2, "unit": "px", "default": 8 },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#F8F5F0" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#1B2A4A" },
    { "type": "color", "id": "divider_color", "label": "Divider", "default": "#D9D5CF" }
  ],
  "presets": [{ "name": "Image and 3 USPs" }],
  "tag": null,
  "class": "image-usp-block"
}
{% endschema %}