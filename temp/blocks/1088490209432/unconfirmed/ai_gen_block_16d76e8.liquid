{% doc %}
  @prompt
    generate a section with bg color, and the section has 2 cols, left col, has heading , sub heading , and a text followed by 2 buttons,  and right col has, 4 lists, each list has an icon and a text, and 2 lists should be in one line
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-feature-panel-{{ ai_gen_id }} {
    display: block;
    box-sizing: border-box;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: {{ block.settings.section_padding }}px 5%;
    background: {{ block.settings.background_color }};
    color: {{ block.settings.text_color }};
  }

  .ai-feature-panel-{{ ai_gen_id }}__inner {
    width: 100%;
    max-width: 1280px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 56px;
    align-items: center;
  }

  .ai-feature-panel-{{ ai_gen_id }}__content {
    min-width: 0;
  }

  .ai-feature-panel-{{ ai_gen_id }}__eyebrow {
    margin: 0 0 12px;
    color: {{ block.settings.accent_color }};
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .ai-feature-panel-{{ ai_gen_id }}__heading {
    margin: 0 0 12px;
    color: inherit;
    font-size: clamp(30px, 4vw, 48px);
    line-height: 1.12;
  }

  .ai-feature-panel-{{ ai_gen_id }}__subheading {
    margin: 0 0 16px;
    font-size: 20px;
    line-height: 1.4;
    font-weight: 600;
  }

  .ai-feature-panel-{{ ai_gen_id }}__body {
    margin-bottom: 24px;
    line-height: 1.65;
  }

  .ai-feature-panel-{{ ai_gen_id }}__body p { margin: 0 0 12px; }
  .ai-feature-panel-{{ ai_gen_id }}__body p:last-child { margin-bottom: 0; }

  .ai-feature-panel-{{ ai_gen_id }}__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .ai-feature-panel-{{ ai_gen_id }}__button {
    display: inline-flex;
    min-height: 48px;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
    padding: 12px 22px;
    border: 2px solid {{ block.settings.accent_color }};
    border-radius: 4px;
    background: {{ block.settings.accent_color }};
    color: #ffffff;
    font-weight: 700;
    text-align: center;
    text-decoration: none;
  }

  .ai-feature-panel-{{ ai_gen_id }}__button--secondary {
    background: transparent;
    color: {{ block.settings.text_color }};
    border-color: {{ block.settings.text_color }};
  }

  .ai-feature-panel-{{ ai_gen_id }}__button:focus-visible {
    outline: 3px solid {{ block.settings.text_color }};
    outline-offset: 3px;
  }

  .ai-feature-panel-{{ ai_gen_id }}__items {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 18px;
  }

  .ai-feature-panel-{{ ai_gen_id }}__item {
    display: flex;
    min-height: 112px;
    align-items: center;
    gap: 16px;
    padding: 20px;
    border: 1px solid {{ block.settings.border_color }};
    border-radius: 8px;
    background: {{ block.settings.card_color }};
  }

  .ai-feature-panel-{{ ai_gen_id }}__icon {
    flex: 0 0 44px;
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: {{ block.settings.accent_color }};
  }

  .ai-feature-panel-{{ ai_gen_id }}__icon svg {
    width: 38px;
    height: 38px;
    display: block;
    stroke: currentColor;
  }

  .ai-feature-panel-{{ ai_gen_id }}__label {
    margin: 0;
    font-size: 16px;
    line-height: 1.45;
    font-weight: 600;
  }

  @media screen and (max-width: 749px) {
    .ai-feature-panel-{{ ai_gen_id }} {
      padding: {{ block.settings.mobile_padding }}px 20px;
    }

    .ai-feature-panel-{{ ai_gen_id }}__inner {
      grid-template-columns: 1fr;
      gap: 32px;
    }

    .ai-feature-panel-{{ ai_gen_id }}__items { gap: 12px; }
    .ai-feature-panel-{{ ai_gen_id }}__item { min-height: 96px; padding: 14px; gap: 10px; }
    .ai-feature-panel-{{ ai_gen_id }}__icon { flex-basis: 34px; width: 34px; height: 34px; }
    .ai-feature-panel-{{ ai_gen_id }}__icon svg { width: 30px; height: 30px; }
    .ai-feature-panel-{{ ai_gen_id }}__label { font-size: 14px; }
  }

  @media screen and (max-width: 420px) {
    .ai-feature-panel-{{ ai_gen_id }}__items { grid-template-columns: 1fr; }
  }
{% endstyle %}

<div class="ai-feature-panel-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-feature-panel-{{ ai_gen_id }}__inner">
    <div class="ai-feature-panel-{{ ai_gen_id }}__content">
      {% if block.settings.eyebrow != blank %}<p class="ai-feature-panel-{{ ai_gen_id }}__eyebrow">{{ block.settings.eyebrow | escape }}</p>{% endif %}
      {% if block.settings.heading != blank %}<h2 class="ai-feature-panel-{{ ai_gen_id }}__heading">{{ block.settings.heading | escape }}</h2>{% endif %}
      {% if block.settings.subheading != blank %}<p class="ai-feature-panel-{{ ai_gen_id }}__subheading">{{ block.settings.subheading | escape }}</p>{% endif %}
      {% if block.settings.body != blank %}<div class="ai-feature-panel-{{ ai_gen_id }}__body">{{ block.settings.body }}</div>{% endif %}
      <div class="ai-feature-panel-{{ ai_gen_id }}__actions">
        {% if block.settings.button_one_label != blank and block.settings.button_one_link != blank %}<a class="ai-feature-panel-{{ ai_gen_id }}__button" href="{{ block.settings.button_one_link }}">{{ block.settings.button_one_label | escape }}</a>{% endif %}
        {% if block.settings.button_two_label != blank and block.settings.button_two_link != blank %}<a class="ai-feature-panel-{{ ai_gen_id }}__button ai-feature-panel-{{ ai_gen_id }}__button--secondary" href="{{ block.settings.button_two_link }}">{{ block.settings.button_two_label | escape }}</a>{% endif %}
      </div>
    </div>
    <div class="ai-feature-panel-{{ ai_gen_id }}__items">
      {% for i in (1..4) %}
        {% liquid
          assign label_key = 'item_' | append: i | append: '_text'
          assign icon_key = 'item_' | append: i | append: '_icon'
          assign item_label = block.settings[label_key]
          assign item_icon = block.settings[icon_key]
        %}
        {% if item_label != blank %}
          <div class="ai-feature-panel-{{ ai_gen_id }}__item">
            <span class="ai-feature-panel-{{ ai_gen_id }}__icon" aria-hidden="true">
              {% case item_icon %}
                {% when 'battery' %}<svg viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="7" width="17" height="10" rx="2"/><path d="M22 10v4M7 10h3v4H7z"/></svg>
                {% when 'shield' %}<svg viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3 20 6v5c0 5-3.4 8.4-8 10-4.6-1.6-8-5-8-10V6l8-3Z"/><path d="m9 12 2 2 4-4"/></svg>
                {% when 'wrench' %}<svg viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 6.5a5 5 0 0 0-6.4 6.4L3 18l3 3 5.1-5.1a5 5 0 0 0 6.4-6.4L14 12l-3-3 3.5-2.5Z"/></svg>
                {% else %}<svg viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="m8 12 2.5 2.5L16 9"/></svg>
              {% endcase %}
            </span>
            <p class="ai-feature-panel-{{ ai_gen_id }}__label">{{ item_label | escape }}</p>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Two-column features",
  "settings": [
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Why choose us" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Ride further, feel better" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Your next adventure starts here" },
    { "type": "richtext", "id": "body", "label": "Text", "default": "<p>Discover electric bikes and expert support designed to make every ride easier.</p>" },
    { "type": "text", "id": "button_one_label", "label": "First button", "default": "Shop e-bikes" },
    { "type": "url", "id": "button_one_link", "label": "First button link" },
    { "type": "text", "id": "button_two_label", "label": "Second button", "default": "Learn more" },
    { "type": "url", "id": "button_two_link", "label": "Second button link" },
    { "type": "header", "content": "Feature lists" },
    { "type": "select", "id": "item_1_icon", "label": "First icon", "options": [{ "value": "check", "label": "Check" }, { "value": "battery", "label": "Battery" }, { "value": "shield", "label": "Shield" }, { "value": "wrench", "label": "Wrench" }], "default": "battery" },
    { "type": "text", "id": "item_1_text", "label": "First text", "default": "Reliable battery range" },
    { "type": "select", "id": "item_2_icon", "label": "Second icon", "options": [{ "value": "check", "label": "Check" }, { "value": "battery", "label": "Battery" }, { "value": "shield", "label": "Shield" }, { "value": "wrench", "label": "Wrench" }], "default": "shield" },
    { "type": "text", "id": "item_2_text", "label": "Second text", "default": "Quality you can trust" },
    { "type": "select", "id": "item_3_icon", "label": "Third icon", "options": [{ "value": "check", "label": "Check" }, { "value": "battery", "label": "Battery" }, { "value": "shield", "label": "Shield" }, { "value": "wrench", "label": "Wrench" }], "default": "wrench" },
    { "type": "text", "id": "item_3_text", "label": "Third text", "default": "Expert service and support" },
    { "type": "select", "id": "item_4_icon", "label": "Fourth icon", "options": [{ "value": "check", "label": "Check" }, { "value": "battery", "label": "Battery" }, { "value": "shield", "label": "Shield" }, { "value": "wrench", "label": "Wrench" }], "default": "check" },
    { "type": "text", "id": "item_4_text", "label": "Fourth text", "default": "Find the right ride for you" },
    { "type": "header", "content": "Colors and layout" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#F8F5F0" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#1B2A4A" },
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#1B2A4A" },
    { "type": "color", "id": "card_color", "label": "List background", "default": "#FFFFFF" },
    { "type": "color", "id": "border_color", "label": "List border", "default": "#E5E7EB" },
    { "type": "range", "id": "section_padding", "label": "Desktop padding", "min": 20, "max": 100, "step": 5, "unit": "px", "default": 60 },
    { "type": "range", "id": "mobile_padding", "label": "Mobile padding", "min": 15, "max": 60, "step": 5, "unit": "px", "default": 35 },
    { "type": "range", "id": "desktop_width_percent", "label": "Desktop width", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 }
  ],
  "presets": [{ "name": "Two-column features" }],
  "tag": null,
  "class": "two-column-features"
}
{% endschema %}