{% doc %}
  @prompt
    generate a section in 3cols, 1st colaround 25%width has image full height and full width, 2nd col has 50% width and has an eyebrow text withicon and heading and desciription and then with 3 usp icons and text in one row only dividide by a dividerm, and below that one button as get directions, and inthe last col we will have 2 buttons, instead of shield if we get settings or service icon is also okay and instead of loacation pin it should be key for test ride, no the servicce icon text is servie and support, please add settings symbol, settings icon is broke, can you add a correct ons
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% style %}
.ai-panel-{{ ai_gen_id }}{display:block;width:{{ block.settings.desktop_width_percent }}%;max-width:100%;margin:auto}.ai-panel-{{ ai_gen_id }}__grid{display:grid;grid-template-columns:1fr 2fr 1fr;min-height:{{ block.settings.panel_height }}px;border:1px solid #e5e7eb;border-radius:12px;overflow:hidden;color:#1b2a4a}.ai-panel-{{ ai_gen_id }}__image img,.ai-panel-{{ ai_gen_id }}__placeholder svg{width:100%;height:100%;min-height:{{ block.settings.panel_height }}px;object-fit:cover;display:block}.ai-panel-{{ ai_gen_id }}__placeholder{background:#f8f5f0;height:100%}.ai-panel-{{ ai_gen_id }}__main{padding:32px;display:flex;flex-direction:column;justify-content:center}.ai-panel-{{ ai_gen_id }}__eyebrow{display:flex;align-items:center;gap:8px;color:#a83b00;font-weight:700}.ai-panel-{{ ai_gen_id }}__eyebrow svg,.ai-panel-{{ ai_gen_id }}__usp svg{width:21px;height:21px;flex:none}.ai-panel-{{ ai_gen_id }}__heading{font-size:{{ block.settings.heading_size }}px;margin:8px 0}.ai-panel-{{ ai_gen_id }}__description{line-height:1.6;color:#555d6b}.ai-panel-{{ ai_gen_id }}__usps{display:grid;grid-template-columns:repeat(3,1fr);border-block:1px solid #e5e7eb;margin:18px 0}.ai-panel-{{ ai_gen_id }}__usp{display:flex;align-items:center;justify-content:center;gap:6px;text-align:center;padding:12px 5px;font-size:12px;font-weight:600}.ai-panel-{{ ai_gen_id }}__usp+.ai-panel-{{ ai_gen_id }}__usp{border-left:1px solid #e5e7eb}.ai-panel-{{ ai_gen_id }}__usp svg{color:#a83b00}.ai-panel-{{ ai_gen_id }}__actions{display:flex;flex-direction:column;justify-content:center;gap:12px;padding:22px;background:#f8f5f0;border-left:1px solid #e5e7eb}.ai-panel-{{ ai_gen_id }}__button{display:flex;align-items:center;justify-content:center;min-height:48px;padding:12px;border-radius:6px;background:#a83b00;color:#fff;text-align:center;text-decoration:none;font-weight:700;border:2px solid #a83b00}.ai-panel-{{ ai_gen_id }}__secondary{background:transparent;color:#1b2a4a;border-color:#d1d5db}.ai-panel-{{ ai_gen_id }}__button:focus-visible{outline:3px solid #1b2a4a;outline-offset:3px}@media(max-width:749px){.ai-panel-{{ ai_gen_id }}{width:100%}.ai-panel-{{ ai_gen_id }}__grid{grid-template-columns:1fr}.ai-panel-{{ ai_gen_id }}__image img,.ai-panel-{{ ai_gen_id }}__placeholder svg{height:{{ block.settings.mobile_image_height }}px;min-height:{{ block.settings.mobile_image_height }}px}.ai-panel-{{ ai_gen_id }}__actions{border-left:0;border-top:1px solid #e5e7eb}.ai-panel-{{ ai_gen_id }}__usp{flex-direction:column}}
{% endstyle %}
{% capture settings_icon %}<circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.7 1.7 0 0 0 .3 1.9l.1.1-1.6 2.8-.2-.1a1.7 1.7 0 0 0-1.9.3l-.1.1h-3.2l-.1-.2a1.7 1.7 0 0 0-1.6-1.1c-.2 0-.4 0-.6.1l-.2.1-1.6-2.8.1-.1a1.7 1.7 0 0 0 0-2l-.1-.1 1.6-2.8.2.1a1.7 1.7 0 0 0 1.9-.3l.1-.1h3.2l.1.2a1.7 1.7 0 0 0 1.6 1.1c.2 0 .4 0 .6-.1l.2-.1 1.6 2.8-.1.1a1.7 1.7 0 0 0 0 2z" transform="translate(-1 -1)"/>{% endcapture %}
{% capture key_icon %}<circle cx="8" cy="15" r="5"/><path d="m11 12 9-9 2 2-3 3 2 2-2 2-2-2-3 3"/>{% endcapture %}
<div class="ai-panel-{{ ai_gen_id }}" {{ block.shopify_attributes }}><div class="ai-panel-{{ ai_gen_id }}__grid"><div class="ai-panel-{{ ai_gen_id }}__image">{% if block.settings.image %}<img src="{{ block.settings.image | image_url: width: 1000 }}" alt="{{ block.settings.image.alt | escape }}" width="{{ block.settings.image.width }}" height="{{ block.settings.image.height }}" loading="lazy">{% else %}<div class="ai-panel-{{ ai_gen_id }}__placeholder">{{ 'image' | placeholder_svg_tag }}</div>{% endif %}</div><div class="ai-panel-{{ ai_gen_id }}__main"><p class="ai-panel-{{ ai_gen_id }}__eyebrow"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">{% if block.settings.eyebrow_icon == 'settings' %}{{ settings_icon }}{% elsif block.settings.eyebrow_icon == 'key' %}{{ key_icon }}{% else %}<path d="M4 20h16M6 20V8l6-4 6 4v12"/>{% endif %}</svg>{{ block.settings.eyebrow | escape }}</p><h2 class="ai-panel-{{ ai_gen_id }}__heading">{{ block.settings.heading | escape }}</h2><div class="ai-panel-{{ ai_gen_id }}__description">{{ block.settings.description }}</div><div class="ai-panel-{{ ai_gen_id }}__usps">{% for i in (1..3) %}{% liquid
assign txtkey = 'usp_' | append: i | append: '_text'
assign iconkey = 'usp_' | append: i | append: '_icon'
assign txt = block.settings[txtkey]
assign icon = block.settings[iconkey]
%}<div class="ai-panel-{{ ai_gen_id }}__usp"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">{% if icon == 'settings' %}{{ settings_icon }}{% elsif icon == 'key' %}{{ key_icon }}{% elsif icon == 'service' %}<path d="M14 6a5 5 0 0 0-6 6l-5 6 3 3 6-5a5 5 0 0 0 6-6l-4 4-4-4z"/>{% else %}<circle cx="5.5" cy="17.5" r="3.5"/><circle cx="18.5" cy="17.5" r="3.5"/><path d="m15 6 3.5 11.5M8 17.5 12 9l4 8.5M9 6h4M12 9h5"/>{% endif %}</svg><span>{{ txt | escape }}</span></div>{% endfor %}</div>{% if block.settings.directions_url %}<a class="ai-panel-{{ ai_gen_id }}__button" href="{{ block.settings.directions_url }}">{{ block.settings.directions_label | escape }}</a>{% endif %}</div><div class="ai-panel-{{ ai_gen_id }}__actions">{% if block.settings.button_one_url %}<a class="ai-panel-{{ ai_gen_id }}__button" href="{{ block.settings.button_one_url }}">{{ block.settings.button_one_label | escape }}</a>{% endif %}{% if block.settings.button_two_url %}<a class="ai-panel-{{ ai_gen_id }}__button ai-panel-{{ ai_gen_id }}__secondary" href="{{ block.settings.button_two_url }}">{{ block.settings.button_two_label | escape }}</a>{% endif %}</div></div></div>
{% schema %}
{"name":"Location info panel","settings":[{"type":"image_picker","id":"image","label":"Image"},{"type":"range","id":"desktop_width_percent","label":"Desktop width","min":50,"max":100,"step":5,"unit":"%","default":100},{"type":"range","id":"panel_height","label":"Panel height","min":260,"max":600,"step":20,"unit":"px","default":400},{"type":"range","id":"mobile_image_height","label":"Mobile image height","min":140,"max":360,"step":20,"unit":"px","default":220},{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Visit our store"},{"type":"select","id":"eyebrow_icon","label":"Eyebrow icon","options":[{"value":"key","label":"Key for test rides"},{"value":"settings","label":"Settings"},{"value":"store","label":"Storefront"}],"default":"key"},{"type":"text","id":"heading","label":"Heading","default":"Find us and say hello"},{"type":"richtext","id":"description","label":"Description","default":"<p>Visit our team for expert advice, friendly service and everything you need for your next ride.</p>"},{"type":"select","id":"usp_1_icon","label":"Highlight 1 icon","options":[{"value":"bike","label":"Bicycle"},{"value":"key","label":"Key for test rides"},{"value":"settings","label":"Settings"},{"value":"service","label":"Service tool"}],"default":"bike"},{"type":"text","id":"usp_1_text","label":"Highlight 1","default":"Expert e-bike advice"},{"type":"select","id":"usp_2_icon","label":"Highlight 2 icon","options":[{"value":"bike","label":"Bicycle"},{"value":"key","label":"Key for test rides"},{"value":"settings","label":"Settings"},{"value":"service","label":"Service tool"}],"default":"key"},{"type":"text","id":"usp_2_text","label":"Highlight 2","default":"Test rides available"},{"type":"select","id":"usp_3_icon","label":"Highlight 3 icon","options":[{"value":"bike","label":"Bicycle"},{"value":"key","label":"Key for test rides"},{"value":"settings","label":"Settings"},{"value":"service","label":"Service tool"}],"default":"settings"},{"type":"text","id":"usp_3_text","label":"Highlight 3","default":"Service and support"},{"type":"text","id":"directions_label","label":"Directions button label","default":"Get directions"},{"type":"url","id":"directions_url","label":"Directions link"},{"type":"text","id":"button_one_label","label":"First button label","default":"Book a service"},{"type":"url","id":"button_one_url","label":"First button link"},{"type":"text","id":"button_two_label","label":"Second button label","default":"Contact us"},{"type":"url","id":"button_two_url","label":"Second button link"},{"type":"range","id":"heading_size","label":"Heading size","min":24,"max":48,"step":2,"unit":"px","default":34}],"presets":[{"name":"Location info panel"}],"tag":null,"class":"location-info-panel-block"}
{% endschema %}