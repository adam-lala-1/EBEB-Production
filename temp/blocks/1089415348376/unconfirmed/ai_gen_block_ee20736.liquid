{% doc %}
  @prompt
    generate a section for this content with a good usp for the heading and some good look
    
    
    
     Key Information from the Manual 
    
    A quick overview of important topics covered in the owner manual. Please download and read the complete manual for full instructions. 
    
    Learn about the Trojan Fat Tyre Electric Tricycle, including its 20-inch wheels, 4-inch fat tyres, low centre of gravity and rear hub-drive system. 
    
    Trike Safety Tips 
    
    Important guidance for mounting, dismounting and riding safely, including use of the park brake, helmet requirements and following local road rules. 
    
    Before Riding & Operation 
    
    Understand the controls, pedal-assist system, braking, gears and how to become comfortable with the different handling characteristics of a tricycle. 
    
    Display & Controls 
    
    Instructions for using the display, adjusting assistance levels, lights, trip information and other rider settings. 
    
    Maintenance & Battery Care 
    
    Guidance covering routine checks, servicing, battery charging, storage and general maintenance. 
    
    Warranty & Support 
    
    Review warranty conditions, maintenance responsibilities and how to contact EveryBody eBikes if you need assistance., we have only 5 points, not 6
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-trojan-guide-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
    padding: 56px 24px;
    background: {{ block.settings.background_color }};
    color: {{ block.settings.text_color }};
  }
  .ai-trojan-guide-{{ ai_gen_id }}__inner { max-width: 1120px; margin: 0 auto; }
  .ai-trojan-guide-{{ ai_gen_id }}__header { max-width: 760px; margin: 0 auto 32px; text-align: center; }
  .ai-trojan-guide-{{ ai_gen_id }}__eyebrow { margin: 0 0 10px; color: {{ block.settings.accent_color }}; font-size: 13px; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; }
  .ai-trojan-guide-{{ ai_gen_id }}__title { margin: 0 0 14px; color: {{ block.settings.heading_color }}; font-size: clamp(30px, 4vw, 44px); line-height: 1.12; }
  .ai-trojan-guide-{{ ai_gen_id }}__intro { margin: 0; color: {{ block.settings.text_color }}; font-size: 16px; line-height: 1.65; }
  .ai-trojan-guide-{{ ai_gen_id }}__grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; }
  .ai-trojan-guide-{{ ai_gen_id }}__card { padding: 22px; background: #ffffff; border: 1px solid {{ block.settings.border_color }}; border-radius: 12px; }
  .ai-trojan-guide-{{ ai_gen_id }}__number { display: inline-flex; align-items: center; justify-content: center; width: 34px; height: 34px; margin-bottom: 14px; border-radius: 50%; background: {{ block.settings.accent_color }}; color: #ffffff; font-size: 14px; font-weight: 700; }
  .ai-trojan-guide-{{ ai_gen_id }}__card-title { margin: 0 0 8px; color: {{ block.settings.heading_color }}; font-size: 18px; line-height: 1.3; }
  .ai-trojan-guide-{{ ai_gen_id }}__card-text { margin: 0; color: {{ block.settings.text_color }}; font-size: 15px; line-height: 1.6; }
  .ai-trojan-guide-{{ ai_gen_id }}__footer { display: flex; align-items: center; justify-content: space-between; gap: 20px; margin-top: 24px; padding: 20px 22px; background: {{ block.settings.callout_color }}; border-radius: 12px; }
  .ai-trojan-guide-{{ ai_gen_id }}__note { margin: 0; color: {{ block.settings.heading_color }}; font-size: 14px; line-height: 1.55; }
  .ai-trojan-guide-{{ ai_gen_id }}__button { display: inline-flex; flex: 0 0 auto; align-items: center; justify-content: center; min-height: 48px; padding: 12px 20px; border: 2px solid {{ block.settings.accent_color }}; border-radius: 8px; background: {{ block.settings.accent_color }}; color: #ffffff; font-size: 15px; font-weight: 700; text-align: center; text-decoration: none; }
  .ai-trojan-guide-{{ ai_gen_id }}__button:hover { background: {{ block.settings.heading_color }}; border-color: {{ block.settings.heading_color }}; color: #ffffff; }
  .ai-trojan-guide-{{ ai_gen_id }}__button:focus-visible { outline: 3px solid {{ block.settings.heading_color }}; outline-offset: 3px; }
  @media screen and (max-width: 749px) {
    .ai-trojan-guide-{{ ai_gen_id }} { padding: 40px 18px; }
    .ai-trojan-guide-{{ ai_gen_id }}__grid { grid-template-columns: 1fr; gap: 12px; }
    .ai-trojan-guide-{{ ai_gen_id }}__footer { align-items: stretch; flex-direction: column; }
  }
{% endstyle %}

<section class="ai-trojan-guide-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-trojan-guide-{{ ai_gen_id }}__inner">
    <header class="ai-trojan-guide-{{ ai_gen_id }}__header">
      {% if block.settings.eyebrow != blank %}<p class="ai-trojan-guide-{{ ai_gen_id }}__eyebrow">{{ block.settings.eyebrow | escape }}</p>{% endif %}
      <h2 class="ai-trojan-guide-{{ ai_gen_id }}__title">{{ block.settings.heading | escape }}</h2>
      <p class="ai-trojan-guide-{{ ai_gen_id }}__intro">{{ block.settings.intro | escape }}</p>
    </header>
    <div class="ai-trojan-guide-{{ ai_gen_id }}__grid">
      {% for i in (1..5) %}
        {% liquid
          assign title_key = 'topic_' | append: i | append: '_title'
          assign text_key = 'topic_' | append: i | append: '_text'
          assign topic_title = block.settings[title_key]
          assign topic_text = block.settings[text_key]
        %}
        <article class="ai-trojan-guide-{{ ai_gen_id }}__card">
          <span class="ai-trojan-guide-{{ ai_gen_id }}__number" aria-hidden="true">0{{ i }}</span>
          <h3 class="ai-trojan-guide-{{ ai_gen_id }}__card-title">{{ topic_title | escape }}</h3>
          <p class="ai-trojan-guide-{{ ai_gen_id }}__card-text">{{ topic_text | escape }}</p>
        </article>
      {% endfor %}
    </div>
    <div class="ai-trojan-guide-{{ ai_gen_id }}__footer">
      <p class="ai-trojan-guide-{{ ai_gen_id }}__note">{{ block.settings.manual_note | escape }}</p>
      {% if block.settings.manual_url != blank %}<a class="ai-trojan-guide-{{ ai_gen_id }}__button" href="{{ block.settings.manual_url }}" target="_blank" rel="noopener">{{ block.settings.button_label | escape }}</a>{% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Trojan manual overview",
  "settings": [
    { "type": "range", "id": "desktop_width_percent", "label": "Desktop width", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Trojan owner manual" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Ride your Trojan with confidence" },
    { "type": "textarea", "id": "intro", "label": "Introduction", "default": "Get familiar with your trike, ride safely and care for your battery with this quick guide to the key topics in the owner manual." },
    { "type": "header", "content": "Manual topics" },
    { "type": "text", "id": "topic_1_title", "label": "Topic 1 title", "default": "Meet your Trojan" },
    { "type": "textarea", "id": "topic_1_text", "label": "Topic 1 details", "default": "Learn about the 20-inch wheels, 4-inch fat tyres, low centre of gravity and rear hub-drive system." },
    { "type": "text", "id": "topic_2_title", "label": "Topic 2 title", "default": "Trike safety tips" },
    { "type": "textarea", "id": "topic_2_text", "label": "Topic 2 details", "default": "Review safe mounting and dismounting, park-brake use, helmet requirements and local road rules." },
    { "type": "text", "id": "topic_3_title", "label": "Topic 3 title", "default": "Before riding and operation" },
    { "type": "textarea", "id": "topic_3_text", "label": "Topic 3 details", "default": "Get to know the controls, pedal assist, braking and gears, and allow time to adjust to tricycle handling." },
    { "type": "text", "id": "topic_4_title", "label": "Topic 4 title", "default": "Display and controls" },
    { "type": "textarea", "id": "topic_4_text", "label": "Topic 4 details", "default": "Find instructions for assistance levels, lights, trip information and other rider settings." },
    { "type": "text", "id": "topic_5_title", "label": "Topic 5 title", "default": "Maintenance, battery care and support" },
    { "type": "textarea", "id": "topic_5_text", "label": "Topic 5 details", "default": "Review routine checks, servicing, charging, storage, warranty conditions, maintenance responsibilities and how to contact EveryBody eBikes for assistance." },
    { "type": "header", "content": "Download and appearance" },
    { "type": "textarea", "id": "manual_note", "label": "Manual note", "default": "This overview is a quick reference only. Download and read the complete owner manual for full instructions." },
    { "type": "url", "id": "manual_url", "label": "Manual download link" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Download the full manual" },
    { "type": "color", "id": "background_color", "label": "Section background", "default": "#FFFFFF" },
    { "type": "color", "id": "heading_color", "label": "Heading color", "default": "#1B2A4A" },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#1B2A4A" },
    { "type": "color", "id": "accent_color", "label": "Accent and button", "default": "#B94A12" },
    { "type": "color", "id": "border_color", "label": "Card border", "default": "#E5E7EB" },
    { "type": "color", "id": "callout_color", "label": "Download panel", "default": "#F8F5F0" }
  ],
  "presets": [{ "name": "Trojan manual overview" }],
  "tag": null,
  "class": "trojan-manual-overview"
}
{% endschema %}