{% doc %}
  @prompt
    generate a section with 2cols, left col bigger one for text, and right side we have border for col heading text and 2buttons beside
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-two-column-panel-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    box-sizing: border-box;
  }

  .ai-two-column-panel-{{ ai_gen_id }}__layout {
    display: grid;
    grid-template-columns: minmax(0, 1.7fr) minmax(280px, 1fr);
    gap: 32px;
    align-items: stretch;
  }

  .ai-two-column-panel-{{ ai_gen_id }}__copy {
    color: {{ block.settings.text_color }};
    padding: 24px 0;
  }

  .ai-two-column-panel-{{ ai_gen_id }}__copy h1,
  .ai-two-column-panel-{{ ai_gen_id }}__copy h2,
  .ai-two-column-panel-{{ ai_gen_id }}__copy h3,
  .ai-two-column-panel-{{ ai_gen_id }}__copy p {
    margin-top: 0;
  }

  .ai-two-column-panel-{{ ai_gen_id }}__copy h1,
  .ai-two-column-panel-{{ ai_gen_id }}__copy h2,
  .ai-two-column-panel-{{ ai_gen_id }}__copy h3 {
    color: {{ block.settings.heading_color }};
  }

  .ai-two-column-panel-{{ ai_gen_id }}__card {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 20px;
    min-width: 0;
    padding: 28px;
    border: 1px solid {{ block.settings.border_color }};
    border-radius: {{ block.settings.border_radius }}px;
    background: {{ block.settings.card_background }};
    color: {{ block.settings.text_color }};
  }

  .ai-two-column-panel-{{ ai_gen_id }}__card-title {
    margin: 0;
    color: {{ block.settings.heading_color }};
    font-size: 22px;
    line-height: 1.3;
  }

  .ai-two-column-panel-{{ ai_gen_id }}__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .ai-two-column-panel-{{ ai_gen_id }}__button {
    display: inline-flex;
    flex: 1 1 auto;
    min-height: 48px;
    align-items: center;
    justify-content: center;
    padding: 12px 18px;
    border: 2px solid {{ block.settings.button_color }};
    border-radius: {{ block.settings.button_radius }}px;
    background: {{ block.settings.button_color }};
    color: {{ block.settings.button_text_color }};
    font-weight: 700;
    line-height: 1.25;
    text-align: center;
    text-decoration: none;
    transition: background-color 150ms ease, color 150ms ease;
  }

  .ai-two-column-panel-{{ ai_gen_id }}__button--secondary {
    background: transparent;
    color: {{ block.settings.heading_color }};
    border-color: {{ block.settings.border_color }};
  }

  .ai-two-column-panel-{{ ai_gen_id }}__button:hover {
    background: {{ block.settings.heading_color }};
    border-color: {{ block.settings.heading_color }};
    color: #ffffff;
  }

  .ai-two-column-panel-{{ ai_gen_id }}__button:focus-visible {
    outline: 3px solid {{ block.settings.button_color }};
    outline-offset: 3px;
  }

  @media screen and (max-width: 749px) {
    .ai-two-column-panel-{{ ai_gen_id }}__layout {
      grid-template-columns: 1fr;
      gap: 20px;
    }

    .ai-two-column-panel-{{ ai_gen_id }}__copy {
      padding: 0;
    }

    .ai-two-column-panel-{{ ai_gen_id }}__card {
      padding: 22px;
    }
  }
{% endstyle %}

<div class="ai-two-column-panel-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-two-column-panel-{{ ai_gen_id }}__layout">
    <div class="ai-two-column-panel-{{ ai_gen_id }}__copy">
      {{ block.settings.left_content }}
    </div>
    <aside class="ai-two-column-panel-{{ ai_gen_id }}__card" aria-labelledby="ai-two-column-title-{{ ai_gen_id }}">
      {% if block.settings.right_heading != blank %}
        <h2 class="ai-two-column-panel-{{ ai_gen_id }}__card-title" id="ai-two-column-title-{{ ai_gen_id }}">{{ block.settings.right_heading | escape }}</h2>
      {% endif %}
      <div class="ai-two-column-panel-{{ ai_gen_id }}__actions">
        {% if block.settings.button_one_label != blank and block.settings.button_one_link != blank %}
          <a class="ai-two-column-panel-{{ ai_gen_id }}__button" href="{{ block.settings.button_one_link }}">{{ block.settings.button_one_label | escape }}</a>
        {% endif %}
        {% if block.settings.button_two_label != blank and block.settings.button_two_link != blank %}
          <a class="ai-two-column-panel-{{ ai_gen_id }}__button ai-two-column-panel-{{ ai_gen_id }}__button--secondary" href="{{ block.settings.button_two_link }}">{{ block.settings.button_two_label | escape }}</a>
        {% endif %}
      </div>
    </aside>
  </div>
</div>

{% schema %}
{
  "name": "Two-column callout",
  "settings": [
    {
      "type": "header",
      "content": "Left column"
    },
    {
      "type": "richtext",
      "id": "left_content",
      "label": "Text content",
      "default": "<p>Add your main text here. This wider column is ideal for service details or helpful information.</p>"
    },
    {
      "type": "header",
      "content": "Right column"
    },
    {
      "type": "text",
      "id": "right_heading",
      "label": "Heading",
      "default": "Ready to get started?"
    },
    {
      "type": "text",
      "id": "button_one_label",
      "label": "First button label",
      "default": "Make an enquiry"
    },
    {
      "type": "url",
      "id": "button_one_link",
      "label": "First button link"
    },
    {
      "type": "text",
      "id": "button_two_label",
      "label": "Second button label",
      "default": "Book a service"
    },
    {
      "type": "url",
      "id": "button_two_link",
      "label": "Second button link"
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Headings",
      "default": "#1B2A4A"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#1B2A4A"
    },
    {
      "type": "color",
      "id": "card_background",
      "label": "Card background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border",
      "default": "#E5E7EB"
    },
    {
      "type": "color",
      "id": "button_color",
      "label": "Button color",
      "default": "#E86C2C"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text",
      "default": "#FFFFFF"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Card corner radius",
      "min": 0,
      "max": 30,
      "step": 2,
      "unit": "px",
      "default": 10
    },
    {
      "type": "range",
      "id": "button_radius",
      "label": "Button corner radius",
      "min": 0,
      "max": 30,
      "step": 2,
      "unit": "px",
      "default": 6
    }
  ],
  "presets": [
    {
      "name": "Two-column callout"
    }
  ],
  "tag": null,
  "class": "two-column-callout"
}
{% endschema %}