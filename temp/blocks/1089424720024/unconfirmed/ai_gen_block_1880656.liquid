{% doc %}
  @prompt
    generate a section for the form, add a simple form int he website, make all name phone email as required and message as optional, these mails should go to admin email id or any other as they are other forms in the website are going to, dont add work optional, just keep as it is m and it should redirect to thank you page as well, thank you page url i will provide https://everybodyebikes.com.au/pages/thank-you
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% assign ai_form_id = 'ServiceEnquiry-' | append: ai_gen_id %}

{% style %}
  .ai-service-enquiry-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 650px;
    margin: 0 auto;
    padding: {{ block.settings.padding }}px;
    background: {{ block.settings.background_color }};
    color: {{ block.settings.text_color }};
    border: 1px solid {{ block.settings.border_color }};
    border-radius: {{ block.settings.border_radius }}px;
    box-sizing: border-box;
  }
  .ai-service-enquiry-{{ ai_gen_id }} * { box-sizing: border-box; }
  .ai-service-enquiry-{{ ai_gen_id }}__title { margin: 0 0 8px; color: {{ block.settings.heading_color }}; font-size: 28px; line-height: 1.25; }
  .ai-service-enquiry-{{ ai_gen_id }}__intro { margin: 0 0 24px; color: {{ block.settings.text_color }}; line-height: 1.55; }
  .ai-service-enquiry-{{ ai_gen_id }}__field { margin-bottom: 16px; }
  .ai-service-enquiry-{{ ai_gen_id }}__label { display: block; margin-bottom: 6px; color: {{ block.settings.heading_color }}; font-weight: 600; }
  .ai-service-enquiry-{{ ai_gen_id }}__input, .ai-service-enquiry-{{ ai_gen_id }}__textarea { display: block; width: 100%; min-height: 48px; padding: 12px 14px; border: 1px solid {{ block.settings.border_color }}; border-radius: {{ block.settings.input_radius }}px; background: #fff; color: {{ block.settings.text_color }}; font: inherit; }
  .ai-service-enquiry-{{ ai_gen_id }}__textarea { min-height: 130px; resize: vertical; }
  .ai-service-enquiry-{{ ai_gen_id }}__input:focus, .ai-service-enquiry-{{ ai_gen_id }}__textarea:focus { outline: 2px solid {{ block.settings.heading_color }}; outline-offset: 2px; }
  .ai-service-enquiry-{{ ai_gen_id }}__button { display: inline-flex; justify-content: center; align-items: center; min-height: 48px; padding: 12px 24px; border: 0; border-radius: {{ block.settings.input_radius }}px; background: {{ block.settings.button_color }}; color: #fff; font: inherit; font-weight: 700; cursor: pointer; }
  .ai-service-enquiry-{{ ai_gen_id }}__button:hover { filter: brightness(0.92); }
  .ai-service-enquiry-{{ ai_gen_id }}__button:focus-visible { outline: 3px solid {{ block.settings.heading_color }}; outline-offset: 3px; }
  .ai-service-enquiry-{{ ai_gen_id }}__status { margin: 0 0 16px; color: {{ block.settings.text_color }}; }
  @media screen and (max-width: 749px) {
    .ai-service-enquiry-{{ ai_gen_id }} { width: 100%; padding: 22px; }
    .ai-service-enquiry-{{ ai_gen_id }}__title { font-size: 24px; }
  }
{% endstyle %}

<div class="ai-service-enquiry-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.heading != blank %}<h2 class="ai-service-enquiry-{{ ai_gen_id }}__title">{{ block.settings.heading | escape }}</h2>{% endif %}
  {% if block.settings.intro != blank %}<p class="ai-service-enquiry-{{ ai_gen_id }}__intro">{{ block.settings.intro | escape }}</p>{% endif %}
  {% form 'contact', id: ai_form_id %}
    {% if form.posted_successfully? %}<p class="ai-service-enquiry-{{ ai_gen_id }}__status" role="status">{{ block.settings.success_message | escape }}</p>{% endif %}
    {% if form.errors %}<div class="ai-service-enquiry-{{ ai_gen_id }}__status" role="alert">{{ form.errors | default_errors }}</div>{% endif %}
    <input type="hidden" name="contact[tags]" value="bike-servicing-enquiry">
    <div class="ai-service-enquiry-{{ ai_gen_id }}__field">
      <label class="ai-service-enquiry-{{ ai_gen_id }}__label" for="ServiceName-{{ ai_gen_id }}">Name <span aria-hidden="true">*</span></label>
      <input class="ai-service-enquiry-{{ ai_gen_id }}__input" id="ServiceName-{{ ai_gen_id }}" type="text" name="contact[name]" autocomplete="name" required aria-required="true" value="{{ form.name | escape }}">
    </div>
    <div class="ai-service-enquiry-{{ ai_gen_id }}__field">
      <label class="ai-service-enquiry-{{ ai_gen_id }}__label" for="ServicePhone-{{ ai_gen_id }}">Phone <span aria-hidden="true">*</span></label>
      <input class="ai-service-enquiry-{{ ai_gen_id }}__input" id="ServicePhone-{{ ai_gen_id }}" type="tel" name="contact[phone]" autocomplete="tel" required aria-required="true" value="{{ form.phone | escape }}">
    </div>
    <div class="ai-service-enquiry-{{ ai_gen_id }}__field">
      <label class="ai-service-enquiry-{{ ai_gen_id }}__label" for="ServiceEmail-{{ ai_gen_id }}">Email <span aria-hidden="true">*</span></label>
      <input class="ai-service-enquiry-{{ ai_gen_id }}__input" id="ServiceEmail-{{ ai_gen_id }}" type="email" name="contact[email]" autocomplete="email" required aria-required="true" value="{{ form.email | escape }}">
    </div>
    <div class="ai-service-enquiry-{{ ai_gen_id }}__field">
      <label class="ai-service-enquiry-{{ ai_gen_id }}__label" for="ServiceMessage-{{ ai_gen_id }}">Message</label>
      <textarea class="ai-service-enquiry-{{ ai_gen_id }}__textarea" id="ServiceMessage-{{ ai_gen_id }}" name="contact[body]">{{ form.body | escape }}</textarea>
    </div>
    <button class="ai-service-enquiry-{{ ai_gen_id }}__button" type="submit">{{ block.settings.button_label | escape }}</button>
  {% endform %}
  {% if form.posted_successfully? %}
    <script>
      window.location.replace('https://everybodyebikes.com.au/pages/thank-you');
    </script>
  {% endif %}
</div>

{% schema %}
{
  "name": "Service enquiry form",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Service enquiry" },
    { "type": "text", "id": "intro", "label": "Intro text", "default": "Tell us how we can help with your bike servicing." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Send enquiry" },
    { "type": "text", "id": "success_message", "label": "Success message", "default": "Thanks for your enquiry. We’ll be in touch soon." },
    { "type": "range", "id": "desktop_width_percent", "label": "Desktop width", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "range", "id": "padding", "label": "Form padding", "min": 10, "max": 50, "step": 5, "unit": "px", "default": 30 },
    { "type": "range", "id": "border_radius", "label": "Form corner radius", "min": 0, "max": 30, "step": 2, "unit": "px", "default": 12 },
    { "type": "range", "id": "input_radius", "label": "Input corner radius", "min": 0, "max": 20, "step": 2, "unit": "px", "default": 8 },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#FFFFFF" },
    { "type": "color", "id": "heading_color", "label": "Heading", "default": "#1B2A4A" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#1B2A4A" },
    { "type": "color", "id": "border_color", "label": "Borders", "default": "#E5E7EB" },
    { "type": "color", "id": "button_color", "label": "Button", "default": "#B94710" }
  ],
  "presets": [{ "name": "Service enquiry form" }],
  "tag": null,
  "class": "service-enquiry-form-block"
}
{% endschema %}