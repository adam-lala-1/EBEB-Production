{% doc %}
  @prompt
    generate a image section
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-image-section-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
    color: #1B2A4A;
  }

  .ai-image-section__media-{{ ai_gen_id }} {
    position: relative;
    overflow: hidden;
    width: 100%;
    aspect-ratio: {{ block.settings.aspect_ratio }};
    border-radius: {{ block.settings.corner_radius }}px;
    background: white;
  }

  .ai-image-section__media-{{ ai_gen_id }} img,
  .ai-image-section__media-{{ ai_gen_id }} svg {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: {{ block.settings.image_fit }};
    background:white;
  }

  .ai-image-section__empty-{{ ai_gen_id }} {
    position: absolute;
    inset: auto 16px 16px;
    padding: 10px 14px;
    border-radius: 6px;
    background: #ffffff;
    color: #1B2A4A;
    text-align: center;
    font-size: 14px;
  }

  .ai-image-section__caption-{{ ai_gen_id }} {
    margin: 12px 0 0;
    color: #1B2A4A;
    font-size: 14px;
    line-height: 1.5;
    text-align: {{ block.settings.caption_alignment }};
  }

  @media screen and (max-width: 749px) {
    .ai-image-section-{{ ai_gen_id }} {
      width: 100%;
    }
  }
{% endstyle %}

<div class="ai-image-section-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
 <div class="eeb-container">
  <div class="ai-image-section__media-{{ ai_gen_id }}">
    {% if block.settings.image != blank %}
      <img
        src="{{ block.settings.image | image_url: width: 2000 }}"
        alt="{{ block.settings.image.alt | default: block.settings.caption | escape }}"
        loading="lazy"
        width="{{ block.settings.image.width }}"
        height="{{ block.settings.image.height }}"
      >
    {% else %}
      {{ 'image' | placeholder_svg_tag }}
      <div class="ai-image-section__empty-{{ ai_gen_id }}">Add an image to show it here.</div>
    {% endif %}
  </div>
  {% if block.settings.caption != blank %}
    <p class="ai-image-section__caption-{{ ai_gen_id }}">{{ block.settings.caption | escape }}</p>
  {% endif %}
   </div>
</div>

{% schema %}
{
  "name": "Image section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "caption",
      "label": "Caption"
    },
    {
      "type": "select",
      "id": "aspect_ratio",
      "label": "Image shape",
      "options": [
        { "value": "4 / 3", "label": "Landscape" },
        { "value": "1 / 1", "label": "Square" },
        { "value": "3 / 4", "label": "Portrait" },
        { "value": "16 / 9", "label": "Wide" }
      ],
      "default": "4 / 3"
    },
    {
      "type": "select",
      "id": "image_fit",
      "label": "Image fitting",
      "options": [
        { "value": "cover", "label": "Fill frame" },
        { "value": "contain", "label": "Show entire image" }
      ],
      "default": "cover"
    },
    {
      "type": "select",
      "id": "caption_alignment",
      "label": "Caption alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "corner_radius",
      "label": "Corner radius",
      "min": 0,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    }
  ],
  "presets": [
    {
      "name": "Image section"
    }
  ],
  "tag": null,
  "class": "image-section-block"
}
{% endschema %}