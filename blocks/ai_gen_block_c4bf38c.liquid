{% doc %}
  @prompt
    generate a section with 2cols, where i can add left side map with iframe code and in right side, contact details and openeing hours withits icons
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-location-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin-inline: auto;
    padding: {{ block.settings.section_padding }}px 24px;
    background: {{ block.settings.background_color }};
    color: {{ block.settings.text_color }};
  }

  .ai-location-{{ ai_gen_id }}__inner {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(280px, 0.85fr);
    gap: 36px;
    max-width: 1200px;
    margin: 0 auto;
    align-items: stretch;
  }

  .ai-location-{{ ai_gen_id }}__map {
    min-height: 420px;
    overflow: hidden;
    border: 1px solid {{ block.settings.border_color }};
    border-radius: {{ block.settings.corner_radius }}px;
    background: #f4f5f7;
  }

  .ai-location-{{ ai_gen_id }}__map iframe {
    display: block;
    width: 100%;
    height: 100%;
    min-height: 420px;
    border: 0;
  }

  .ai-location-{{ ai_gen_id }}__placeholder {
    display: flex;
    min-height: 420px;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 24px;
    color: {{ block.settings.text_color }};
    text-align: center;
  }

  .ai-location-{{ ai_gen_id }}__placeholder svg {
    width: 100%;
    max-width: 280px;
    height: 190px;
    color: #9ca3af;
  }

  .ai-location-{{ ai_gen_id }}__placeholder p {
    margin: 12px 0 0;
    color: {{ block.settings.text_color }};
    font-size: 14px;
  }

  .ai-location-{{ ai_gen_id }}__details {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 28px;
    padding: 8px 0;
  }

  .ai-location-{{ ai_gen_id }}__heading {
    margin: 0 0 20px;
    color: {{ block.settings.heading_color }};
    font-size: clamp(24px, 3vw, 34px);
    line-height: 1.2;
  }

  .ai-location-{{ ai_gen_id }}__item {
    display: grid;
    grid-template-columns: 28px minmax(0, 1fr);
    gap: 14px;
    align-items: start;
  }

  .ai-location-{{ ai_gen_id }}__icon {
    width: 24px;
    height: 24px;
    color: {{ block.settings.icon_color }};
  }

  .ai-location-{{ ai_gen_id }}__item h3 {
    margin: 0 0 6px;
    color: {{ block.settings.heading_color }};
    font-size: 16px;
    line-height: 1.35;
  }

  .ai-location-{{ ai_gen_id }}__item p,
  .ai-location-{{ ai_gen_id }}__item address {
    margin: 0;
    color: {{ block.settings.text_color }};
    font-size: 15px;
    line-height: 1.65;
    font-style: normal;
    white-space: pre-line;
  }

  .ai-location-{{ ai_gen_id }}__item a {
    color: {{ block.settings.text_color }};
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .ai-location-{{ ai_gen_id }}__item a:focus-visible {
    outline: 2px solid {{ block.settings.icon_color }};
    outline-offset: 3px;
    border-radius: 2px;
  }

  @media screen and (max-width: 749px) {
    .ai-location-{{ ai_gen_id }} {
      padding: {{ block.settings.section_padding | divided_by: 2 }}px 18px;
    }

    .ai-location-{{ ai_gen_id }}__inner {
      grid-template-columns: 1fr;
      gap: 28px;
    }

    .ai-location-{{ ai_gen_id }}__map,
    .ai-location-{{ ai_gen_id }}__map iframe,
    .ai-location-{{ ai_gen_id }}__placeholder {
      min-height: 320px;
    }

    .ai-location-{{ ai_gen_id }}__details {
      gap: 24px;
    }
  }
{% endstyle %}

<div class="ai-location-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-location-{{ ai_gen_id }}__inner">
    <div class="ai-location-{{ ai_gen_id }}__map">
      {% if block.settings.map_iframe != blank %}
        {{ block.settings.map_iframe }}
      {% else %}
        <div class="ai-location-{{ ai_gen_id }}__placeholder">
          {{ 'image' | placeholder_svg_tag }}
          <p>Add a map iframe embed code in the block settings.</p>
        </div>
      {% endif %}
    </div>

    <div class="ai-location-{{ ai_gen_id }}__details">
      {% if block.settings.heading != blank %}
        <h2 class="ai-location-{{ ai_gen_id }}__heading">{{ block.settings.heading | escape }}</h2>
      {% endif %}

      {% if block.settings.address != blank %}
        <div class="ai-location-{{ ai_gen_id }}__item">
          <svg class="ai-location-{{ ai_gen_id }}__icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 10c0 5-8 12-8 12S4 15 4 10a8 8 0 1 1 16 0Z"/><circle cx="12" cy="10" r="2.5"/></svg>
          <div><h3>Address</h3><a href="https://maps.app.goo.gl/vp282r3P2CotTNZc9"><address>{{ block.settings.address | escape }}</address></a></div>
        </div>
      {% endif %}

      {% if block.settings.phone != blank %}
        <div class="ai-location-{{ ai_gen_id }}__item">
          <svg class="ai-location-{{ ai_gen_id }}__icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.4 19.4 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 2 .7 2.9a2 2 0 0 1-.5 2.1L8 10a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.5c.9.3 1.9.6 2.9.7a2 2 0 0 1 1.7 2Z"/></svg>
          <div><h3>Phone</h3><p><a href="tel:{{ block.settings.phone | remove: ' ' | remove: '(' | remove: ')' | remove: '-' }}">{{ block.settings.phone | escape }}</a></p></div>
        </div>
      {% endif %}

      {% if block.settings.email != blank %}
        <div class="ai-location-{{ ai_gen_id }}__item">
          <svg class="ai-location-{{ ai_gen_id }}__icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>
          <div><h3>Email</h3><p><a href="mailto:{{ block.settings.email | escape }}">{{ block.settings.email | escape }}</a></p></div>
        </div>
      {% endif %}

      {% if block.settings.opening_hours != blank %}
        <div class="ai-location-{{ ai_gen_id }}__item">
          <svg class="ai-location-{{ ai_gen_id }}__icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
          <div><h3>Opening hours</h3><p>{{ block.settings.opening_hours | escape }}</p></div>
        </div>
      {% endif %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Map and contact details",
  "settings": [
    { "type": "html", "id": "map_iframe", "label": "Map iframe embed code" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Visit us" },
    { "type": "textarea", "id": "address", "label": "Address" },
    { "type": "text", "id": "phone", "label": "Phone number" },
    { "type": "text", "id": "email", "label": "Email address" },
    { "type": "textarea", "id": "opening_hours", "label": "Opening hours" },
    { "type": "range", "id": "desktop_width_percent", "label": "Desktop width", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "range", "id": "section_padding", "label": "Vertical spacing", "min": 0, "max": 80, "step": 5, "unit": "px", "default": 40 },
    { "type": "range", "id": "corner_radius", "label": "Corner radius", "min": 0, "max": 30, "step": 2, "unit": "px", "default": 12 },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#FFFFFF" },
    { "type": "color", "id": "heading_color", "label": "Heading color", "default": "#1B2A4A" },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#1B2A4A" },
    { "type": "color", "id": "icon_color", "label": "Icon color", "default": "#1B2A4A" },
    { "type": "color", "id": "border_color", "label": "Border color", "default": "#E5E7EB" }
  ],
  "presets": [
    { "name": "Map and contact details" }
  ],
  "tag": null,
  "class": "map-contact-details"
}
{% endschema %}