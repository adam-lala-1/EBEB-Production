{% doc %}
  @prompt
    generate a section with full width background color same like CTA banner section, with one heading in middle and then followed in next row 4 usps again, with an image at left and right one text, and in between all usp there should be a divider small, and give me color options too
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-usp-band-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background: {{ block.settings.background_color }};
    color: {{ block.settings.text_color }};
    padding: {{ block.settings.vertical_padding }}px 24px;
  }

  .ai-usp-band__inner-{{ ai_gen_id }} {
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
  }

  .ai-usp-band__heading-{{ ai_gen_id }} {
    color: {{ block.settings.heading_color }};
    text-align: center;
    margin: 0 0 30px;
    font-size: {{ block.settings.heading_size }}px;
    line-height: 1.2;
  }

  .ai-usp-band__items-{{ ai_gen_id }} {
    /* display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr)); */
    align-items: stretch;
    display:flex;
    justify-content:center;
    
  }

  .ai-usp-band__item-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 14px;
    min-width: 0;
    padding: 8px 18px;
    position: relative;
  }

  .ai-usp-band__item-{{ ai_gen_id }}:not(:last-child)::after {
    content: '';
    position: absolute;
    top: 50%;
    right: 0;
    width: 1px;
    height: 32px;
    background: {{ block.settings.divider_color }};
    transform: translateY(-50%);
  }

  .ai-usp-band__image-{{ ai_gen_id }} {
    width: {{ block.settings.image_size }}px;
    height: {{ block.settings.image_size }}px;
    flex: 0 0 {{ block.settings.image_size }}px;
    overflow: hidden;
    border-radius: {{ block.settings.image_radius }}px;
  }

  .ai-usp-band__image-{{ ai_gen_id }} img,
  .ai-usp-band__image-{{ ai_gen_id }} svg {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-usp-band__image-{{ ai_gen_id }} svg {
    background: rgba(0, 0, 0, 0.06);
  }

  .ai-usp-band__copy-{{ ai_gen_id }} {
    min-width: 0;
  }

  .ai-usp-band__title-{{ ai_gen_id }} {
    color: {{ block.settings.heading_color }};
    font-size: {{ block.settings.item_heading_size }}px;
    font-weight: 700;
    line-height: 1.3;
    margin: 0;
  }

  .ai-usp-band__text-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: 14px;
    line-height: 1.45;
    margin-top: 4px;
  }

  @media screen and (max-width: 900px) {
    .ai-usp-band__items-{{ ai_gen_id }} {
      /* grid-template-columns: repeat(2, minmax(0, 1fr)); */
      flex-wrap:wrap;
      row-gap: 16px;
    }

    .ai-usp-band__item-{{ ai_gen_id }}:nth-child(2)::after {
      display: none;
    }
  }

  @media screen and (max-width: 560px) {
    .ai-usp-band-{{ ai_gen_id }} {
      padding: {{ block.settings.vertical_padding | divided_by: 2 }}px 16px;
    }

    .ai-usp-band__inner-{{ ai_gen_id }} {
      width: 100%;
    }

    .ai-usp-band__items-{{ ai_gen_id }} {
      /* grid-template-columns: 1fr; */
      row-gap: 10px;
      flex-direction:column;
    }

    .ai-usp-band__item-{{ ai_gen_id }} {
      padding: 10px 0;
    }

    .ai-usp-band__item-{{ ai_gen_id }}::after {
      display: none;
    }

    .ai-usp-band__heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.8 }}px;
      margin-bottom: 22px;
    }
  }
{% endstyle %}

<div class="ai-usp-band-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
<div class="eeb-container">
  <div class="ai-usp-band__inner-{{ ai_gen_id }}">
    {% if block.settings.heading != blank %}
      <h2 class="ai-usp-band__heading-{{ ai_gen_id }}">{{ block.settings.heading | escape }}</h2>
    {% endif %}
    <div class="ai-usp-band__items-{{ ai_gen_id }}">
      {% for i in (1..4) %}
        {% liquid
          assign image_key = 'usp_' | append: i | append: '_image'
          assign title_key = 'usp_' | append: i | append: '_title'
          assign text_key = 'usp_' | append: i | append: '_text'
          assign item_image = block.settings[image_key]
          assign item_title = block.settings[title_key]
          assign item_text = block.settings[text_key]
        %}
        <div class="ai-usp-band__item-{{ ai_gen_id }}">
          <div class="ai-usp-band__image-{{ ai_gen_id }}">
            {% if item_image != blank %}
              <img src="{{ item_image | image_url: width: 160 }}" alt="{{ item_image.alt | escape }}" loading="lazy" width="{{ item_image.width }}" height="{{ item_image.height }}">
            {% else %}
              {{ 'image' | placeholder_svg_tag }}
            {% endif %}
          </div>
          <div class="ai-usp-band__copy-{{ ai_gen_id }}">
            {% if item_title != blank %}<h3 class="ai-usp-band__title-{{ ai_gen_id }}">{{ item_title | escape }}</h3>{% endif %}
            {% if item_text != blank %}<div class="ai-usp-band__text-{{ ai_gen_id }}">{{ item_text | escape | newline_to_br }}</div>{% endif %}
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
  </div>
</div>

{% schema %}
{
  "name": "USP banner",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "The EveryBody difference" },
    { "type": "range", "id": "desktop_width_percent", "label": "Desktop content width", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "range", "id": "vertical_padding", "label": "Vertical padding", "min": 20, "max": 100, "step": 5, "unit": "px", "default": 40 },
    { "type": "range", "id": "heading_size", "label": "Heading size", "min": 20, "max": 48, "step": 2, "unit": "px", "default": 30 },
    { "type": "range", "id": "item_heading_size", "label": "USP heading size", "min": 12, "max": 24, "step": 2, "unit": "px", "default": 16 },
    { "type": "range", "id": "image_size", "label": "Image size", "min": 32, "max": 72, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "image_radius", "label": "Image corner radius", "min": 0, "max": 24, "step": 2, "unit": "px", "default": 8 },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#1B2A4A" },
    { "type": "color", "id": "heading_color", "label": "Heading", "default": "#FFFFFF" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#FFFFFF" },
    { "type": "color", "id": "divider_color", "label": "Divider", "default": "#AAB3C2" },
    { "type": "header", "content": "USP 1" },
    { "type": "image_picker", "id": "usp_1_image", "label": "Image" },
    { "type": "text", "id": "usp_1_title", "label": "Title", "default": "Local experts" },
    { "type": "textarea", "id": "usp_1_text", "label": "Description", "default": "Friendly advice from our e-bike team." },
    { "type": "header", "content": "USP 2" },
    { "type": "image_picker", "id": "usp_2_image", "label": "Image" },
    { "type": "text", "id": "usp_2_title", "label": "Title", "default": "Quality rides" },
    { "type": "textarea", "id": "usp_2_text", "label": "Description", "default": "Thoughtfully selected bikes and gear." },
    { "type": "header", "content": "USP 3" },
    { "type": "image_picker", "id": "usp_3_image", "label": "Image" },
    { "type": "text", "id": "usp_3_title", "label": "Title", "default": "Support you can trust" },
    { "type": "textarea", "id": "usp_3_text", "label": "Description", "default": "Help before and after your purchase." },
    { "type": "header", "content": "USP 4" },
    { "type": "image_picker", "id": "usp_4_image", "label": "Image" },
    { "type": "text", "id": "usp_4_title", "label": "Title", "default": "Ride with confidence" },
    { "type": "textarea", "id": "usp_4_text", "label": "Description", "default": "Discover a better way to get around." }
  ],
  "presets": [{ "name": "USP banner" }],
  "tag": null,
  "class": "usp-banner-block"
}
{% endschema %}