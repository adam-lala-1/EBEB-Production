{% doc %}
  @prompt
    add a section to generate 2cols CTA content, it contains heading text and a button in both cols, what about the text needs to be added betweeen heading and a button
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-two-cta-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
  }

  .ai-two-cta-{{ ai_gen_id }}__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: {{ block.settings.column_gap }}px;
  }

  .ai-two-cta-{{ ai_gen_id }}__card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 20px;
    min-height: {{ block.settings.card_min_height }}px;
    padding: {{ block.settings.card_padding }}px;
    background: {{ block.settings.background_color }};
    border: 1px solid {{ block.settings.border_color }};
    border-radius: {{ block.settings.corner_radius }}px;
  }

  .ai-two-cta-{{ ai_gen_id }}__heading {
    margin: 0;
    color: {{ block.settings.heading_color }};
    font-size: {{ block.settings.heading_size }}px;
    line-height: 1.2;
    font-weight: 700;
  }

  .ai-two-cta-{{ ai_gen_id }}__text {
    margin: 0;
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.text_size }}px;
    line-height: 1.55;
  }

  .ai-two-cta-{{ ai_gen_id }}__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 46px;
    margin-top: auto;
    padding: 12px 22px;
    border: 2px solid {{ block.settings.button_color }};
    border-radius: {{ block.settings.button_radius }}px;
    background: {{ block.settings.button_color }};
    color: {{ block.settings.button_text_color }};
    font: inherit;
    font-weight: 700;
    text-decoration: none;
  }

  .ai-two-cta-{{ ai_gen_id }}__button:hover {
    background: {{ block.settings.button_hover_color }};
    border-color: {{ block.settings.button_hover_color }};
    color: {{ block.settings.button_text_color }};
  }

  .ai-two-cta-{{ ai_gen_id }}__button:focus-visible {
    outline: 3px solid {{ block.settings.heading_color }};
    outline-offset: 3px;
  }

  @media screen and (max-width: 749px) {
    .ai-two-cta-{{ ai_gen_id }} { width: 100%; }
    .ai-two-cta-{{ ai_gen_id }}__grid { grid-template-columns: 1fr; }
    .ai-two-cta-{{ ai_gen_id }}__card { min-height: auto; }
  }
{% endstyle %}

<div class="ai-two-cta-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-two-cta-{{ ai_gen_id }}__grid">
    <div class="ai-two-cta-{{ ai_gen_id }}__card">
      {% if block.settings.heading_one != blank %}<h2 class="ai-two-cta-{{ ai_gen_id }}__heading">{{ block.settings.heading_one | escape }}</h2>{% endif %}
      {% if block.settings.text_one != blank %}<p class="ai-two-cta-{{ ai_gen_id }}__text">{{ block.settings.text_one | escape | newline_to_br }}</p>{% endif %}
      {% if block.settings.button_label_one != blank %}
        {% if block.settings.button_link_one != blank %}<a class="ai-two-cta-{{ ai_gen_id }}__button" href="{{ block.settings.button_link_one }}">{{ block.settings.button_label_one | escape }}</a>{% else %}<span class="ai-two-cta-{{ ai_gen_id }}__button">{{ block.settings.button_label_one | escape }}</span>{% endif %}
      {% endif %}
    </div>
    <div class="ai-two-cta-{{ ai_gen_id }}__card">
      {% if block.settings.heading_two != blank %}<h2 class="ai-two-cta-{{ ai_gen_id }}__heading">{{ block.settings.heading_two | escape }}</h2>{% endif %}
      {% if block.settings.text_two != blank %}<p class="ai-two-cta-{{ ai_gen_id }}__text">{{ block.settings.text_two | escape | newline_to_br }}</p>{% endif %}
      {% if block.settings.button_label_two != blank %}
        {% if block.settings.button_link_two != blank %}<a class="ai-two-cta-{{ ai_gen_id }}__button" href="{{ block.settings.button_link_two }}">{{ block.settings.button_label_two | escape }}</a>{% else %}<span class="ai-two-cta-{{ ai_gen_id }}__button">{{ block.settings.button_label_two | escape }}</span>{% endif %}
      {% endif %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Two-column CTAs",
  "settings": [
    { "type": "header", "content": "First column" },
    { "type": "text", "id": "heading_one", "label": "Heading", "default": "Book a service" },
    { "type": "textarea", "id": "text_one", "label": "Supporting text", "default": "Get expert help to keep your e-bike running smoothly." },
    { "type": "text", "id": "button_label_one", "label": "Button label", "default": "Explore servicing" },
    { "type": "url", "id": "button_link_one", "label": "Button link" },
    { "type": "header", "content": "Second column" },
    { "type": "text", "id": "heading_two", "label": "Heading", "default": "Book a test ride" },
    { "type": "textarea", "id": "text_two", "label": "Supporting text", "default": "Find the right e-bike for your next ride." },
    { "type": "text", "id": "button_label_two", "label": "Button label", "default": "Find your ride" },
    { "type": "url", "id": "button_link_two", "label": "Button link" },
    { "type": "header", "content": "Layout and style" },
    { "type": "range", "id": "desktop_width_percent", "label": "Desktop width", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "range", "id": "column_gap", "label": "Column gap", "min": 0, "max": 60, "step": 5, "unit": "px", "default": 25 },
    { "type": "range", "id": "card_min_height", "label": "Card minimum height", "min": 120, "max": 400, "step": 10, "unit": "px", "default": 200 },
    { "type": "range", "id": "card_padding", "label": "Card padding", "min": 15, "max": 60, "step": 5, "unit": "px", "default": 30 },
    { "type": "range", "id": "corner_radius", "label": "Card corner radius", "min": 0, "max": 30, "step": 2, "unit": "px", "default": 12 },
    { "type": "range", "id": "heading_size", "label": "Heading size", "min": 18, "max": 48, "step": 2, "unit": "px", "default": 30 },
    { "type": "range", "id": "text_size", "label": "Text size", "min": 12, "max": 24, "step": 1, "unit": "px", "default": 16 },
    { "type": "color", "id": "background_color", "label": "Card background", "default": "#FFFFFF" },
    { "type": "color", "id": "border_color", "label": "Border", "default": "#E5E7EB" },
    { "type": "color", "id": "heading_color", "label": "Heading", "default": "#1B2A4A" },
    { "type": "color", "id": "text_color", "label": "Supporting text", "default": "#1B2A4A" },
    { "type": "color", "id": "button_color", "label": "Button", "default": "#E86C2C" },
    { "type": "color", "id": "button_hover_color", "label": "Button hover", "default": "#1B2A4A" },
    { "type": "color", "id": "button_text_color", "label": "Button text", "default": "#FFFFFF" },
    { "type": "range", "id": "button_radius", "label": "Button corner radius", "min": 0, "max": 30, "step": 2, "unit": "px", "default": 8 }
  ],
  "presets": [{ "name": "Two-column CTAs" }],
  "tag": null,
  "class": "two-column-ctas"
}
{% endschema %}