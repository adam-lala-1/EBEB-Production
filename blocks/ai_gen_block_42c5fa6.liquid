{% doc %}
  @prompt
    generate a 5 usp section, no usp should be an image with left side not on top and no border around cols, instead place an seperater between
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-usp-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: 36px 24px;
    background: {{ block.settings.background_color }};
    color: {{ block.settings.text_color }};
  }

  .ai-usp-{{ ai_gen_id }}__inner {
    width: 100%;
    max-width: 1180px;
    margin: 0 auto;
  }

  .ai-usp-{{ ai_gen_id }}__heading {
    margin: 0 0 24px;
    color: {{ block.settings.heading_color }};
    text-align: center;
    font-size: clamp(24px, 3vw, 34px);
    line-height: 1.2;
  }

  .ai-usp-{{ ai_gen_id }}__grid {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
  }

  .ai-usp-{{ ai_gen_id }}__item {
    display: flex;
    align-items: center;
    gap: 12px;
    min-width: 0;
    padding: 12px 16px;
    border-right: 1px solid {{ block.settings.separator_color }};
  }

  .ai-usp-{{ ai_gen_id }}__item:last-child {
    border-right: 0;
  }

  .ai-usp-{{ ai_gen_id }}__media,
  .ai-usp-{{ ai_gen_id }}__placeholder {
    display: flex;
    flex: 0 0 52px;
    align-items: center;
    justify-content: center;
    width: 52px;
    height: 52px;
    overflow: hidden;
    border-radius: 8px;
    background: {{ block.settings.image_background }};
  }

  .ai-usp-{{ ai_gen_id }}__media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-usp-{{ ai_gen_id }}__placeholder svg {
    display: block;
    width: 100%;
    height: 100%;
    color: {{ block.settings.heading_color }};
  }

  .ai-usp-{{ ai_gen_id }}__title {
    margin: 0 0 6px;
    color: {{ block.settings.heading_color }};
    font-size: 16px;
    line-height: 1.3;
  }

  .ai-usp-{{ ai_gen_id }}__copy {
    margin: 0;
    color: {{ block.settings.text_color }};
    font-size: 13px;
    line-height: 1.5;
  }

  @media screen and (max-width: 990px) {
    .ai-usp-{{ ai_gen_id }}__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .ai-usp-{{ ai_gen_id }}__item {
      border-right: 0;
      border-bottom: 1px solid {{ block.settings.separator_color }};
    }

    .ai-usp-{{ ai_gen_id }}__item:nth-last-child(-n + 1) {
      border-bottom: 0;
    }
  }

  @media screen and (max-width: 600px) {
    .ai-usp-{{ ai_gen_id }} {
      padding: 28px 16px;
    }

    .ai-usp-{{ ai_gen_id }}__grid {
      grid-template-columns: 1fr;
    }

    .ai-usp-{{ ai_gen_id }}__item {
      padding: 14px 4px;
    }

    .ai-usp-{{ ai_gen_id }}__item:nth-last-child(-n + 1) {
      border-bottom: 0;
    }
  }
{% endstyle %}

<section class="ai-usp-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
 <div class="eeb-container">
  <div class="ai-usp-{{ ai_gen_id }}__inner">
    {% if block.settings.heading != blank %}
      <h2 class="ai-usp-{{ ai_gen_id }}__heading">{{ block.settings.heading | escape }}</h2>
    {% endif %}
    <div class="ai-usp-{{ ai_gen_id }}__grid">
      {% for i in (1..5) %}
        {% liquid
          assign title_key = 'usp_' | append: i | append: '_title'
          assign copy_key = 'usp_' | append: i | append: '_copy'
          assign image_key = 'usp_' | append: i | append: '_image'
          assign usp_title = block.settings[title_key]
          assign usp_copy = block.settings[copy_key]
          assign usp_image = block.settings[image_key]
        %}
        <article class="ai-usp-{{ ai_gen_id }}__item">
          {% if usp_image != blank %}
            <div class="ai-usp-{{ ai_gen_id }}__media">
              <img src="{{ usp_image | image_url: width: 160 }}" alt="{{ usp_image.alt | default: usp_title | escape }}" width="52" height="52" loading="lazy">
            </div>
          {% else %}
            <div class="ai-usp-{{ ai_gen_id }}__placeholder">
              {{ 'image' | placeholder_svg_tag }}
            </div>
          {% endif %}
          <div>
            {% if usp_title != blank %}<h3 class="ai-usp-{{ ai_gen_id }}__title">{{ usp_title | escape }}</h3>{% endif %}
            {% if usp_copy != blank %}<p class="ai-usp-{{ ai_gen_id }}__copy">{{ usp_copy | escape }}</p>{% endif %}
          </div>
        </article>
      {% endfor %}
    </div>
  </div>
  </div>
</section>

{% schema %}
{
  "name": "Five USPs",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Why ride with us" },
    { "type": "range", "id": "desktop_width_percent", "label": "Desktop width", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "color", "id": "background_color", "label": "Section background", "default": "#FFFFFF" },
    { "type": "color", "id": "image_background", "label": "Image background", "default": "#F8F5F0" },
    { "type": "color", "id": "heading_color", "label": "Headings", "default": "#1B2A4A" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#1B2A4A" },
    { "type": "color", "id": "separator_color", "label": "Separators", "default": "#E5E7EB" },
    { "type": "header", "content": "Benefit 1" },
    { "type": "image_picker", "id": "usp_1_image", "label": "Image" },
    { "type": "text", "id": "usp_1_title", "label": "Title", "default": "Locally focused" },
    { "type": "textarea", "id": "usp_1_copy", "label": "Description", "default": "Friendly support for riders in our community." },
    { "type": "header", "content": "Benefit 2" },
    { "type": "image_picker", "id": "usp_2_image", "label": "Image" },
    { "type": "text", "id": "usp_2_title", "label": "Title", "default": "E-bike know-how" },
    { "type": "textarea", "id": "usp_2_copy", "label": "Description", "default": "Guidance to help you find the right ride and setup." },
    { "type": "header", "content": "Benefit 3" },
    { "type": "image_picker", "id": "usp_3_image", "label": "Image" },
    { "type": "text", "id": "usp_3_title", "label": "Title", "default": "Service support" },
    { "type": "textarea", "id": "usp_3_copy", "label": "Description", "default": "Help with servicing and keeping your bike ride-ready." },
    { "type": "header", "content": "Benefit 4" },
    { "type": "image_picker", "id": "usp_4_image", "label": "Image" },
    { "type": "text", "id": "usp_4_title", "label": "Title", "default": "Real-world advice" },
    { "type": "textarea", "id": "usp_4_copy", "label": "Description", "default": "Practical recommendations for the way you ride." },
    { "type": "header", "content": "Benefit 5" },
    { "type": "image_picker", "id": "usp_5_image", "label": "Image" },
    { "type": "text", "id": "usp_5_title", "label": "Title", "default": "Here for the journey" },
    { "type": "textarea", "id": "usp_5_copy", "label": "Description", "default": "Support before and after you choose your bike." }
  ],
  "presets": [{ "name": "Five USPs" }],
  "tag": null,
  "class": "five-usps-block"
}
{% endschema %}