{% doc %}
  @prompt
    generate a section with left and right content only, left side content and right side too, we have a section heading also, and in cols it should have one bg color with borderradius and some gap between them, why heading h2 are coming , no need of html tags to be displayed
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-two-column-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
  }
  .ai-two-column__inner-{{ ai_gen_id }} { width: 100%; }
  .ai-two-column__heading-{{ ai_gen_id }} {
    color: {{ block.settings.heading_color }};
    font-size: {{ block.settings.heading_size }}px;
    line-height: 1.2;
    margin: 0 0 {{ block.settings.column_gap }}px;
  }
  .ai-two-column__grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: {{ block.settings.column_gap }}px;
  }
  .ai-two-column__card-{{ ai_gen_id }} {
    min-width: 0;
    padding: {{ block.settings.card_padding }}px;
    border-radius: {{ block.settings.border_radius }}px;
    background: {{ block.settings.background_color }};
    color: {{ block.settings.text_color }};
  }
  .ai-two-column__card-{{ ai_gen_id }} h3 {
    color: {{ block.settings.heading_color }};
    font-size: {{ block.settings.card_heading_size }}px;
    line-height: 1.3;
    margin: 0 0 12px;
  }
  .ai-two-column__content-{{ ai_gen_id }} {
    font-size: {{ block.settings.body_size }}px;
    line-height: 1.6;
  }
  .ai-two-column__content-{{ ai_gen_id }} p:first-child { margin-top: 0; }
  .ai-two-column__content-{{ ai_gen_id }} p:last-child { margin-bottom: 0; }
  @media screen and (max-width: 749px) {
    .ai-two-column-{{ ai_gen_id }} { width: 100%; }
    .ai-two-column__grid-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: {{ block.settings.column_gap | at_most: 40 }}px;
    }
    .ai-two-column__heading-{{ ai_gen_id }} { font-size: {{ block.settings.heading_size | times: 0.8 }}px; }
  }
{% endstyle %}

<div class="ai-two-column-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
 <div class="eeb-container">
  <div class="ai-two-column__inner-{{ ai_gen_id }}">
    {% if block.settings.section_heading != blank %}
      <h2 class="ai-two-column__heading-{{ ai_gen_id }}">{{ block.settings.section_heading | escape }}</h2>
    {% endif %}
    <div class="ai-two-column__grid-{{ ai_gen_id }}">
      <div class="ai-two-column__card-{{ ai_gen_id }}">
        {% if block.settings.left_heading != blank %}<h3>{{ block.settings.left_heading | escape }}</h3>{% endif %}
        <div class="ai-two-column__content-{{ ai_gen_id }}">{{ block.settings.left_content }}</div>
      </div>
      <div class="ai-two-column__card-{{ ai_gen_id }}">
        {% if block.settings.right_heading != blank %}<h3>{{ block.settings.right_heading | escape }}</h3>{% endif %}
        <div class="ai-two-column__content-{{ ai_gen_id }}">{{ block.settings.right_content }}</div>
      </div>
    </div>
  </div>
  </div>
</div>

{% schema %}
{
  "name": "Two-column content",
  "settings": [
    { "type": "text", "id": "section_heading", "label": "Section heading", "default": "Explore our services" },
    { "type": "text", "id": "left_heading", "label": "Left column heading", "default": "Left column" },
    { "type": "richtext", "id": "left_content", "label": "Left column content", "default": "<p>Add details for the left column here.</p>" },
    { "type": "text", "id": "right_heading", "label": "Right column heading", "default": "Right column" },
    { "type": "richtext", "id": "right_content", "label": "Right column content", "default": "<p>Add details for the right column here.</p>" },
    { "type": "range", "id": "desktop_width_percent", "label": "Desktop width", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "header", "content": "Style" },
    { "type": "color", "id": "background_color", "label": "Card background", "default": "#F8F5F0" },
    { "type": "color", "id": "heading_color", "label": "Heading color", "default": "#1B2A4A" },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#1B2A4A" },
    { "type": "range", "id": "heading_size", "label": "Section heading size", "min": 20, "max": 48, "step": 2, "unit": "px", "default": 32 },
    { "type": "range", "id": "card_heading_size", "label": "Column heading size", "min": 16, "max": 32, "step": 2, "unit": "px", "default": 22 },
    { "type": "range", "id": "body_size", "label": "Body text size", "min": 14, "max": 22, "step": 1, "unit": "px", "default": 16 },
    { "type": "range", "id": "column_gap", "label": "Column gap", "min": 8, "max": 40, "step": 4, "unit": "px", "default": 20 },
    { "type": "range", "id": "card_padding", "label": "Card padding", "min": 12, "max": 48, "step": 4, "unit": "px", "default": 28 },
    { "type": "range", "id": "border_radius", "label": "Border radius", "min": 0, "max": 32, "step": 2, "unit": "px", "default": 12 }
  ],
  "presets": [{ "name": "Two-column content" }],
  "tag": null,
  "class": "two-column-content"
}
{% endschema %}