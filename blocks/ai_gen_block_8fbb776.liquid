{% doc %}
  @prompt
    generate s section with 3cools content, each col has heading and a text, and the section has the heading too
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-three-columns-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin-inline: auto;
    padding: {{ block.settings.vertical_padding }}px 20px;
    background: {{ block.settings.background_color }};
    color: {{ block.settings.text_color }};
  }
  .ai-three-columns__inner-{{ ai_gen_id }} { width: 100%; max-width: 1100px; margin-inline: auto; }
  .ai-three-columns__title-{{ ai_gen_id }} {
    margin: 0 0 32px; color: {{ block.settings.heading_color }};
    text-align: {{ block.settings.heading_alignment }}; font-size: {{ block.settings.heading_size }}px; line-height: 1.2;
  }
  .ai-three-columns__grid-{{ ai_gen_id }} { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px; }
  .ai-three-columns__item-{{ ai_gen_id }} {
    padding: 24px; border: 1px solid {{ block.settings.border_color }};
    border-radius: 12px; background: {{ block.settings.card_color }};
  }
  .ai-three-columns__item-title-{{ ai_gen_id }} {
    margin: 0 0 12px; color: {{ block.settings.heading_color }};
    font-size: {{ block.settings.column_heading_size }}px; line-height: 1.3;
  }
  .ai-three-columns__text-{{ ai_gen_id }} { color: {{ block.settings.text_color }}; font-size: 16px; line-height: 1.6; }
  .ai-three-columns__text-{{ ai_gen_id }} p { margin: 0; }
  @media screen and (max-width: 749px) {
    .ai-three-columns-{{ ai_gen_id }} { padding: {{ block.settings.mobile_padding }}px 16px; }
    .ai-three-columns__title-{{ ai_gen_id }} { margin-bottom: 24px; font-size: {{ block.settings.mobile_heading_size }}px; }
    .ai-three-columns__grid-{{ ai_gen_id }} { grid-template-columns: 1fr; gap: 16px; }
  }
{% endstyle %}

<div class="ai-three-columns-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-three-columns__inner-{{ ai_gen_id }}">
    {% if block.settings.section_heading != blank %}<h2 class="ai-three-columns__title-{{ ai_gen_id }}">{{ block.settings.section_heading | escape }}</h2>{% endif %}
    <div class="ai-three-columns__grid-{{ ai_gen_id }}">
      {% for i in (1..3) %}
        {% assign heading_key = 'column_' | append: i | append: '_heading' %}
        {% assign text_key = 'column_' | append: i | append: '_text' %}
        {% assign column_heading = block.settings[heading_key] %}
        {% assign column_text = block.settings[text_key] %}
        <article class="ai-three-columns__item-{{ ai_gen_id }}">
          {% if column_heading != blank %}<h3 class="ai-three-columns__item-title-{{ ai_gen_id }}">{{ column_heading | escape }}</h3>{% endif %}
          {% if column_text != blank %}<div class="ai-three-columns__text-{{ ai_gen_id }}">{{ column_text }}</div>{% endif %}
        </article>
      {% endfor %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Three-column content",
  "settings": [
    { "type": "text", "id": "section_heading", "label": "Section heading", "default": "Why choose us" },
    { "type": "select", "id": "heading_alignment", "label": "Heading alignment", "options": [{ "value": "left", "label": "Left" }, { "value": "center", "label": "Center" }], "default": "center" },
    { "type": "text", "id": "column_1_heading", "label": "Column 1 heading", "default": "Expert advice" },
    { "type": "richtext", "id": "column_1_text", "label": "Column 1 text", "default": "<p>Get helpful guidance from a team that knows cycling.</p>" },
    { "type": "text", "id": "column_2_heading", "label": "Column 2 heading", "default": "Quality service" },
    { "type": "richtext", "id": "column_2_text", "label": "Column 2 text", "default": "<p>Keep your bike running smoothly with care you can trust.</p>" },
    { "type": "text", "id": "column_3_heading", "label": "Column 3 heading", "default": "Ready to ride" },
    { "type": "richtext", "id": "column_3_text", "label": "Column 3 text", "default": "<p>Find the right bike and enjoy the ride with confidence.</p>" },
    { "type": "range", "id": "desktop_width_percent", "label": "Desktop width", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "range", "id": "heading_size", "label": "Section heading size", "min": 24, "max": 48, "step": 2, "unit": "px", "default": 34 },
    { "type": "range", "id": "mobile_heading_size", "label": "Mobile heading size", "min": 20, "max": 36, "step": 2, "unit": "px", "default": 28 },
    { "type": "range", "id": "column_heading_size", "label": "Column heading size", "min": 16, "max": 30, "step": 2, "unit": "px", "default": 22 },
    { "type": "range", "id": "vertical_padding", "label": "Desktop spacing", "min": 0, "max": 80, "step": 5, "unit": "px", "default": 40 },
    { "type": "range", "id": "mobile_padding", "label": "Mobile spacing", "min": 0, "max": 60, "step": 5, "unit": "px", "default": 25 },
    { "type": "color", "id": "background_color", "label": "Section background", "default": "#FFFFFF" },
    { "type": "color", "id": "card_color", "label": "Card background", "default": "#FFFFFF" },
    { "type": "color", "id": "heading_color", "label": "Headings", "default": "#1B2A4A" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#1B2A4A" },
    { "type": "color", "id": "border_color", "label": "Borders", "default": "#E5E7EB" }
  ],
  "presets": [{ "name": "Three-column content" }],
  "tag": null,
  "class": "three-column-content"
}
{% endschema %}