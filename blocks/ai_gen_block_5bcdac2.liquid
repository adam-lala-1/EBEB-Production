{% doc %}
  @prompt
    generate a 3 cols section, where each col has a img with 70px width and right side heading and list of content in bottomof that, under image nothign should come up, under heading only all the icon list should come, icon should be check list in orange color, no border for each cols, just add seperater between each cols
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-three-columns-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin-inline: auto;
    color: #1B2A4A;
  }

  .ai-three-columns-{{ ai_gen_id }}__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .ai-three-columns-{{ ai_gen_id }}__card {
    min-width: 0;
    padding: 22px;
    background: #ffffff;
  }

  .ai-three-columns-{{ ai_gen_id }}__card:not(:last-child) {
    border-right: 1px solid #E5E7EB;
  }

  .ai-three-columns-{{ ai_gen_id }}__content {
    display: flex;
    align-items: flex-start;
    gap: 16px;
  }

  .ai-three-columns-{{ ai_gen_id }}__image-wrap {
    width: 70px;
    height: 70px;
    flex: 0 0 70px;
    overflow: hidden;
    border-radius: 10px;
    
  }

  .ai-three-columns-{{ ai_gen_id }}__image-wrap img,
  .ai-three-columns-{{ ai_gen_id }}__image-wrap svg {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-three-columns-{{ ai_gen_id }}__details {
    flex: 1;
    min-width: 0;
  }

  .ai-three-columns-{{ ai_gen_id }}__heading {
    margin: 0 0 14px;
    color: #1B2A4A;
    font-size: 20px;
    line-height: 1.25;
  }

  .ai-three-columns-{{ ai_gen_id }}__list {
    display: grid;
    gap: 10px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .ai-three-columns-{{ ai_gen_id }}__list-item {
    display: flex;
    align-items: flex-start;
    gap: 9px;
    margin: 0;
    color: #1B2A4A;
    line-height: 1.5;
  }

  .ai-three-columns-{{ ai_gen_id }}__check {
    flex: 0 0 18px;
    width: 18px;
    height: 18px;
    margin-top: 2px;
    color: #E86C2C;
  }

  @media screen and (max-width: 749px) {
    .ai-three-columns-{{ ai_gen_id }}__grid {
      grid-template-columns: 1fr;
    }

    .ai-three-columns-{{ ai_gen_id }}__card {
      padding: 20px 0;
    }

    .ai-three-columns-{{ ai_gen_id }}__card:not(:last-child) {
      border-right: 0;
      border-bottom: 1px solid #E5E7EB;
    }
  }
{% endstyle %}

<div class="ai-three-columns-{{ ai_gen_id }}" style="background: var(--color-cream); width: {{ block.settings.desktop_width_percent }}%;" {{ block.shopify_attributes }}>
<div class="eeb-container">
  <div class="ai-three-columns-{{ ai_gen_id }}__grid">
    {% for i in (1..3) %}
      {% assign image_key = 'column_' | append: i | append: '_image' %}
      {% assign heading_key = 'column_' | append: i | append: '_heading' %}
      {% assign content_key = 'column_' | append: i | append: '_items' %}
      {% assign column_image = block.settings[image_key] %}
      {% assign column_heading = block.settings[heading_key] %}
      {% assign column_items = block.settings[content_key] | newline_to_br | split: '<br />' %}
      <article class="ai-three-columns-{{ ai_gen_id }}__card">
        <div class="ai-three-columns-{{ ai_gen_id }}__content">
          <div class="ai-three-columns-{{ ai_gen_id }}__image-wrap">
            {% if column_image != blank %}
              <img src="{{ column_image | image_url: width: 140 }}" alt="{{ column_image.alt | default: column_heading | escape }}" width="70" height="70" loading="lazy">
            {% else %}
              {{ 'image' | placeholder_svg_tag }}
            {% endif %}
          </div>
          <div class="ai-three-columns-{{ ai_gen_id }}__details">
            {% if column_heading != blank %}
              <h2 class="ai-three-columns-{{ ai_gen_id }}__heading">{{ column_heading | escape }}</h2>
            {% endif %}
            {% if block.settings[content_key] != blank %}
              <ul class="ai-three-columns-{{ ai_gen_id }}__list">
                {% for item in column_items %}
                  {% assign clean_item = item | strip_html | strip %}
                  {% if clean_item != blank %}
                    <li class="ai-three-columns-{{ ai_gen_id }}__list-item">
                      <svg class="ai-three-columns-{{ ai_gen_id }}__check" viewBox="0 0 20 20" fill="none" aria-hidden="true" focusable="false">
                        <path d="m4 10.5 4 4L16.5 6" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
                      </svg>
                      <span>{{ clean_item | escape }}</span>
                    </li>
                  {% endif %}
                {% endfor %}
              </ul>
            {% endif %}
          </div>
        </div>
      </article>
    {% endfor %}
  </div>
  </div>
</div>

{% schema %}
{
  "name": "Three column details",
  "settings": [
    { "type": "range", "id": "desktop_width_percent", "label": "Desktop width", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "header", "content": "Column 1" },
    { "type": "image_picker", "id": "column_1_image", "label": "Image" },
    { "type": "text", "id": "column_1_heading", "label": "Heading", "default": "Column one" },
    { "type": "textarea", "id": "column_1_items", "label": "List items", "default": "First detail\nSecond detail\nThird detail" },
    { "type": "header", "content": "Column 2" },
    { "type": "image_picker", "id": "column_2_image", "label": "Image" },
    { "type": "text", "id": "column_2_heading", "label": "Heading", "default": "Column two" },
    { "type": "textarea", "id": "column_2_items", "label": "List items", "default": "First detail\nSecond detail\nThird detail" },
    { "type": "header", "content": "Column 3" },
    { "type": "image_picker", "id": "column_3_image", "label": "Image" },
    { "type": "text", "id": "column_3_heading", "label": "Heading", "default": "Column three" },
    { "type": "textarea", "id": "column_3_items", "label": "List items", "default": "First detail\nSecond detail\nThird detail" }
  ],
  "presets": [{ "name": "Three column details" }],
  "tag": null,
  "class": "three-column-details"
}
{% endschema %}