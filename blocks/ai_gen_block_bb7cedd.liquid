{% doc %}
  @prompt
    left and right section with left siide text and right side image, left side it includes heaing and content 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-split-content-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
  }

  .ai-split-content__inner-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    align-items: center;
    gap: {{ block.settings.column_gap }}px;
    padding: {{ block.settings.section_padding }}px;
    background: {{ block.settings.background_color }};
    border-radius: {{ block.settings.corner_radius }}px;
  }

  .ai-split-content__text-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
  }

  .ai-split-content__heading-{{ ai_gen_id }} {
    margin: 0 0 16px;
    color: {{ block.settings.heading_color }};
    font-size: clamp(28px, 3vw, {{ block.settings.heading_size }}px);
    line-height: 1.15;
  }

  .ai-split-content__body-{{ ai_gen_id }} {
    font-size: {{ block.settings.body_size }}px;
    line-height: 1.65;
  }

  .ai-split-content__body-{{ ai_gen_id }} p {
    margin: 0 0 1em;
  }

  .ai-split-content__body-{{ ai_gen_id }} p:last-child {
    margin-bottom: 0;
  }

  .ai-split-content__media-{{ ai_gen_id }} {
    width: 100%;
    overflow: hidden;
    border-radius: {{ block.settings.image_radius }}px;
    aspect-ratio: 4 / 3;
    background: #f1f2f4;
  }

  .ai-split-content__media-{{ ai_gen_id }} img,
  .ai-split-content__media-{{ ai_gen_id }} svg {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-split-content__placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
  }

  @media screen and (max-width: 749px) {
    .ai-split-content-{{ ai_gen_id }} {
      width: 100%;
    }

    .ai-split-content__inner-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: 24px;
      padding: {{ block.settings.section_padding | divided_by: 2 }}px;
    }

    .ai-split-content__media-{{ ai_gen_id }} {
      grid-row: 1;
    }
  }
{% endstyle %}

<div class="ai-split-content-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
 <div class="eeb-container">
  <div class="ai-split-content__inner-{{ ai_gen_id }}">
    <div class="ai-split-content__text-{{ ai_gen_id }}">
      {% if block.settings.heading != blank %}
        <h2 class="ai-split-content__heading-{{ ai_gen_id }}">{{ block.settings.heading | escape }}</h2>
      {% endif %}
      {% if block.settings.content != blank %}
        <div class="ai-split-content__body-{{ ai_gen_id }}">{{ block.settings.content }}</div>
      {% endif %}
    </div>
    <div class="ai-split-content__media-{{ ai_gen_id }}">
      {% if block.settings.image != blank %}
        <img
          src="{{ block.settings.image | image_url: width: 1600 }}"
          alt="{{ block.settings.image.alt | escape }}"
          loading="lazy"
          width="{{ block.settings.image.width }}"
          height="{{ block.settings.image.height }}"
        >
      {% else %}
        <div class="ai-split-content__placeholder-{{ ai_gen_id }}">
          {{ 'image' | placeholder_svg_tag }}
        </div>
      {% endif %}
    </div>
  </div>
  </div>
</div>

{% schema %}
{
  "name": "Text and image split",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Built for every ride"
    },
    {
      "type": "richtext",
      "id": "content",
      "label": "Content",
      "default": "<p>Add your message here. Share useful details about your products, services, or brand.</p>"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "column_gap",
      "label": "Column gap",
      "min": 16,
      "max": 80,
      "step": 8,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "section_padding",
      "label": "Section padding",
      "min": 0,
      "max": 64,
      "step": 8,
      "unit": "px",
      "default": 24
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 28,
      "max": 60,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "body_size",
      "label": "Body text size",
      "min": 14,
      "max": 22,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "corner_radius",
      "label": "Section corner radius",
      "min": 0,
      "max": 32,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "image_radius",
      "label": "Image corner radius",
      "min": 0,
      "max": 32,
      "step": 4,
      "unit": "px",
      "default": 8
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading",
      "default": "#1B2A4A"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#1B2A4A"
    }
  ],
  "presets": [
    {
      "name": "Text and image split"
    }
  ],
  "tag": null,
  "class": "text-image-split"
}
{% endschema %}