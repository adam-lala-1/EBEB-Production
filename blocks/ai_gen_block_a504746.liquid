{% doc %}
  @prompt
    generate a section with bg color, and in this section it totally has 1 row 2cols, 1st col it has one image and left with right side heading and text, and the 2clol has 3 buttons and i need options too choice too, 2cols should be of 50% width in desktop and responsive in movile, buttons should be in flex wrap based upon width, and those buttons should have icons which i give, no i mean for buttons, if it fits in one row 2buttons then its good, and another will go in next row in middle alignement between 2buttons, and if there is no link for the button it should not sidplay too
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-info-actions-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: {{ block.settings.padding }}px;
    background: {{ block.settings.background_color }};
    color: {{ block.settings.text_color }};
    box-sizing: border-box;
  }
  .ai-info-actions-{{ ai_gen_id }}__inner {
    width: 100%;
    max-width: {{ block.settings.content_width }}px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    align-items: center;
    gap: {{ block.settings.column_gap }}px;
  }
  .ai-info-actions-{{ ai_gen_id }}__feature {
    display: grid;
    grid-template-columns: minmax(0, 0.5fr) minmax(0, 1.5fr);
    align-items: center;
    gap: 24px;
    min-width: 0;
  }
  .ai-info-actions-{{ ai_gen_id }}__image-wrap {
    width: 100%;
    overflow: hidden;
    border-radius: {{ block.settings.image_radius }}px;
   /* background: {{ block.settings.placeholder_color }}; */
  }
  .ai-info-actions-{{ ai_gen_id }}__image-wrap img,
  .ai-info-actions-{{ ai_gen_id }}__image-wrap svg {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }
  .ai-info-actions-{{ ai_gen_id }}__copy h2 {
    margin: 0 0 12px;
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.heading_size }}px;
    line-height: 1.15;
  }
  .ai-info-actions-{{ ai_gen_id }}__copy p {
    margin: 0;
    color: {{ block.settings.text_color }};
    line-height: 1.6;
  }
  .ai-info-actions-{{ ai_gen_id }}__buttons {
    display: flex;
    flex-flow: row wrap;
    align-items: center;
    justify-content: center;
    gap: 12px;
    min-width: 0;
  }
  .ai-info-actions-{{ ai_gen_id }}__button {
    display: inline-flex;
    flex: 1 1 calc(50% - 12px);
    max-width: calc(50% - 6px);
    min-width: 0;
    min-height: 48px;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 12px 18px;
    border: 2px solid #E86C2C;
    border-radius: {{ block.settings.button_radius }}px;
    background: {{ block.settings.button_color }};
    color: {{ block.settings.button_text_color }};
    font-size: 16px;
    font-weight: 600;
    line-height: 1.25;
    text-align: center;
    text-decoration: none;
    transition: background-color 160ms ease, color 160ms ease;
  }
  .ai-info-actions-{{ ai_gen_id }}__button:nth-child(3) {
    margin-inline: auto;
  }
  .ai-info-actions-{{ ai_gen_id }}__button:hover {
    background: {{ block.settings.button_hover_color }};
    border-color: #E86C2C;
    color: {{ block.settings.button_hover_text_color }};
  }
  .ai-info-actions-{{ ai_gen_id }}__button:focus-visible {
    outline: 3px solid {{ block.settings.text_color }};
    outline-offset: 3px;
  }
  .ai-info-actions-{{ ai_gen_id }}__button-icon {
    display: block;
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    flex: 0 0 {{ block.settings.icon_size }}px;
    object-fit: contain;
  }
  @media screen and (max-width: 749px) {
    .ai-info-actions-{{ ai_gen_id }} {
      padding: {{ block.settings.mobile_padding }}px;
    }
    .ai-info-actions-{{ ai_gen_id }}__inner,
    .ai-info-actions-{{ ai_gen_id }}__feature {
      grid-template-columns: minmax(0, 1fr);
    }
    .ai-info-actions-{{ ai_gen_id }}__inner {
      gap: 24px;
    }
    .ai-info-actions-{{ ai_gen_id }}__copy h2 {
      font-size: {{ block.settings.mobile_heading_size }}px;
    }
  }
{% endstyle %}

<div class="ai-info-actions-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
<div class="eeb-container">
  <div class="ai-info-actions-{{ ai_gen_id }}__inner">
    <div class="ai-info-actions-{{ ai_gen_id }}__feature">
      <div class="ai-info-actions-{{ ai_gen_id }}__image-wrap">
        {% if block.settings.image != blank %}
          <img src="{{ block.settings.image | image_url: width: 900 }}" alt="{{ block.settings.image.alt | escape }}" loading="lazy" width="{{ block.settings.image.width }}" height="{{ block.settings.image.height }}">
        {% else %}
          {{ 'image' | placeholder_svg_tag }}
        {% endif %}
      </div>
      <div class="ai-info-actions-{{ ai_gen_id }}__copy">
        {% if block.settings.heading != blank %}<h2>{{ block.settings.heading | escape }}</h2>{% endif %}
        {% if block.settings.description != blank %}<p>{{ block.settings.description | escape | newline_to_br }}</p>{% endif %}
      </div>
    </div>
    <nav class="ai-info-actions-{{ ai_gen_id }}__buttons" aria-label="{{ block.settings.buttons_label | escape }}">
      {% for i in (1..3) %}
        {% assign label_key = 'button_' | append: i | append: '_label' %}
        {% assign link_key = 'button_' | append: i | append: '_link' %}
        {% assign icon_key = 'button_' | append: i | append: '_icon' %}
        {% assign button_label = block.settings[label_key] %}
        {% assign button_link = block.settings[link_key] %}
        {% assign button_icon = block.settings[icon_key] %}
        {% if button_label != blank and button_link != blank %}
          <a class="ai-info-actions-{{ ai_gen_id }}__button" href="{{ button_link }}">
            {% if button_icon != blank %}<img class="ai-info-actions-{{ ai_gen_id }}__button-icon" src="{{ button_icon | image_url: width: 96 }}" alt="" loading="lazy" width="{{ block.settings.icon_size }}" height="{{ block.settings.icon_size }}">{% endif %}
            <span>{{ button_label | escape }}</span>
          </a>
        {% endif %}
      {% endfor %}
    </nav>
  </div>
  </div>
</div>

{% schema %}
{
  "name": "Image and link panel",
  "settings": [
    { "type": "header", "content": "Feature content" },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Find your next ride" },
    { "type": "textarea", "id": "description", "label": "Text", "default": "Explore our range and find the e-bike that fits your lifestyle." },
    { "type": "text", "id": "buttons_label", "label": "Button group label", "default": "Explore more" },
    { "type": "header", "content": "Buttons" },
    { "type": "text", "id": "button_1_label", "label": "Button 1 text", "default": "Shop e-bikes" },
    { "type": "url", "id": "button_1_link", "label": "Button 1 link" },
    { "type": "image_picker", "id": "button_1_icon", "label": "Button 1 icon" },
    { "type": "text", "id": "button_2_label", "label": "Button 2 text", "default": "Book a test ride" },
    { "type": "url", "id": "button_2_link", "label": "Button 2 link" },
    { "type": "image_picker", "id": "button_2_icon", "label": "Button 2 icon" },
    { "type": "text", "id": "button_3_label", "label": "Button 3 text", "default": "Visit our store" },
    { "type": "url", "id": "button_3_link", "label": "Button 3 link" },
    { "type": "image_picker", "id": "button_3_icon", "label": "Button 3 icon" },
    { "type": "header", "content": "Style" },
    { "type": "range", "id": "desktop_width_percent", "label": "Desktop width", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "range", "id": "content_width", "label": "Content max width", "min": 800, "max": 1600, "step": 100, "unit": "px", "default": 1200 },
    { "type": "range", "id": "column_gap", "label": "Column gap", "min": 16, "max": 80, "step": 8, "unit": "px", "default": 40 },
    { "type": "range", "id": "padding", "label": "Desktop padding", "min": 20, "max": 100, "step": 10, "unit": "px", "default": 50 },
    { "type": "range", "id": "mobile_padding", "label": "Mobile padding", "min": 12, "max": 48, "step": 6, "unit": "px", "default": 24 },
    { "type": "range", "id": "heading_size", "label": "Heading size", "min": 20, "max": 52, "step": 2, "unit": "px", "default": 32 },
    { "type": "range", "id": "mobile_heading_size", "label": "Mobile heading size", "min": 18, "max": 36, "step": 2, "unit": "px", "default": 26 },
    { "type": "range", "id": "image_radius", "label": "Image corner radius", "min": 0, "max": 32, "step": 2, "unit": "px", "default": 8 },
    { "type": "range", "id": "button_radius", "label": "Button corner radius", "min": 0, "max": 32, "step": 2, "unit": "px", "default": 6 },
    { "type": "range", "id": "icon_size", "label": "Button icon size", "min": 16, "max": 48, "step": 4, "unit": "px", "default": 24 },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#F8F5F0" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#1B2A4A" },
    { "type": "color", "id": "placeholder_color", "label": "Image placeholder", "default": "#E5E7EB" },
    { "type": "color", "id": "button_color", "label": "Button background", "default": "#1B2A4A" },
    { "type": "color", "id": "button_text_color", "label": "Button text", "default": "#FFFFFF" },
    { "type": "color", "id": "button_hover_color", "label": "Button hover background", "default": "#E86C2C" },
    { "type": "color", "id": "button_hover_text_color", "label": "Button hover text", "default": "#FFFFFF" }
  ],
  "presets": [{ "name": "Image and link panel" }],
  "tag": null,
  "class": "image-link-panel"
}
{% endschema %}