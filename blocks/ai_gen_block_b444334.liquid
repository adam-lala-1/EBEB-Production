{% doc %}
  @prompt
    one more usp section with light background different from home page, and it has 3 usps, left side image and right side heading and a apara and a divider in between  uso, no no, usps only, in 3 cols, each col has left side image and right side text and heading, image size option too, as its it too big now
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-usp-grid-{{ ai_gen_id }} {
    display: block;
    box-sizing: border-box;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: {{ block.settings.padding }}px;
    background: {{ block.settings.background_color }};
    color: {{ block.settings.text_color }};
  }

  .ai-usp-grid-{{ ai_gen_id }}__inner {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
    
    margin: 0 auto;
  }

  .ai-usp-grid-{{ ai_gen_id }}__item {
    display: grid;
    grid-template-columns: minmax(48px, {{ block.settings.image_width }}px) minmax(0, 1fr);
    gap: 16px;
    align-items: center;
    min-width: 0;
    padding-right: 24px;
    border-right: 1px solid {{ block.settings.divider_color }};
  }

  .ai-usp-grid-{{ ai_gen_id }}__item:last-child {
    padding-right: 0;
    border-right: 0;
  }

  .ai-usp-grid-{{ ai_gen_id }}__media {
    width: 100%;
    max-width: {{ block.settings.image_width }}px;
    overflow: hidden;
    border-radius: {{ block.settings.image_radius }}px;
  }

  .ai-usp-grid-{{ ai_gen_id }}__media img,
  .ai-usp-grid-{{ ai_gen_id }}__placeholder svg {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    object-fit: cover;
  }

  .ai-usp-grid-{{ ai_gen_id }}__placeholder {
    position: relative;
    background: #e9e7e3;
  }

  .ai-usp-grid-{{ ai_gen_id }}__placeholder svg {
    color: #777;
  }

  .ai-usp-grid-{{ ai_gen_id }}__empty {
    position: absolute;
    inset: auto 5px 5px;
    padding: 5px;
    background: rgba(255, 255, 255, 0.94);
    color: #333;
    font-size: 10px;
    line-height: 1.3;
    text-align: center;
  }

  .ai-usp-grid-{{ ai_gen_id }}__content { min-width: 0; }

  .ai-usp-grid-{{ ai_gen_id }}__title {
    margin: 0 0 7px;
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.title_size }}px;
    line-height: 1.25;
    font-weight: 700;
  }

  .ai-usp-grid-{{ ai_gen_id }}__text {
    color: {{ block.settings.text_color }};
    font-size: 14px;
    line-height: 1.55;
  }

  .ai-usp-grid-{{ ai_gen_id }}__text p { margin: 0; }

  @media screen and (max-width: 749px) {
    .ai-usp-grid-{{ ai_gen_id }} { padding: 28px 20px; }
    .ai-usp-grid-{{ ai_gen_id }}__inner { grid-template-columns: 1fr; gap: 18px; }
    .ai-usp-grid-{{ ai_gen_id }}__item {
      grid-template-columns: minmax(48px, {{ block.settings.image_width }}px) minmax(0, 1fr);
      padding: 0 0 18px;
      border-right: 0;
      border-bottom: 1px solid {{ block.settings.divider_color }};
    }
    .ai-usp-grid-{{ ai_gen_id }}__item:last-child { padding-bottom: 0; border-bottom: 0; }
  }
{% endstyle %}

<div class="ai-usp-grid-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
<div class="eeb-container">
  <div class="ai-usp-grid-{{ ai_gen_id }}__inner">
    {% for i in (1..3) %}
      {% liquid
        assign image_key = 'usp_' | append: i | append: '_image'
        assign title_key = 'usp_' | append: i | append: '_title'
        assign text_key = 'usp_' | append: i | append: '_text'
        assign usp_image = block.settings[image_key]
        assign usp_title = block.settings[title_key]
        assign usp_text = block.settings[text_key]
      %}
      <article class="ai-usp-grid-{{ ai_gen_id }}__item">
        <div class="ai-usp-grid-{{ ai_gen_id }}__media">
          {% if usp_image != blank %}
            <img src="{{ usp_image | image_url: width: 500 }}" alt="{{ usp_image.alt | escape }}" loading="lazy" width="{{ usp_image.width }}" height="{{ usp_image.height }}">
          {% else %}
            <div class="ai-usp-grid-{{ ai_gen_id }}__placeholder">
              {{ 'image' | placeholder_svg_tag }}
              <div class="ai-usp-grid-{{ ai_gen_id }}__empty">Add image {{ i }}</div>
            </div>
          {% endif %}
        </div>
        <div class="ai-usp-grid-{{ ai_gen_id }}__content">
          {% if usp_title != blank %}<h2 class="ai-usp-grid-{{ ai_gen_id }}__title">{{ usp_title | escape }}</h2>{% endif %}
          {% if usp_text != blank %}<div class="ai-usp-grid-{{ ai_gen_id }}__text">{{ usp_text }}</div>{% endif %}
        </div>
      </article>
    {% endfor %}
  </div>
  </div>
</div>

{% schema %}
{
  "name": "Three image USPs",
  "settings": [
    { "type": "image_picker", "id": "usp_1_image", "label": "USP 1 image" },
    { "type": "text", "id": "usp_1_title", "label": "USP 1 heading", "default": "Made for every ride" },
    { "type": "richtext", "id": "usp_1_text", "label": "USP 1 text", "default": "<p>Comfortable, dependable rides for everyday adventures.</p>" },
    { "type": "image_picker", "id": "usp_2_image", "label": "USP 2 image" },
    { "type": "text", "id": "usp_2_title", "label": "USP 2 heading", "default": "Expert help, close to home" },
    { "type": "richtext", "id": "usp_2_text", "label": "USP 2 text", "default": "<p>Get help choosing the right eBike from our knowledgeable team.</p>" },
    { "type": "image_picker", "id": "usp_3_image", "label": "USP 3 image" },
    { "type": "text", "id": "usp_3_title", "label": "USP 3 heading", "default": "Support after you ride away" },
    { "type": "richtext", "id": "usp_3_text", "label": "USP 3 text", "default": "<p>Count on ongoing care and guidance throughout your eBike journey.</p>" },
    { "type": "header", "content": "Appearance" },
    { "type": "range", "id": "desktop_width_percent", "label": "Desktop width", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "range", "id": "padding", "label": "Section padding", "min": 20, "max": 80, "step": 5, "unit": "px", "default": 40 },
    { "type": "range", "id": "image_width", "label": "Image width", "min": 48, "max": 120, "step": 8, "unit": "px", "default": 64 },
    { "type": "range", "id": "title_size", "label": "Heading size", "min": 16, "max": 28, "step": 2, "unit": "px", "default": 20 },
    { "type": "range", "id": "image_radius", "label": "Image corner radius", "min": 0, "max": 30, "step": 2, "unit": "px", "default": 8 },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#F8F5F0" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#1B2A4A" },
    { "type": "color", "id": "divider_color", "label": "Divider", "default": "#D9D5CF" }
  ],
  "presets": [{ "name": "Three image USPs" }],
  "tag": null,
  "class": "three-image-usp-block"
}
{% endschema %}