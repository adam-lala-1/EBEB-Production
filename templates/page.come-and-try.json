    "faq": {
      "type": "come-try-faq",
      "blocks": {
        "f1": {
          "type": "faq",
          "settings": {
            "question": "Do I need to book?",
            "answer": "Events can be drop-in or RSVP — check the event details. For a Gaythorne workshop visit, RSVP so we can have the right bike ready."
          }
        },
        "f2": {
          "type": "faq",
          "settings": {
            "question": "What should I bring?",
            "answer": "Flat shoes, a water bottle, and your ID for test rides. Helmets are provided. If you'd like to test with your own gear (e.g. orthotic, support cushion), feel free to bring it."
          }
        },
        "f3": {
          "type": "faq",
          "settings": {
            "question": "Is it suitable for first-time or nervous riders?",
            "answer": "Absolutely. Our team specialises in supporting riders of every ability. Trikes are very stable and a great place to start, and the complex outside our shop is quiet enough for true beginners."
          }
        },
        "f4": {
          "type": "faq",
          "settings": {
            "question": "Can I bring a support worker or OT?",
            "answer": "Yes — we love working with OTs, physios, and support workers. Let us know in your enquiry and we'll allocate extra time."
          }
        },
        "f5": {
          "type": "faq",
          "settings": {
            "question": "What if it rains?",
            "answer": "Our Gaythorne workshop has an undercover ride zone. For events we'll email you the day before with weather updates."
          }
        }
      },
