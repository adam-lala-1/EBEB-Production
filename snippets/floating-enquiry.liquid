{%- comment -%}
  Floating enquiry widget — appears on every page.
  Auto-detects page context (product, collection, page) and prefills enquiry topic.
  Submits through Shopify's native {% form 'contact' %} so it follows the same
  delivery flow as every other contact form on the site.
{%- endcomment -%}

{%- liquid
  assign topic = 'General enquiry'
  assign label = 'EveryBody eBikes'
  case template.name
    when 'product'
      assign topic = product.title | append: ' enquiry'
      assign label = product.title
    when 'collection'
      assign topic = 'Collection: ' | append: collection.title
      assign label = collection.title
    when 'page'
      if page.handle == 'come-and-try'
        assign topic = 'Come & Try / Test Ride'
        assign label = 'a test ride'
      elsif page.handle == 'dealers'
        assign topic = 'Dealer enquiry'
        assign label = 'becoming a dealer'
      elsif page.handle == 'servicing'
        assign topic = 'Servicing & Repairs'
        assign label = 'servicing'
      else
        assign topic = page.title | append: ' enquiry'
        assign label = page.title
      endif
  endcase
-%}

<link rel="stylesheet" href="https://assets.calendly.com/assets/external/widget.css">
<script src="https://assets.calendly.com/assets/external/widget.js" async></script>

<div id="eeb-floating-enquiry"
  data-topic="{{ topic | escape }}"
  data-label="{{ label | escape }}"
  data-calendly="https://calendly.com/bfebikes-sales/test-ride">
  <button type="button" class="eeb-fe-trigger" aria-label="Open enquiry form">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
    <span class="eeb-fe-trigger-label">Enquire</span>
  </button>

  <div class="eeb-fe-panel" hidden>
    <div class="eeb-fe-header">
      <div>
        <p class="eeb-fe-kicker">Quick Enquiry</p>
        <h3 class="eeb-fe-title">Ask us about {{ label }}</h3>
      </div>
      <button type="button" class="eeb-fe-close" aria-label="Close">×</button>
    </div>
    <div class="eeb-fe-body">
      {%- form 'contact', id: 'eeb-floating-contact', class: 'eeb-fe-form' -%}
        {%- if form.posted_successfully? -%}
          <div class="eeb-fe-success">
            <p class="eeb-fe-success-title">Thanks!</p>
            <p class="eeb-fe-success-text">We've received your enquiry and will be in touch shortly.</p>
          </div>
        {%- else -%}
          {%- if form.errors -%}
            <div class="eeb-fe-errors">{{ form.errors | default_errors }}</div>
          {%- endif -%}

          <label class="eeb-fe-label" for="eeb-fe-topic">Enquiring about</label>
          <div class="eeb-fe-topic-wrap">
            <input class="eeb-fe-input eeb-fe-topic-input" id="eeb-fe-topic" name="contact[topic]" type="text" maxlength="120" required placeholder="What's it about?" autocomplete="off">
            <button type="button" class="eeb-fe-topic-toggle" aria-label="Show suggestions">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
            </button>
            <ul class="eeb-fe-topic-list" hidden>
              <li><button type="button" data-value="Trident Trike">Trident Trike</button></li>
              <li><button type="button" data-value="Lightning eBike">Lightning eBike</button></li>
              <li><button type="button" data-value="Trojan eBike">Trojan eBike</button></li>
              <li><button type="button" data-value="General product enquiry">General product enquiry</button></li>
              <li><button type="button" data-value="Come & Try / Test Ride">Come & Try / Test Ride</button></li>
              <li><button type="button" data-value="Servicing & Repairs">Servicing & Repairs</button></li>
              <li><button type="button" data-value="Dealer enquiry">Dealer enquiry</button></li>
              <li><button type="button" data-value="Spare parts / Accessories">Spare parts / Accessories</button></li>
            </ul>
          </div>

          {%- comment -%} Shopify uses contact[subject] for the email subject line {%- endcomment -%}
          <input type="hidden" name="contact[subject]" class="eeb-fe-subject" value="Floating enquiry">

          <div class="eeb-fe-row">
            <div>
              <label class="eeb-fe-label">Name</label>
              <input class="eeb-fe-input" name="contact[name]" type="text" required maxlength="100" autocomplete="name">
            </div>
            <div>
              <label class="eeb-fe-label">Phone</label>
              <input class="eeb-fe-input" name="contact[phone]" type="tel" maxlength="30" autocomplete="tel">
            </div>
          </div>

          <label class="eeb-fe-label">Email</label>
          <input class="eeb-fe-input" name="contact[email]" type="email" required maxlength="255" autocomplete="email">

          <label class="eeb-fe-label">Message</label>
          <textarea class="eeb-fe-input eeb-fe-message" name="contact[body]" rows="3" required maxlength="1000" placeholder="I'd like to know more about {{ label }}…"></textarea>

          <input type="hidden" name="contact[page_url]" class="eeb-fe-page-url" value="">

          <label class="eeb-fe-marketing-label">
            <input type="checkbox" name="contact[marketing_consent]" class="eeb-fe-marketing" value="yes">
            <span>{{ marketing_label | default: "Yes, keep me posted — about special deals, stories and more. No spam, unsubscribe anytime." }}</span>
          </label>

          <button type="submit" class="eeb-fe-btn eeb-fe-btn-primary">Send enquiry</button>
          <div class="eeb-fe-divider"><span>or</span></div>
          <button type="button" class="eeb-fe-btn eeb-fe-btn-outline eeb-fe-calendly">Book a test ride</button>
        {%- endif -%}
      {%- endform -%}

      {%- form 'customer', id: 'eeb-floating-newsletter', class: 'eeb-fe-newsletter' -%}
        <input type="email" name="contact[email]" class="eeb-fe-newsletter-email" value="">
        <input type="hidden" name="contact[tags]" value="source: floating-enquiry">
      {%- endform -%}
      <iframe name="eeb-floating-newsletter-iframe" style="display:none;"></iframe>
    </div>
  </div>
</div>

<style>
  #eeb-floating-enquiry { position: fixed; bottom: 20px; right: 20px; z-index: 9999; font-family: var(--font-body, Inter, sans-serif); }
  .eeb-fe-trigger { display: inline-flex; align-items: center; gap: 8px; background: var(--color-orange, #E86C2C); color: #fff; border: 0; border-radius: 999px; padding: 12px 20px; font-weight: 600; font-size: 14px; box-shadow: 0 12px 30px rgba(0,0,0,.18); cursor: pointer; }
  .eeb-fe-trigger:hover { filter: brightness(0.95); }
  @media (max-width: 480px) { .eeb-fe-trigger-label { display: none; } }
  .eeb-fe-panel { width: min(380px, calc(100vw - 40px)); background: #fff; border: 1px solid var(--color-border, #E5E7EB); border-radius: 16px; overflow: hidden; box-shadow: 0 20px 50px rgba(0,0,0,.2); }
  .eeb-fe-header { background: var(--color-navy, #1B2A4A); color: #fff; padding: 16px 20px; display: flex; justify-content: space-between; align-items: flex-start; gap: 12px; }
  .eeb-fe-kicker { margin: 0 0 4px; font-size: 11px; letter-spacing: .14em; text-transform: uppercase; color: var(--color-orange, #E86C2C); font-weight: 700; }
  .eeb-fe-title { margin: 0; font-family: var(--font-heading, serif); font-size: 18px; font-weight: 400; line-height: 1.3; }
  .eeb-fe-close { background: transparent; border: 0; color: rgba(255,255,255,.7); font-size: 24px; line-height: 1; cursor: pointer; padding: 0 4px; }
  .eeb-fe-close:hover { color: #fff; }
  .eeb-fe-body { padding: 18px 20px; }
  .eeb-fe-form { display: flex; flex-direction: column; gap: 10px; }
  .eeb-fe-label { font-size: 11px; font-weight: 600; color: var(--color-foreground, #1B2A4A); }
  .eeb-fe-input { width: 100%; padding: 8px 10px; border: 1px solid var(--color-border, #E5E7EB); border-radius: 6px; font-size: 14px; font-family: inherit; }
  .eeb-fe-errors { background: #FEE; border: 1px solid #FCC; color: #900; padding: 8px 10px; border-radius: 6px; font-size: 13px; }
  .eeb-fe-topic-wrap { position: relative; }
  .eeb-fe-topic-input { padding-right: 32px; }
  .eeb-fe-topic-toggle { position: absolute; top: 0; right: 0; height: 100%; width: 32px; background: transparent; border: 0; color: var(--color-muted, #6B7280); cursor: pointer; display: flex; align-items: center; justify-content: center; }
  .eeb-fe-topic-toggle:hover { color: var(--color-foreground, #1B2A4A); }
  .eeb-fe-topic-list { position: absolute; top: 100%; left: 0; right: 0; margin: 4px 0 0; padding: 4px 0; list-style: none; background: #fff; border: 1px solid var(--color-border, #E5E7EB); border-radius: 6px; box-shadow: 0 8px 20px rgba(0,0,0,.12); max-height: 220px; overflow: auto; z-index: 5; }
  .eeb-fe-topic-list li button { width: 100%; text-align: left; background: transparent; border: 0; padding: 6px 12px; font-size: 14px; font-family: inherit; cursor: pointer; color: var(--color-foreground, #1B2A4A); }
  .eeb-fe-topic-list li button:hover { background: #F4F4F6; }
  .eeb-fe-row { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
  .eeb-fe-btn { width: 100%; padding: 10px; border-radius: 8px; font-weight: 600; font-size: 14px; cursor: pointer; border: 1px solid transparent; }
  .eeb-fe-btn-primary { background: var(--color-orange, #E86C2C); color: #fff; }
  .eeb-fe-btn-outline { background: #fff; border-color: var(--color-border, #E5E7EB); color: var(--color-navy, #1B2A4A); }
  .eeb-fe-divider { position: relative; text-align: center; margin: 4px 0; }
  .eeb-fe-divider::before { content: ""; position: absolute; top: 50%; left: 0; right: 0; border-top: 1px solid var(--color-border, #E5E7EB); }
  .eeb-fe-divider span { position: relative; background: #fff; padding: 0 8px; font-size: 11px; color: var(--color-muted, #6B7280); }
  .eeb-fe-success { text-align: center; padding: 16px 0; }
  .eeb-fe-success-title { font-family: var(--font-heading, serif); font-size: 20px; color: var(--color-navy, #1B2A4A); margin: 0 0 4px; }
  .eeb-fe-success-text { font-size: 14px; color: var(--color-muted, #6B7280); margin: 0; }
  .eeb-fe-marketing-label { display: flex; align-items: flex-start; gap: 8px; font-size: 12px; line-height: 1.4; color: var(--color-muted, #6B7280); cursor: pointer; margin: 2px 0; }
  .eeb-fe-marketing-label input { margin-top: 2px; flex-shrink: 0; }
  .eeb-fe-newsletter { display: none; }
</style>

<script>
  (function () {
    var root = document.getElementById('eeb-floating-enquiry');
    if (!root) return;
    var trigger = root.querySelector('.eeb-fe-trigger');
    var panel = root.querySelector('.eeb-fe-panel');
    var closeBtn = root.querySelector('.eeb-fe-close');
    var form = root.querySelector('.eeb-fe-form');
    var calendlyBtn = root.querySelector('.eeb-fe-calendly');
    var topicInput = root.querySelector('.eeb-fe-topic-input');
    var topicToggle = root.querySelector('.eeb-fe-topic-toggle');
    var topicList = root.querySelector('.eeb-fe-topic-list');
    var subjectInput = root.querySelector('.eeb-fe-subject');
    var pageUrlInput = root.querySelector('.eeb-fe-page-url');
    var messageInput = root.querySelector('.eeb-fe-message');
    var detectedTopic = root.dataset.topic;
    var calendlyUrl = root.dataset.calendly;
    var marketingCheckbox = form ? form.querySelector('.eeb-fe-marketing') : null;
    var newsletterForm = document.getElementById('eeb-floating-newsletter');
    var newsletterEmail = newsletterForm ? newsletterForm.querySelector('.eeb-fe-newsletter-email') : null;
    var newsletterIframe = document.querySelector('iframe[name="eeb-floating-newsletter-iframe"]');

    function setOpen(open) {
      panel.hidden = !open;
      trigger.hidden = open;
    }
    trigger.addEventListener('click', function () { setOpen(true); });
    closeBtn.addEventListener('click', function () { setOpen(false); });

    // Auto-open panel after submit redirect (success or error)
    if (window.location.hash === '#ContactForm-eeb-floating-contact' ||
        window.location.search.indexOf('contact_posted=true') !== -1 ||
        document.querySelector('.eeb-fe-success') ||
        document.querySelector('.eeb-fe-errors')) {
      setOpen(true);
    }

    if (topicInput) {
      topicInput.value = detectedTopic || '';

      function setListOpen(open) { topicList.hidden = !open; }
      topicToggle.addEventListener('click', function () { setListOpen(topicList.hidden); });
      topicInput.addEventListener('focus', function () { setListOpen(true); });
      topicList.addEventListener('click', function (e) {
        var btn = e.target.closest('button[data-value]');
        if (!btn) return;
        topicInput.value = btn.getAttribute('data-value');
        setListOpen(false);
        topicInput.focus();
      });
      document.addEventListener('mousedown', function (e) {
        if (!root.contains(e.target)) setListOpen(false);
        else if (!topicList.contains(e.target) && e.target !== topicToggle && e.target !== topicInput) setListOpen(false);
      });
    }

    if (calendlyBtn) {
      calendlyBtn.addEventListener('click', function () {
        var nameField = form.querySelector('[name="contact[name]"]');
        var emailField = form.querySelector('[name="contact[email]"]');
        var name = nameField ? nameField.value : '';
        var em = emailField ? emailField.value : '';
        if (window.Calendly && window.Calendly.initPopupWidget) {
          window.Calendly.initPopupWidget({ url: calendlyUrl, prefill: { name: name, email: em } });
        } else {
          window.open(calendlyUrl, '_blank', 'noopener,noreferrer');
        }
      });
    }

    if (form) {
      form.addEventListener('submit', function (e) {
        if (pageUrlInput) pageUrlInput.value = window.location.href;
        var topicVal = (topicInput && topicInput.value || '').trim() || 'General enquiry';
        if (subjectInput) subjectInput.value = 'Floating enquiry: ' + topicVal;
        // Append page context + marketing consent to message body
        if (messageInput) {
          var existing = messageInput.value || '';
          var consentLine = 'Marketing consent: ' + (marketingCheckbox && marketingCheckbox.checked ? 'YES' : 'NO');
          var footer = '\n\n— Sent via floating enquiry\nTopic: ' + topicVal + '\n' + consentLine + '\nPage: ' + window.location.href;
          if (existing.indexOf('Sent via floating enquiry') === -1) {
            messageInput.value = existing + footer;
          } else if (existing.indexOf('Marketing consent:') === -1) {
            messageInput.value = existing + '\n' + consentLine;
          }
        }

        // Auto-subscribe to Shopify marketing list if consent given
        if (marketingCheckbox && marketingCheckbox.checked && newsletterForm && newsletterEmail && newsletterIframe) {
          var emailField = form.querySelector('[name="contact[email]"]');
          if (emailField) newsletterEmail.value = emailField.value;
          e.preventDefault();
          newsletterForm.target = 'eeb-floating-newsletter-iframe';
          var submitted = false;
          var onLoad = function onFloatingNewsletterLoad() {
            if (submitted) return;
            submitted = true;
            newsletterIframe.removeEventListener('load', onFloatingNewsletterLoad);
            form.submit();
          };
          newsletterIframe.addEventListener('load', onLoad);
          newsletterForm.submit();
          setTimeout(function () {
            if (!submitted) {
              submitted = true;
              form.submit();
            }
          }, 2500);
        }
      });
    }

    // External open API — other sections dispatch eeb:enquiry:open to pre-fill + open.
    window.addEventListener('eeb:enquiry:open', function (e) {
      var detail = (e && e.detail) || {};
      setOpen(true);
      if (topicInput && detail.topic) topicInput.value = detail.topic;
      if (messageInput) {
        var parts = [];
        if (detail.product) parts.push('Product: ' + detail.product);
        if (detail.variant) parts.push('Variant: ' + detail.variant);
        if (parts.length) {
          var prefix = parts.join(' — ') + '\n\n';
          var current = messageInput.value || '';
          if (current.indexOf('Product:') === -1) messageInput.value = prefix + current;
        }
        try { messageInput.focus(); } catch (err) {}
      }
    });
  })();
</script>
