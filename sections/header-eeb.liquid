<div class="eeb-topbar{% if section.settings.sale_enabled %} eeb-topbar--with-sale{% endif %}">
  <div class="eeb-topbar__inner">
    <a class="eeb-topbar__addr" href="https://www.google.com/maps/place/EveryBody+eBikes/@-27.4140661,152.9819054,17z/data=!3m1!4b1!4m6!3m5!1s0x6b93fc6b78ff5a35:0x5f92d04e3b321f07!8m2!3d-27.4140661!4d152.9819054!16s%2Fg%2F119vhl73x" target="_blank" rel="noopener">📍 Unit 6/51 Prospect Rd, Gaythorne QLD 4051</a>

    {%- if section.settings.sale_enabled -%}
      <div class="eeb-topbar__sale">
        <a class="eeb-sale-badge" href="{{ section.settings.sale_url | default: '/collections/on-sale' }}"
           style="background: {{ section.settings.sale_bg_color }}; color: {{ section.settings.sale_text_color }};">
          {{ section.settings.sale_label }}
        </a>
      </div>
    {%- endif -%}

    <div class="eeb-topbar__contact">
      <a href="tel:+61409126669">📞 0409 126 669</a>
      <span aria-hidden="true">•</span>
      <a href="mailto:enquiry@everybodyebikes.com.au">✉ enquiry@everybodyebikes.com.au</a>
    </div>
  </div>
</div>


<header class="eeb-header">
  <div class="eeb-header__inner">
    <a href="{{ routes.root_url }}" class="eeb-header__logo">
      {% assign header_logo = section.settings.logo | default: settings.logo %}
      {% assign header_logo_width = section.settings.logo_width | default: settings.logo_width | default: 140 %}
      {% if header_logo != blank %}
        <img src="{{ header_logo | image_url: width: 280 }}" width="{{ header_logo.width }}" height="{{ header_logo.height }}" alt="{{ shop.name }}" style="max-width: {{ header_logo_width }}px;">
      {% else %}
        <strong style="font-family: var(--font-heading); font-size: 1.5rem;">{{ shop.name }}</strong>
      {% endif %}
    </a>

    <button class="eeb-header__burger" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="eeb-mobile-nav">
      <span></span><span></span><span></span>
    </button>



    <nav class="eeb-header__nav" id="eeb-mobile-nav" aria-label="Primary">
      {%- if section.settings.menu != blank and section.settings.menu.links.size > 0 -%}
        {%- for link in section.settings.menu.links -%}
          {%- if link.links.size > 0 -%}
            <div class="eeb-nav__item eeb-nav__item--has-dropdown">
              <button class="eeb-nav__toggle" aria-expanded="false" aria-haspopup="true">
                {{ link.title }}
                <svg width="10" height="6" viewBox="0 0 10 6" fill="none" aria-hidden="true"><path d="M1 1l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </button>
              <ul class="eeb-nav__dropdown" role="list">
                {%- for child_link in link.links -%}
                  <li><a href="{{ child_link.url }}">{{ child_link.title }}</a></li>
                {%- endfor -%}
              </ul>
            </div>
          {%- else -%}
            <div class="eeb-nav__item">
              <a href="{{ link.url }}">{{ link.title }}</a>
            </div>
          {%- endif -%}
        {%- endfor -%}
      {%- endif -%}

      {%- if section.settings.dealer_label != blank -%}
        <div class="eeb-nav__item eeb-nav__item--highlight">
          <a href="{{ section.settings.dealer_url | default: '/pages/distributor-list' }}" style="color: {{ section.settings.dealer_color }}; font-weight: 700;">
            {{ section.settings.dealer_label }}
          </a>
        </div>
      {%- endif -%}
    </nav>

    <div class="eeb-header__actions">
      <button type="button" class="eeb-header__search-toggle eeb-header__iconbtn" aria-label="Search" aria-expanded="false" aria-controls="eeb-header-search">
        <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true" focusable="false"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/></svg>
      </button>
      <a href="{{ routes.cart_url }}" class="eeb-header__iconbtn" aria-label="Cart">
        {% render 'icon', icon: 'cart', size: 22 %}
      </a>
      {% if section.settings.cta_text != blank %}
        <a href="{{ section.settings.cta_url | default: '/pages/come-and-try' }}" class="eeb-btn eeb-btn--primary eeb-header__cta">{{ section.settings.cta_text }}</a>
      {% endif %}
    </div>

  </div>
  <div class="eeb-header__search" id="eeb-header-search" hidden>
    <form action="{{ routes.search_url }}" method="get" role="search" class="eeb-header__search-form">
      <input type="hidden" name="type" value="product,page,article">
      <input type="hidden" name="options[prefix]" value="last">
      <label for="HeaderSearchInput" class="visually-hidden" style="position:absolute;left:-9999px;">Search</label>
      <input id="HeaderSearchInput" type="search" name="q" placeholder="Search bikes, gear, articles…" autocomplete="off">
      <button type="submit" class="eeb-btn eeb-btn--dark">Search</button>
    </form>
  </div>
</header>

{% stylesheet %}
.eeb-topbar__inner {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 1rem;
  flex-wrap: wrap;
  padding: 0.375rem 1.25rem;
  font-size: 0.8rem;
}
.eeb-topbar__inner a { color: inherit; text-decoration: none; }
.eeb-topbar__inner a:hover { color: var(--color-orange, #E86C2C); }
.eeb-topbar__contact { display: inline-flex; gap: 0.5rem; align-items: center; flex-wrap: wrap; justify-content: center; }
.eeb-topbar--with-sale .eeb-topbar__inner {
  display: grid;
  grid-template-columns: 1fr auto 1fr;
  justify-content: stretch;
  gap: 1rem;
}
.eeb-topbar--with-sale .eeb-topbar__addr { justify-self: start; }
.eeb-topbar--with-sale .eeb-topbar__sale { justify-self: center; }
.eeb-topbar--with-sale .eeb-topbar__contact { justify-self: end; }
.eeb-sale-badge {
  display: inline-flex;
  align-items: center;
  gap: .35rem;
  padding: .3rem .8rem;
  border-radius: 999px;
  font-weight: 800;
  font-size: .72rem;
  letter-spacing: .08em;
  text-transform: uppercase;
  line-height: 1;
  box-shadow: 0 2px 8px rgba(0,0,0,.15);
  animation: eeb-sale-pulse 1.6s ease-in-out infinite;
  will-change: transform, box-shadow;
  text-decoration: none !important;
}
.eeb-sale-badge:hover { filter: brightness(1.1); }
@keyframes eeb-sale-pulse {
  0%, 100% { transform: scale(1); box-shadow: 0 0 0 0 rgba(232,108,44,.55); }
  50% { transform: scale(1.06); box-shadow: 0 0 18px 4px rgba(232,108,44,.55); }
}
@media (prefers-reduced-motion: reduce) { .eeb-sale-badge { animation: none; } }
@media (max-width: 720px) {
  .eeb-topbar--with-sale .eeb-topbar__inner {
    grid-template-columns: 1fr;
  }
  .eeb-topbar--with-sale .eeb-topbar__addr,
  .eeb-topbar--with-sale .eeb-topbar__sale,
  .eeb-topbar--with-sale .eeb-topbar__contact { justify-self: center; text-align: center; }
  .eeb-topbar--with-sale .eeb-topbar__sale { order: -1; }
}
.eeb-header { overflow-x: clip; }
.eeb-header__inner {
  display: flex;
  flex-wrap: nowrap;
  align-items: center;
  gap: .5rem;
}
.eeb-header__logo { flex: 0 1 auto; min-width: 0; }
.eeb-header__logo img { max-width: 40vw; }
.eeb-header__actions {
  display: flex;
  align-items: center;
  gap: .25rem;
  flex: 0 0 auto;
  margin-left: auto;
  color: var(--color-navy, #1B2A4A);
}
.eeb-header__iconbtn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  width: 40px;
  height: 40px;
  padding: 0;
  background: none;
  border: none;
  cursor: pointer;
  color: var(--color-navy, #1B2A4A);
}
.eeb-header__iconbtn svg { display: block; width: 22px; height: 22px; fill: none; stroke: currentColor; }
.eeb-header__iconbtn:hover { color: var(--color-orange, #E86C2C); }
.eeb-header__cta {
  padding: .5rem 1rem;
  font-size: .85rem;
  white-space: nowrap;
  flex: 0 1 auto;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
}
.eeb-header__search {
  border-top: 1px solid #e5e5e5;
  background: #fff;
  padding: 0.75rem 1.25rem;
}
.eeb-header__search-form {
  display: flex;
  gap: 0.5rem;
  max-width: 720px;
  margin: 0 auto;
}
.eeb-header__search-form input[type="search"] {
  flex: 1;
  min-width: 0;
  padding: 0.6rem 0.9rem;
  border: 1px solid #e5e5e5;
  border-radius: 6px;
  font: inherit;
}

.eeb-header__nav {
  display: flex;
  align-items: center;
  gap: 0;
  flex: 1 1 auto;
  min-width: 0;
  overflow: hidden;
}


.eeb-nav__item {
  position: relative;
}

.eeb-nav__item > a,
.eeb-nav__toggle {
  display: flex;
  align-items: center;
  gap: 4px;
  padding: 0.5rem 0.75rem;
  background: none;
  border: none;
  cursor: pointer;
  font-family: inherit;
  font-size: 0.85rem;
  color: inherit;
  text-decoration: none;
  white-space: nowrap;
}


.eeb-nav__item--highlight > a {
  border-left: 1px solid #e5e5e5;
  margin-left: 0.5rem;
  padding-left: 1rem;
}

.eeb-nav__toggle svg {
  transition: transform 0.2s ease;
}

.eeb-nav__item--has-dropdown:hover .eeb-nav__toggle svg,
.eeb-nav__item--has-dropdown.is-open .eeb-nav__toggle svg {
  transform: rotate(180deg);
}

.eeb-nav__dropdown {
  display: none;
  position: absolute;
  top: 100%;
  left: 0;
  min-width: 200px;
  background: #fff;
  border: 1px solid #e5e5e5;
  border-radius: 4px;
  box-shadow: 0 4px 16px rgba(0,0,0,0.10);
  list-style: none;
  margin: 0;
  padding: 0.5rem 0;
  z-index: 100;
}

.eeb-nav__item--has-dropdown:hover .eeb-nav__dropdown,
.eeb-nav__item--has-dropdown.is-open .eeb-nav__dropdown {
  display: block;
}

.eeb-nav__dropdown li a {
  display: block;
  padding: 0.5rem 1.25rem;
  color: inherit;
  text-decoration: none;
  white-space: nowrap;
}

.eeb-nav__dropdown li a:hover {
  background: #f5f5f5;
}

.eeb-header__burger {
  display: none;
  flex-direction: column;
  justify-content: center;
  gap: 5px;
  width: 40px;
  height: 40px;
  padding: 8px;
  background: none;
  border: none;
  cursor: pointer;
  flex: 0 0 auto;
  order: 3;
  color: var(--color-navy, #1B2A4A);
}
.eeb-header__burger span {
  display: block;
  width: 100%;
  height: 2px;
  background: currentColor;
  transition: transform 0.25s ease, opacity 0.2s ease;
}
.eeb-header__burger[aria-expanded="true"] span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
.eeb-header__burger[aria-expanded="true"] span:nth-child(2) { opacity: 0; }
.eeb-header__burger[aria-expanded="true"] span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

/* Narrow the CTA before the icons ever get pushed off screen */
@media (max-width: 1180px) {
  .eeb-header__cta { padding: .5rem .75rem; font-size: .8rem; }
}

@media (max-width: 1023px) {
  .eeb-header__logo { order: 1; }
  .eeb-header__actions { order: 2; }
  .eeb-header__burger { display: flex; }
  .eeb-header__cta { display: none; }

  .eeb-header__nav {
    display: none;
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    flex-direction: column;
    align-items: stretch;
    overflow: visible;
    background: #fff;
    border-top: 1px solid #e5e5e5;
    box-shadow: 0 8px 20px rgba(0,0,0,0.08);
    padding: 0.5rem 0;
    z-index: 99;
  }
  .eeb-header__nav.is-open { display: flex; }

  .eeb-nav__item { width: 100%; }
  .eeb-nav__item > a,
  .eeb-nav__toggle {
    width: 100%;
    justify-content: space-between;
    padding: 0.85rem 1.25rem;
  }
  .eeb-nav__item--highlight > a {
    border-left: none;
    border-top: 1px solid #e5e5e5;
    margin-left: 0;
    padding-left: 1.25rem;
    margin-top: 0.25rem;
  }

  .eeb-nav__dropdown {
    position: static;
    box-shadow: none;
    border: none;
    border-radius: 0;
    padding: 0 0 0.25rem 1rem;
  }
}

{% endstylesheet %}

{% javascript %}
(function() {
  var btn = document.querySelector('.eeb-header__search-toggle');
  var panel = document.getElementById('eeb-header-search');
  if (btn && panel) {
    btn.addEventListener('click', function() {
      var open = panel.hasAttribute('hidden');
      if (open) {
        panel.removeAttribute('hidden');
        btn.setAttribute('aria-expanded', 'true');
        var input = panel.querySelector('input[type="search"]');
        if (input) input.focus();
      } else {
        panel.setAttribute('hidden', '');
        btn.setAttribute('aria-expanded', 'false');
      }
    });
  }
})();

document.querySelectorAll('.eeb-nav__item--has-dropdown').forEach(function(item) {
  var toggle = item.querySelector('.eeb-nav__toggle');
  toggle.addEventListener('click', function() {
    var isOpen = item.classList.toggle('is-open');
    toggle.setAttribute('aria-expanded', isOpen);
  });
  document.addEventListener('click', function(e) {
    if (!item.contains(e.target)) {
      item.classList.remove('is-open');
      toggle.setAttribute('aria-expanded', 'false');
    }
  });
});

(function() {
  var burger = document.querySelector('.eeb-header__burger');
  var nav = document.getElementById('eeb-mobile-nav');
  if (!burger || !nav) return;
  burger.addEventListener('click', function() {
    var open = nav.classList.toggle('is-open');
    burger.setAttribute('aria-expanded', open);
    burger.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
  });
})();
{% endjavascript %}

{% render 'floating-enquiry', marketing_label: section.settings.marketing_consent_label %}

{% schema %}
{
  "name": "EEB Header",
  "tag": "section",
  "class": "shopify-section-header-eeb",
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "Logo override (optional)" },
    { "type": "range", "id": "logo_width", "min": 60, "max": 240, "step": 10, "unit": "px", "label": "Logo width override", "default": 140 },
    { "type": "text", "id": "top_bar_text", "label": "Top contact bar text", "default": "6/51 Prospect Rd, Gaythorne QLD 4051 • 0409 126 669 • enquiries@everybodyebikes.com.au" },
    { "type": "link_list", "id": "menu", "label": "Navigation menu (overrides blocks)" },
    { "type": "text", "id": "cta_text", "label": "CTA button text", "default": "Find a Dealer" },
    { "type": "url", "id": "cta_url", "label": "CTA button URL" },
    { "type": "header", "content": "Dealer nav item" },
    { "type": "text", "id": "dealer_label", "label": "Dealer link label", "default": "Dealer" },
    { "type": "url", "id": "dealer_url", "label": "Dealer link URL" },
    { "type": "color", "id": "dealer_color", "label": "Dealer link colour", "default": "#FF6B00" },
    { "type": "header", "content": "Sale badge (top bar)" },
    { "type": "checkbox", "id": "sale_enabled", "label": "Show animated SALE badge", "default": false },
    { "type": "text", "id": "sale_label", "label": "Badge text", "default": "🔥 SALE ITEMS" },
    { "type": "url", "id": "sale_url", "label": "Badge link (collection)" },
    { "type": "color", "id": "sale_bg_color", "label": "Badge background", "default": "#E86C2C" },
    { "type": "color", "id": "sale_text_color", "label": "Badge text colour", "default": "#FFFFFF" },
    { "type": "header", "content": "Floating enquiry" },
    { "type": "text", "id": "marketing_consent_label", "label": "Marketing consent label", "default": "Yes, keep me posted — about special deals, stories and more. No spam, unsubscribe anytime.", "info": "Shown next to the marketing opt-in checkbox on the floating enquiry form." }
  ],
  "blocks": [
    {
      "type": "link",
      "name": "Nav link",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Link" },
        { "type": "url", "id": "url", "label": "URL" }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Header",
      "blocks": [
        { "type": "link", "settings": { "label": "E-Bikes & Trikes" } },
        { "type": "link", "settings": { "label": "Gear" } },
        { "type": "link", "settings": { "label": "Experience Hub" } },
        { "type": "link", "settings": { "label": "Service & Support" } },
        { "type": "link", "settings": { "label": "EEB Dealer" } }
      ]
    }
  ]
}
