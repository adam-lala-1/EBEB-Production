{%- liquid
  assign article = blog.articles.first
-%}
{%- if article -%}
<section class="eeb-section blog-featured">
  <div class="eeb-container">
    <a href="{{ article.url }}" class="blog-featured__card">
      {%- if article.image -%}
        <div class="blog-featured__img">
          <img src="{{ article.image | image_url: width: 1200 }}" alt="{{ article.title | escape }}" loading="lazy">
        </div>
      {%- endif -%}
      <div class="blog-featured__body">
        <span class="eeb-eyebrow">{{ section.settings.eyebrow }} · {{ article.published_at | date: '%b %d, %Y' }}</span>
        <h2 class="blog-featured__title">{{ article.title }}</h2>
        <p class="blog-featured__excerpt">{{ article.excerpt_or_content | strip_html | truncate: 220 }}</p>
        <span class="blog-featured__cta">Read article →</span>
      </div>
    </a>
  </div>
</section>
{%- endif -%}

<style>
  .blog-featured { padding: 2rem 0; }
  .blog-featured__card { display: grid; grid-template-columns: 1.1fr 1fr; gap: 2.5rem; align-items: center; background: var(--color-cream); border-radius: 1.25rem; overflow: hidden; text-decoration: none; color: inherit; }
  .blog-featured__img { aspect-ratio: 4/3; overflow: hidden; }
  .blog-featured__img img { width: 100%; height: 100%; object-fit: cover; transition: transform .4s ease; }
  .blog-featured__card:hover .blog-featured__img img { transform: scale(1.03); }
  .blog-featured__body { padding: 2.5rem; }
  .blog-featured__title { font-family: var(--font-heading); font-size: clamp(1.6rem, 2.5vw, 2.2rem); color: var(--color-navy); margin: .75rem 0 1rem; line-height: 1.2; }
  .blog-featured__excerpt { font-size: 1.05rem; line-height: 1.65; color: var(--color-muted); margin-bottom: 1.25rem; }
  .blog-featured__cta { font-weight: 600; color: var(--color-orange); }
  @media (max-width: 768px) { .blog-featured__card { grid-template-columns: 1fr; } .blog-featured__body { padding: 1.5rem; } }
</style>

{% schema %}
{
  "name": "Blog featured post",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Featured" }
  ],
  "presets": [{ "name": "Blog featured post" }]
}
{% endschema %}
