{%- liquid
  assign heading = section.settings.heading | default: page.title
  assign eyebrow = section.settings.eyebrow
  assign subheading = section.settings.subheading
  assign bg = section.settings.background
  assign image = section.settings.image
-%}
<section class="eeb-section page-hero page-hero--{{ bg }}" {% if image != blank %}style="background-image: linear-gradient(rgba(27,42,74,.65), rgba(27,42,74,.65)), url('{{ image | image_url: width: 2000 }}'); background-size: cover; background-position: center;"{% endif %}>
  <div class="eeb-container" style="max-width: 860px; text-align: center;">
    {%- if eyebrow != blank -%}
      <span class="eeb-eyebrow">{{ eyebrow }}</span>
    {%- endif -%}
    <h1 class="page-hero__title">{{ heading }}</h1>
    {%- if subheading != blank -%}
      <p class="page-hero__sub">{{ subheading }}</p>
    {%- endif -%}
  </div>
</section>

<style>
  .page-hero { padding: 4.5rem 0 3.5rem; }
  .page-hero--navy { background: var(--color-navy); color: #fff; }
  .page-hero--cream { background: var(--color-cream); color: var(--color-navy); }
  .page-hero--image { color: #fff; }
  .page-hero__title { font-family: var(--font-heading); font-size: clamp(2.2rem, 4vw, 3.4rem); margin: .5rem 0 1rem; line-height: 1.1; }
  .page-hero__sub { font-size: 1.15rem; opacity: .85; max-width: 640px; margin: 0 auto; }
</style>

{% schema %}
{
  "name": "Page hero",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading (defaults to page title)" },
    { "type": "textarea", "id": "subheading", "label": "Subheading" },
    { "type": "image_picker", "id": "image", "label": "Background image (optional)" },
    {
      "type": "select", "id": "background", "label": "Background style", "default": "cream",
      "options": [
        { "value": "cream", "label": "Cream" },
        { "value": "navy", "label": "Navy" },
        { "value": "image", "label": "Image (use with background image)" }
      ]
    }
  ],
  "presets": [{ "name": "Page hero" }]
}
{% endschema %}
