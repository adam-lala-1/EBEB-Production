<section class="eeb-section eeb-section--cream">
  <div class="eeb-container">
    <div style="text-align:center;margin-bottom:3rem;">
      {% if section.settings.eyebrow != blank %}<span class="eeb-eyebrow">{{ section.settings.eyebrow }}</span>{% endif %}
      <h2>{{ section.settings.heading }}</h2>
      {% if section.settings.subheading != blank %}<p style="color:var(--color-muted);max-width:42rem;margin:.75rem auto 0;">{{ section.settings.subheading }}</p>{% endif %}
    </div>
    <div class="eeb-grid eeb-grid--4">
      {%- if section.settings.collection != blank and section.settings.collection.products.size > 0 and section.blocks.size == 0 -%}
        {%- for product in section.settings.collection.products limit: 8 -%}
          <a href="{{ product.url }}" class="eeb-card">
            <div class="eeb-card__img">{% if product.featured_image %}<img src="{{ product.featured_image | image_url: width: 600 }}" alt="{{ product.title | escape }}" loading="lazy">{% endif %}</div>
            <div class="eeb-card__body"><h3>{{ product.title }}</h3><p>{{ product.price | money }}</p></div>
          </a>
        {%- endfor -%}
      {%- else -%}
        {%- for block in section.blocks -%}
          {%- assign p = block.settings.product -%}
          {%- if p != blank -%}
            {%- assign card_url = block.settings.link | default: p.url -%}
            {%- assign card_title = block.settings.title | default: p.title -%}
            {%- if block.settings.price != blank -%}
              {%- assign card_price = block.settings.price -%}
            {%- else -%}
              {%- if p.price_varies -%}
                {%- assign card_price = p.price_min | money | prepend: 'from ' -%}
              {%- else -%}
                {%- assign card_price = p.price | money -%}
              {%- endif -%}
            {%- endif -%}
            {%- assign card_img = p.featured_image -%}
          {%- else -%}
            {%- assign card_url = block.settings.link | default: '#' -%}
            {%- assign card_title = block.settings.title -%}
            {%- assign card_price = block.settings.price -%}
            {%- assign card_img = block.settings.image -%}
          {%- endif -%}
          <a href="{{ card_url }}" class="eeb-card" {{ block.shopify_attributes }}>
            <div class="eeb-card__img">
              {% if card_img != blank %}
                <img src="{{ card_img | image_url: width: 600 }}" alt="{{ card_title | escape }}" loading="lazy" style="object-fit:contain;background:#fff;padding:1rem;">
              {% elsif block.settings.image_url != blank %}
                <img src="{{ block.settings.image_url }}" alt="{{ card_title | escape }}" loading="lazy" style="object-fit:contain;background:#fff;padding:1rem;">
              {% endif %}
            </div>
            <div class="eeb-card__body">
              <h3>{{ card_title }}</h3>
              {% if card_price != blank %}<p>{{ card_price }}</p>{% endif %}
              {% if block.settings.show_description and p != blank and p.description != blank %}
                <p style="color:var(--color-muted);font-size:.85rem;margin-top:.4rem;">{{ p.description | strip_html | truncatewords: 18 }}</p>
              {% endif %}
            </div>
          </a>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Accessories",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Gear up" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Accessories" },
    { "type": "text", "id": "subheading", "label": "Subheading" },
    { "type": "paragraph", "content": "Add a product to each block to auto-populate image, title and price. Leave fields blank to use the product's own values, or fill them in to override." },
    { "type": "collection", "id": "collection", "label": "Fallback collection (only used when no blocks are added)" }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Product / item",
      "settings": [
        { "type": "product", "id": "product", "label": "Product (auto-fills image, title, price)" },
        { "type": "header", "content": "Manual overrides" },
        { "type": "image_picker", "id": "image", "label": "Image override" },
        { "type": "text", "id": "image_url", "label": "Or image URL (fallback)" },
        { "type": "text", "id": "title", "label": "Title override" },
        { "type": "text", "id": "price", "label": "Price override (e.g. from $2,495)" },
        { "type": "url", "id": "link", "label": "Link override" },
        { "type": "checkbox", "id": "show_description", "label": "Show product short description", "default": false }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Staff Favourites",
      "blocks": [
        { "type": "item" },
        { "type": "item" },
        { "type": "item" },
        { "type": "item" }
      ]
    }
  ]
}
{% endschema %}
