{%- comment -%}
  Unified blog hub: add one "Blog" block per blog you want included,
  then renders one merged feed with category (blog) + tag filters.
  NOTE: Liquid's global `blogs` object cannot be iterated — blogs must be
  referenced by handle, which is why this uses blocks with a blog picker.
{%- endcomment -%}

{%- assign per_blog = section.settings.articles_per_blog | default: 50 -%}

<section class="eeb-section eeb-section--cream">
  <div class="eeb-container" style="text-align:center;">
    {% if section.settings.eyebrow != blank %}<span class="eeb-eyebrow">{{ section.settings.eyebrow }}</span>{% endif %}
    <h1>{{ section.settings.heading }}</h1>
    {% if section.settings.subheading != blank %}
      <p style="max-width:660px;margin:0 auto;color:var(--color-muted);">{{ section.settings.subheading }}</p>
    {% endif %}
  </div>
</section>

<section class="eeb-section blog-hub" id="BlogHub-{{ section.id }}">
  <div class="eeb-container">
    {%- liquid
      assign tag_list = ''
      assign card_count = 0
    -%}

    {%- capture cards -%}
      {%- for block in section.blocks -%}
        {%- assign blog = blogs[block.settings.blog] -%}
        {%- if blog == blank or blog.articles_count == 0 -%}{%- continue -%}{%- endif -%}
        {%- for article in blog.articles limit: per_blog -%}
          {%- assign card_count = card_count | plus: 1 -%}
          {%- for t in article.tags -%}
            {%- assign tag_list = tag_list | append: t | append: '|' -%}
          {%- endfor -%}
          {%- assign art_tags = article.tags | join: '|' -%}
          <a href="{{ article.url }}"
             class="eeb-card blog-hub__card"
             data-blog="{{ blog.handle }}"
             data-tags="{{ art_tags | escape }}"
             data-date="{{ article.published_at | date: '%s' }}">
            {%- if article.image -%}
              <div class="eeb-card__img"><img src="{{ article.image | image_url: width: 800 }}" alt="{{ article.title | escape }}" loading="lazy" width="800" height="500"></div>
            {%- endif -%}
            <div class="eeb-card__body">
              <span class="eeb-card__eyebrow">{{ blog.title }} &middot; {{ article.published_at | date: '%b %d, %Y' }}</span>
              <h3>{{ article.title }}</h3>
              <p>{{ article.excerpt_or_content | strip_html | truncate: 140 }}</p>
              {%- if article.tags.size > 0 -%}
                <div class="blog-hub__tags">
                  {%- for t in article.tags limit: 3 -%}<span class="blog-hub__tag">{{ t }}</span>{%- endfor -%}
                </div>
              {%- endif -%}
            </div>
          </a>
        {%- endfor -%}
      {%- endfor -%}
    {%- endcapture -%}

    {%- if section.blocks.size == 0 -%}
      <p class="blog-hub__empty">Add a “Blog” block in the theme editor and choose which blogs to show here.</p>
    {%- else -%}
      <div class="blog-hub__filters" role="group" aria-label="Filter articles by category">
        <span class="blog-hub__filter-label">Category</span>
        <div class="blog-hub__chips">
          <button type="button" class="blog-hub__chip is-active" data-filter-blog="all">All</button>
          {%- for block in section.blocks -%}
            {%- assign blog = blogs[block.settings.blog] -%}
            {%- if blog != blank and blog.articles_count > 0 -%}
              <button type="button" class="blog-hub__chip" data-filter-blog="{{ blog.handle }}">{{ block.settings.label | default: blog.title }}</button>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>

      {%- if section.settings.show_tag_filter -%}
        {%- assign uniq_tags = tag_list | split: '|' | uniq | sort_natural -%}
        {%- if uniq_tags.size > 0 -%}
          <div class="blog-hub__filters">
            <span class="blog-hub__filter-label">Topic</span>
            <button type="button" class="blog-hub__chip blog-hub__topic-toggle" data-topic-open aria-haspopup="dialog" aria-expanded="false">
              <span data-topic-current>All topics</span>
              <span aria-hidden="true">▾</span>
            </button>
            <button type="button" class="blog-hub__clear" data-topic-clear hidden>Clear</button>
          </div>

          <div class="blog-hub__overlay" data-topic-overlay hidden>
            <div class="blog-hub__modal" role="dialog" aria-modal="true" aria-label="Search topics">
              <div class="blog-hub__modal-head">
                <input type="search" class="blog-hub__search" placeholder="Search topics…" data-topic-search aria-label="Search topics">
                <button type="button" class="blog-hub__close" data-topic-close aria-label="Close">&times;</button>
              </div>
              <div class="blog-hub__chips blog-hub__modal-chips">
                <button type="button" class="blog-hub__chip blog-hub__chip--tag is-active" data-filter-tag="all">All</button>
                {%- for t in uniq_tags -%}
                  {%- if t != blank -%}
                    <button type="button" class="blog-hub__chip blog-hub__chip--tag" data-filter-tag="{{ t | escape }}">{{ t }}</button>
                  {%- endif -%}
                {%- endfor -%}
              </div>
              <p class="blog-hub__empty" data-topic-none hidden>No topics match that search.</p>
            </div>
          </div>
        {%- endif -%}
      {%- endif -%}

      <div class="eeb-grid eeb-grid--3 blog-hub__grid" data-blog-hub-grid>
        {{ cards }}
      </div>

      <p class="blog-hub__empty" {% if card_count > 0 %}hidden{% endif %}>No articles match those filters yet.</p>
    {%- endif -%}
  </div>
</section>

<style>
  .blog-hub__filters { display: flex; flex-wrap: wrap; align-items: center; gap: .75rem; margin-bottom: 1rem; }
  .blog-hub__filter-label { font-size: .75rem; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; color: var(--color-muted); }
  .blog-hub__chips { display: flex; flex-wrap: wrap; gap: .5rem; }
  .blog-hub__chip {
    border: 1px solid var(--color-border); background: #fff; color: var(--color-navy);
    border-radius: 999px; padding: .45rem 1rem; font-size: .9rem; font-weight: 600;
    cursor: pointer; transition: all .15s ease; font-family: var(--font-body);
  }
  .blog-hub__chip:hover { border-color: var(--color-orange); color: var(--color-orange); }
  .blog-hub__chip.is-active { background: var(--color-navy); border-color: var(--color-navy); color: #fff; }
  .blog-hub__chip--tag.is-active { background: var(--color-orange); border-color: var(--color-orange); }
  .blog-hub__grid { margin-top: 2rem; }
  .blog-hub__card { text-decoration: none; color: inherit; }
  .blog-hub__card[hidden] { display: none !important; }
  .blog-hub__tags { display: flex; flex-wrap: wrap; gap: .35rem; margin-top: .75rem; }
  .blog-hub__tag { font-size: .7rem; text-transform: uppercase; letter-spacing: .08em; font-weight: 700; color: var(--color-orange); background: rgba(232,108,44,.1); padding: .2rem .55rem; border-radius: 999px; }
  .blog-hub__empty { text-align: center; color: var(--color-muted); padding: 2rem 0; }
  .blog-hub__topic-toggle { display: inline-flex; align-items: center; gap: .5rem; }
  .blog-hub__clear { background: none; border: 0; color: var(--color-orange); font-weight: 600; font-size: .85rem; cursor: pointer; text-decoration: underline; }
  .blog-hub__overlay { position: fixed; inset: 0; background: rgba(27,42,74,.55); z-index: 9998; display: flex; align-items: flex-start; justify-content: center; padding: 6vh 1rem; }
  .blog-hub__overlay[hidden] { display: none; }
  .blog-hub__modal { background: #fff; border-radius: 16px; width: min(760px, 100%); max-height: 80vh; display: flex; flex-direction: column; padding: 1.25rem; box-shadow: 0 24px 60px rgba(0,0,0,.25); }
  .blog-hub__modal-head { display: flex; gap: .75rem; align-items: center; margin-bottom: 1rem; }
  .blog-hub__search { flex: 1; border: 1px solid var(--color-border); border-radius: 999px; padding: .65rem 1rem; font-size: 1rem; font-family: var(--font-body); }
  .blog-hub__search:focus { outline: none; border-color: var(--color-orange); }
  .blog-hub__close { background: none; border: 0; font-size: 1.75rem; line-height: 1; cursor: pointer; color: var(--color-muted); }
  .blog-hub__modal-chips { overflow-y: auto; align-content: flex-start; }
  .blog-hub__chip[hidden] { display: none !important; }
</style>

<script>
  (function () {
    var root = document.getElementById('BlogHub-{{ section.id }}');
    if (!root) return;
    var grid = root.querySelector('[data-blog-hub-grid]');
    if (!grid) return;
    var cards = Array.prototype.slice.call(grid.querySelectorAll('.blog-hub__card'));
    var empty = root.querySelector('.blog-hub__empty:not([data-topic-none])');
    var state = { blog: 'all', tag: 'all' };

    // Merge feeds from all blogs into one newest-first list.
    cards
      .sort(function (a, b) { return (parseInt(b.dataset.date, 10) || 0) - (parseInt(a.dataset.date, 10) || 0); })
      .forEach(function (c) { grid.appendChild(c); });

    function apply() {
      var visible = 0;
      cards.forEach(function (card) {
        var tags = (card.dataset.tags || '').split('|');
        var ok = (state.blog === 'all' || card.dataset.blog === state.blog) &&
                 (state.tag === 'all' || tags.indexOf(state.tag) !== -1);
        card.hidden = !ok;
        if (ok) visible++;
      });
      if (empty) empty.hidden = visible !== 0;
      var url = new URL(window.location.href);
      state.blog === 'all' ? url.searchParams.delete('category') : url.searchParams.set('category', state.blog);
      state.tag === 'all' ? url.searchParams.delete('tag') : url.searchParams.set('tag', state.tag);
      window.history.replaceState({}, '', url);
    }

    function bind(attr, key) {
      var btns = Array.prototype.slice.call(root.querySelectorAll('[' + attr + ']'));
      btns.forEach(function (btn) {
        btn.addEventListener('click', function () {
          state[key] = btn.getAttribute(attr);
          btns.forEach(function (b) { b.classList.toggle('is-active', b === btn); });
          apply();
        });
      });
      return btns;
    }

    var blogBtns = bind('data-filter-blog', 'blog');
    var tagBtns = bind('data-filter-tag', 'tag');

    // Topic overlay
    var overlay = root.querySelector('[data-topic-overlay]');
    if (overlay) {
      var openBtn = root.querySelector('[data-topic-open]');
      var label = root.querySelector('[data-topic-current]');
      var clearBtn = root.querySelector('[data-topic-clear]');
      var search = root.querySelector('[data-topic-search]');
      var noneMsg = root.querySelector('[data-topic-none]');

      function setOpen(open) {
        overlay.hidden = !open;
        openBtn.setAttribute('aria-expanded', open ? 'true' : 'false');
        document.body.style.overflow = open ? 'hidden' : '';
        if (open && search) { search.focus(); }
      }
      function syncLabel() {
        var active = overlay.querySelector('[data-filter-tag].is-active');
        var val = active ? active.getAttribute('data-filter-tag') : 'all';
        label.textContent = val === 'all' ? 'All topics' : active.textContent.trim();
        openBtn.classList.toggle('is-active', val !== 'all');
        if (clearBtn) clearBtn.hidden = val === 'all';
      }
      openBtn.addEventListener('click', function () { setOpen(overlay.hidden); });
      root.querySelector('[data-topic-close]').addEventListener('click', function () { setOpen(false); });
      overlay.addEventListener('click', function (e) { if (e.target === overlay) setOpen(false); });
      document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && !overlay.hidden) setOpen(false); });
      tagBtns.forEach(function (b) { b.addEventListener('click', function () { syncLabel(); setOpen(false); }); });
      if (clearBtn) {
        clearBtn.addEventListener('click', function () {
          var all = overlay.querySelector('[data-filter-tag="all"]');
          if (all) all.click();
        });
      }
      if (search) {
        search.addEventListener('input', function () {
          var q = search.value.trim().toLowerCase();
          var shown = 0;
          tagBtns.forEach(function (b) {
            if (b.getAttribute('data-filter-tag') === 'all') return;
            var ok = !q || b.textContent.toLowerCase().indexOf(q) !== -1;
            b.hidden = !ok;
            if (ok) shown++;
          });
          if (noneMsg) noneMsg.hidden = shown !== 0 || !q;
        });
      }
      setTimeout(syncLabel, 0);
    }

    // Deep links: /pages/blog?category=news&tag=touring
    var params = new URLSearchParams(window.location.search);
    ['category:blog:data-filter-blog', 'tag:tag:data-filter-tag'].forEach(function (spec) {
      var parts = spec.split(':');
      var val = params.get(parts[0]);
      if (!val) return;
      var target = root.querySelector('[' + parts[2] + '="' + val.replace(/"/g, '') + '"]');
      if (target) {
        state[parts[1]] = val;
        (parts[1] === 'blog' ? blogBtns : tagBtns).forEach(function (b) { b.classList.toggle('is-active', b === target); });
      }
    });

    apply();
  })();
</script>

{% schema %}
{
  "name": "Blog hub",
  "max_blocks": 10,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Journal" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Stories, guides and updates" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Everything from all of our blogs in one place — filter by category or topic." },
    { "type": "range", "id": "articles_per_blog", "label": "Max articles per blog", "min": 10, "max": 200, "step": 10, "default": 50 },
    { "type": "checkbox", "id": "show_tag_filter", "label": "Show tag filter", "default": true }
  ],
  "blocks": [
    {
      "type": "blog",
      "name": "Blog",
      "settings": [
        { "type": "blog", "id": "blog", "label": "Blog" },
        { "type": "text", "id": "label", "label": "Filter label", "info": "Optional. Defaults to the blog title." }
      ]
    }
  ],
  "presets": [{ "name": "Blog hub", "blocks": [{ "type": "blog" }, { "type": "blog" }, { "type": "blog" }] }]
}
{% endschema %}
