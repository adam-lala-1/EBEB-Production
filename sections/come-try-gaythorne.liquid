<section class="eeb-section eeb-section--cream" id="gaythorne">
  <div class="eeb-container">
    <div class="eeb-gaythorne-grid">
      <div class="eeb-gaythorne-main">
        <div>
          {% if section.settings.eyebrow != blank %}<span class="eeb-eyebrow">{{ section.settings.eyebrow }}</span>{% endif %}
          <h2>{{ section.settings.heading }}</h2>
          {% if section.settings.body != blank %}
            <p class="eeb-gaythorne-body">{{ section.settings.body }}</p>
          {% endif %}

          <ul class="eeb-gaythorne-features">
            {% for block in section.blocks %}
              {% if block.type == 'feature' %}
                <li {{ block.shopify_attributes }}>
                  <span class="eeb-gaythorne-feature-icon">{{ block.settings.icon | default: '✓' }}</span>
                  <span><strong>{{ block.settings.title }}</strong>{% if block.settings.body != blank %} — <span>{{ block.settings.body }}</span>{% endif %}</span>
                </li>
              {% endif %}
            {% endfor %}
          </ul>

          {% if section.settings.cta_text != blank %}
            <a class="eeb-btn eeb-btn--primary" href="{{ section.settings.cta_url | default: '#rsvp' }}">{{ section.settings.cta_text }} →</a>
          {% endif %}
        </div>

        <div class="eeb-location-map-block">
          <button class="eeb-location-map-trigger" type="button" aria-label="Enlarge EveryBody eBikes location map" data-eeb-map-trigger>
            <img
              src="{{ 'eeb-location-map.png' | asset_url }}"
              alt="Map showing colour-coded routes to EveryBody eBikes at Unit 6, 51 Prospect Road, Gaythorne"
              loading="lazy"
              width="1370"
              height="854"
            >
            <span class="eeb-location-map-badge">⌕ Click to enlarge</span>
          </button>

          <div class="eeb-location-map-actions">
            {% if section.settings.map_url != blank %}
              <a class="eeb-btn eeb-btn--dark" href="{{ section.settings.map_url }}" target="_blank" rel="noopener">Open in Google Maps</a>
            {% endif %}
            {% if section.settings.satnav_tip != blank %}
              <div class="eeb-location-map-tip">{{ section.settings.satnav_tip }}</div>
            {% endif %}
          </div>
        </div>
      </div>

      <div class="eeb-gaythorne-side">
        <div class="eeb-location-card">
          <h3>{{ section.settings.how_to_get_there_heading | default: 'How to get there' }}</h3>
          <ul class="eeb-location-list">
            {% if section.settings.address != blank %}
              <li>
                <span aria-hidden="true">📍</span>
                <div><strong>{{ section.settings.label_address | default: 'Address' }}</strong><br>{{ section.settings.address }}{% if section.settings.address_note != blank %} — {{ section.settings.address_note }}{% endif %}</div>
              </li>
            {% endif %}
            {% if section.settings.hours != blank %}
              <li>
                <span aria-hidden="true">🕘</span>
                <div><strong>{{ section.settings.label_hours | default: 'Open' }}</strong><br>{{ section.settings.hours }}</div>
              </li>
            {% endif %}
            {% if section.settings.parking != blank %}
              <li>
                <span aria-hidden="true">🅿️</span>
                <div><strong>{{ section.settings.label_parking | default: 'Parking' }}</strong><br>{{ section.settings.parking }}</div>
              </li>
            {% endif %}
            {% if section.settings.transit != blank %}
              <li>
                <span aria-hidden="true">🚆</span>
                <div><strong>{{ section.settings.label_transit | default: 'Public transport' }}</strong><br>{{ section.settings.transit }}</div>
              </li>
            {% endif %}
          </ul>
        </div>

        <div class="eeb-location-card">
          <h3>{{ section.settings.finding_heading | default: 'Finding the complex' }}</h3>

          {% assign has_steps = false %}
          {% assign has_routes = false %}
          {% for block in section.blocks %}
            {% if block.type == 'direction_step' %}{% assign has_steps = true %}{% endif %}
            {% if block.type == 'route' %}{% assign has_routes = true %}{% endif %}
          {% endfor %}

          {% if has_steps %}
            <ol class="eeb-location-steps">
              {% for block in section.blocks %}
                {% if block.type == 'direction_step' %}
                  <li {{ block.shopify_attributes }}>{{ block.settings.text }}</li>
                {% endif %}
              {% endfor %}
            </ol>
          {% endif %}

          {% if has_routes %}
            <div class="eeb-route-list-wrap">
              <strong>{{ section.settings.routes_heading | default: 'Which route to take (see map)' }}</strong>
              <ul class="eeb-route-list">
                {% for block in section.blocks %}
                  {% if block.type == 'route' %}
                    <li {{ block.shopify_attributes }}>
                      <span class="eeb-route-dot" style="background: {{ block.settings.color | default: '#E86C2C' }};" aria-hidden="true"></span>
                      <span><strong>{{ block.settings.label }}</strong>{% if block.settings.text != blank %} — {{ block.settings.text }}{% endif %}</span>
                    </li>
                  {% endif %}
                {% endfor %}
              </ul>
            </div>
          {% endif %}
        </div>
      </div>
    </div>
  </div>

  <div class="eeb-location-lightbox" data-eeb-map-lightbox hidden>
    <button class="eeb-location-lightbox__close" type="button" aria-label="Close enlarged map" data-eeb-map-close>×</button>
    <img
      src="{{ 'eeb-location-map.png' | asset_url }}"
      alt="Enlarged map showing colour-coded routes to EveryBody eBikes at Unit 6, 51 Prospect Road, Gaythorne"
      width="1370"
      height="854"
      loading="lazy"
    >
  </div>

  <script>
    (function () {
      var section = document.currentScript.closest('#shopify-section-{{ section.id }}');
      if (!section) return;
      var trigger = section.querySelector('[data-eeb-map-trigger]');
      var lightbox = section.querySelector('[data-eeb-map-lightbox]');
      var close = section.querySelector('[data-eeb-map-close]');
      if (!trigger || !lightbox || !close) return;

      function openMap() {
        lightbox.hidden = false;
        document.documentElement.classList.add('eeb-lightbox-open');
        close.focus();
      }

      function closeMap() {
        lightbox.hidden = true;
        document.documentElement.classList.remove('eeb-lightbox-open');
        trigger.focus();
      }

      trigger.addEventListener('click', openMap);
      close.addEventListener('click', closeMap);
      lightbox.addEventListener('click', function (event) {
        if (event.target === lightbox) closeMap();
      });
      document.addEventListener('keydown', function (event) {
        if (event.key === 'Escape' && !lightbox.hidden) closeMap();
      });
    })();
  </script>
</section>

<style>
  #shopify-section-{{ section.id }} .eeb-gaythorne-grid { display: grid; gap: 3rem; grid-template-columns: 1fr; align-items: start; }
  #shopify-section-{{ section.id }} .eeb-gaythorne-main,
  #shopify-section-{{ section.id }} .eeb-gaythorne-side { display: grid; gap: 2.5rem; }
  #shopify-section-{{ section.id }} .eeb-gaythorne-body { color: var(--color-muted); font-size: 1.05rem; max-width: 42rem; }
  #shopify-section-{{ section.id }} .eeb-gaythorne-features { list-style: none; padding: 0; margin: 1.5rem 0; display: grid; gap: .75rem; }
  #shopify-section-{{ section.id }} .eeb-gaythorne-features li { display: flex; gap: .75rem; align-items: flex-start; color: var(--color-muted); font-size: .95rem; }
  #shopify-section-{{ section.id }} .eeb-gaythorne-features strong { color: var(--color-foreground); }
  #shopify-section-{{ section.id }} .eeb-gaythorne-feature-icon { font-size: 1.25rem; line-height: 1; }
  #shopify-section-{{ section.id }} .eeb-location-map-trigger { position: relative; display: block; width: 100%; padding: 0; border: 1px solid var(--color-border); border-radius: 1rem; overflow: hidden; background: #fff; box-shadow: 0 4px 16px rgba(27,42,74,.08); text-align: left; cursor: zoom-in; }
  #shopify-section-{{ section.id }} .eeb-location-map-trigger img { width: 100%; transition: transform .3s ease; }
  #shopify-section-{{ section.id }} .eeb-location-map-trigger:hover img { transform: scale(1.02); }
  #shopify-section-{{ section.id }} .eeb-location-map-trigger:focus-visible { outline: 2px solid var(--color-orange); outline-offset: 3px; }
  #shopify-section-{{ section.id }} .eeb-location-map-badge { position: absolute; right: .75rem; bottom: .75rem; display: inline-flex; align-items: center; gap: .35rem; padding: .45rem .8rem; border-radius: 999px; border: 1px solid var(--color-border); background: rgba(255,255,255,.92); color: var(--color-navy); font-size: .78rem; font-weight: 700; box-shadow: 0 4px 14px rgba(27,42,74,.12); }
  #shopify-section-{{ section.id }} .eeb-location-map-actions { display: flex; gap: 1rem; align-items: flex-start; flex-wrap: wrap; margin-top: 1rem; }
  #shopify-section-{{ section.id }} .eeb-location-map-tip { flex: 1 1 18rem; margin: 0; color: var(--color-muted); font-size: .82rem; font-style: italic; line-height: 1.65; }
  #shopify-section-{{ section.id }} .eeb-location-map-tip strong { color: var(--color-foreground); font-style: normal; }
  #shopify-section-{{ section.id }} .eeb-location-map-tip p { margin: 0; }
  #shopify-section-{{ section.id }} .eeb-location-card { background: #fff; border: 1px solid var(--color-border); border-radius: 1rem; padding: 1.75rem; }
  #shopify-section-{{ section.id }} .eeb-location-card h3 { margin-bottom: 1rem; }
  #shopify-section-{{ section.id }} .eeb-location-list { list-style: none; padding: 0; margin: 0; display: grid; gap: 1rem; color: var(--color-muted); font-size: .95rem; }
  #shopify-section-{{ section.id }} .eeb-location-list li { display: grid; grid-template-columns: 1.5rem 1fr; gap: .75rem; }
  #shopify-section-{{ section.id }} .eeb-location-list strong,
  #shopify-section-{{ section.id }} .eeb-location-steps strong,
  #shopify-section-{{ section.id }} .eeb-route-list strong { color: var(--color-foreground); }
  #shopify-section-{{ section.id }} .eeb-location-steps { margin: 0 0 1.5rem; padding-left: 1.25rem; display: grid; gap: .75rem; color: var(--color-muted); font-size: .95rem; }
  #shopify-section-{{ section.id }} .eeb-location-steps li::marker { color: var(--color-orange); font-weight: 700; }
  #shopify-section-{{ section.id }} .eeb-route-list-wrap { border-top: 1px solid var(--color-border); padding-top: 1.25rem; }
  #shopify-section-{{ section.id }} .eeb-route-list-wrap > strong { display: block; margin-bottom: .75rem; color: var(--color-foreground); font-size: .95rem; }
  #shopify-section-{{ section.id }} .eeb-route-list { list-style: none; padding: 0; margin: 0; display: grid; gap: .65rem; color: var(--color-muted); font-size: .92rem; }
  #shopify-section-{{ section.id }} .eeb-route-list li { display: grid; grid-template-columns: .85rem 1fr; gap: .75rem; align-items: start; }
  #shopify-section-{{ section.id }} .eeb-route-dot { width: .75rem; height: .75rem; border-radius: 999px; margin-top: .35rem; }
  #shopify-section-{{ section.id }} .eeb-location-lightbox[hidden] { display: none; }
  #shopify-section-{{ section.id }} .eeb-location-lightbox { position: fixed; inset: 0; z-index: 9999; display: grid; place-items: center; padding: 2rem; background: rgba(10,16,28,.76); }
  #shopify-section-{{ section.id }} .eeb-location-lightbox img { width: min(100%, 72rem); max-height: 88vh; object-fit: contain; border-radius: .75rem; background: #fff; box-shadow: 0 24px 70px rgba(0,0,0,.35); }
  #shopify-section-{{ section.id }} .eeb-location-lightbox__close { position: absolute; top: 1rem; right: 1rem; width: 2.75rem; height: 2.75rem; border-radius: 999px; border: 1px solid rgba(255,255,255,.25); background: #fff; color: var(--color-navy); font-size: 1.75rem; line-height: 1; }
  .eeb-lightbox-open { overflow: hidden; }
  @media (min-width: 900px) {
    #shopify-section-{{ section.id }} .eeb-gaythorne-grid { grid-template-columns: 1.08fr .92fr; }
  }
  @media (max-width: 600px) {
    #shopify-section-{{ section.id }} .eeb-location-card { padding: 1.35rem; }
    #shopify-section-{{ section.id }} .eeb-location-map-badge { font-size: .72rem; }
  }
</style>

{% schema %}
{
  "name": "Gaythorne — visit anytime",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Visit anytime" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Test ride at our Gaythorne workshop" },
    { "type": "textarea", "id": "body", "label": "Body", "default": "Can't make an event? Drop in to our Gaythorne workshop any weekday. We've got the full range ready to ride, a quiet street out front for first-timers, and an undercover space for wet days." },
    { "type": "text", "id": "cta_text", "label": "CTA text", "default": "Book a time" },
    { "type": "url", "id": "cta_url", "label": "CTA URL" },

    { "type": "header", "content": "Map & SATNAV" },
    { "type": "url", "id": "map_url", "label": "Google Maps URL", "info": "Paste the Google Maps share link" },
    { "type": "richtext", "id": "satnav_tip", "label": "SATNAV tip (under map)", "default": "<p><strong>SATNAV tip:</strong> If your GPS routes you via Bellevue Ave, drive past the Delta Gym building and ignore the “No Entry” signage. Continue down the small hill toward the warehouses facing the railway line — we're half way along.</p>" },

    { "type": "header", "content": "How to get there (right column)" },
    { "type": "text", "id": "how_to_get_there_heading", "label": "Card heading", "default": "How to get there" },
    { "type": "text", "id": "label_address", "label": "Address label", "default": "Address" },
    { "type": "text", "id": "address", "label": "Address", "default": "Unit 6, 51 Prospect Road, Gaythorne QLD 4051" },
    { "type": "textarea", "id": "address_note", "label": "Address note", "default": "a complex of about 20 large warehouses; we're number 6." },
    { "type": "text", "id": "label_hours", "label": "Hours label", "default": "Open" },
    { "type": "text", "id": "hours", "label": "Hours", "default": "Mon–Fri 9AM–5PM, Sat 10AM–4PM (Sun by appointment)" },
    { "type": "text", "id": "label_parking", "label": "Parking label", "default": "Parking" },
    { "type": "textarea", "id": "parking", "label": "Parking", "default": "Dedicated bays in front of Warehouse 6, plus free street parking on Prospect Road." },
    { "type": "text", "id": "label_transit", "label": "Public transport label", "default": "Public transport" },
    { "type": "textarea", "id": "transit", "label": "Public transport", "default": "5 min walk from Gaythorne train station (Ferny Grove line). Bus 390 stops on Samford Road." },

    { "type": "header", "content": "Finding the complex (right column)" },
    { "type": "text", "id": "finding_heading", "label": "Card heading", "default": "Finding the complex" },
    { "type": "text", "id": "routes_heading", "label": "Routes sub-heading", "default": "Which route to take (see map)" },
    { "type": "paragraph", "content": "Add step-by-step directions and colour-coded routes using the blocks below." }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Ease-of-testing point",
      "settings": [
        { "type": "text", "id": "icon", "label": "Icon (emoji)", "default": "✓" },
        { "type": "text", "id": "title", "label": "Title", "default": "Quiet test street" },
        { "type": "textarea", "id": "body", "label": "Body" }
      ]
    },
    {
      "type": "direction_step",
      "name": "Direction step",
      "settings": [
        { "type": "richtext", "id": "text", "label": "Step text", "default": "<p>Prospect Road comes off Samford Road at the <strong>Gaythorne Bowls Club</strong>.</p>" }
      ]
    },
    {
      "type": "route",
      "name": "Route (coloured)",
      "settings": [
        { "type": "color", "id": "color", "label": "Dot colour", "default": "#F59E0B" },
        { "type": "text", "id": "label", "label": "Route label", "default": "From the north" },
        { "type": "textarea", "id": "text", "label": "Description", "default": "Osborne Road → Samford Road → Prospect Road." }
      ]
    }
  ],
  "max_blocks": 24,
  "presets": [
    {
      "name": "Gaythorne — visit anytime",
      "blocks": [
        { "type": "feature", "settings": { "icon": "🛣️", "title": "Quiet test street", "body": "Prospect Rd is low-traffic — perfect for first-time and nervous riders." } },
        { "type": "feature", "settings": { "icon": "🧰", "title": "Full range on-site", "body": "Commuter, cargo, folding ebikes and Trident trikes all ready to ride." } },
        { "type": "feature", "settings": { "icon": "🧑‍🔧", "title": "Expert fittings", "body": "Our mechanics will adjust the bike to you before you head out." } },
        { "type": "feature", "settings": { "icon": "♿", "title": "Accessible entry", "body": "Step-free access and undercover ride zone for wet days." } },
        { "type": "direction_step", "settings": { "text": "<p>Prospect Road comes off Samford Road at the <strong>Gaythorne Bowls Club</strong>.</p>" } },
        { "type": "direction_step", "settings": { "text": "<p>Access the complex from <strong>Prospect Road</strong>, cross the railway line, then turn <strong>right</strong>.</p>" } },
        { "type": "direction_step", "settings": { "text": "<p>Go through the large black gates into the complex.</p>" } },
        { "type": "direction_step", "settings": { "text": "<p>Ride or drive to the <strong>right of Warehouse 9</strong> — the warehouse facing the railway line.</p>" } },
        { "type": "direction_step", "settings": { "text": "<p>Look for <strong>Warehouse 6 on your left</strong>; we are half way along.</p>" } },
        { "type": "route", "settings": { "color": "#F59E0B", "label": "From the north", "text": "Osborne Road → Samford Road → Prospect Road." } },
        { "type": "route", "settings": { "color": "#EC4899", "label": "From the south or west", "text": "Samford Road → Prospect Road (pink and blue routes)." } },
        { "type": "route", "settings": { "color": "#FACC15", "label": "From the east", "text": "Pickering Street → Bellevue Ave." } },
        { "type": "route", "settings": { "color": "#10B981", "label": "By bike or trike", "text": "Kedron Brook Bikeway → Bellevue Ave." } }
      ]
    }
  ]
}
{% endschema %}
