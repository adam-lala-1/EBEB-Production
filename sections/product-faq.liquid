{%- if section.blocks.size > 0 -%}
<section class="eeb-section eeb-section--cream">
  <div class="eeb-container" style="max-width: 880px;">
    {%- if section.settings.heading != blank -%}
      <h2 style="margin-bottom:1.5rem;">{{ section.settings.heading }}</h2>
    {%- endif -%}
    <div class="eeb-faq">
      {%- for block in section.blocks -%}
        <details class="eeb-faq__item" {{ block.shopify_attributes }}>
          <summary>{{ block.settings.question }}</summary>
          <div class="rte">{{ block.settings.answer }}</div>
        </details>
      {%- endfor -%}
    </div>
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "Product FAQ",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Frequently asked questions" }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "FAQ item",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "Does it come assembled?" },
        { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>Yes — your order ships ready to ride.</p>" }
      ]
    }
  ],
  "max_blocks": 20,
  "presets": [{ "name": "Product FAQ" }]
}
{% endschema %}
