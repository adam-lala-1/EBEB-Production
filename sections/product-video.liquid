<section class="eeb-section" style="text-align:center;">
  <div class="eeb-container" style="max-width: 960px;">
    {% if section.settings.eyebrow != blank %}
      <p style="text-transform:uppercase;letter-spacing:.15em;font-size:.75rem;color:var(--color-orange);margin-bottom:.5rem;">{{ section.settings.eyebrow }}</p>
    {% endif %}
    {% if section.settings.heading != blank %}
      <h2 style="margin-bottom:1.5rem;">{{ section.settings.heading }}</h2>
    {% endif %}
    {% if section.settings.video_url != blank %}
      <div style="position:relative;padding-bottom:56.25%;height:0;overflow:hidden;border-radius:12px;box-shadow:0 10px 40px rgba(0,0,0,.15);">
        <iframe
          src="{{ section.settings.video_url }}"
          style="position:absolute;top:0;left:0;width:100%;height:100%;border:0;"
          title="{{ section.settings.heading | escape }}"
          loading="lazy"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
          allowfullscreen></iframe>
      </div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Product video",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Watch" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "See it in action" },
    { "type": "url", "id": "video_url", "label": "Video embed URL (YouTube/Vimeo embed)", "info": "Use the embed URL, e.g. https://www.youtube.com/embed/xxxx" }
  ],
  "presets": [{ "name": "Product video" }]
}
{% endschema %}
