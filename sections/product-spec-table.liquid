{%- if section.blocks.size > 0 -%}
<section class="eeb-section">
  <div class="eeb-container" style="max-width: 880px;">
    {%- if section.settings.heading != blank -%}
      <h2 style="margin-bottom:1.5rem;">{{ section.settings.heading }}</h2>
    {%- endif -%}
    <dl class="eeb-spec-table">
      {%- for block in section.blocks -%}
        <div class="eeb-spec-table__row" {{ block.shopify_attributes }}>
          <dt>{{ block.settings.label }}</dt>
          <dd>{{ block.settings.value }}</dd>
        </div>
      {%- endfor -%}
    </dl>
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "Product specs",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Specifications" }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Spec row",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Weight" },
        { "type": "text", "id": "value", "label": "Value", "default": "1.2 kg" }
      ]
    }
  ],
  "max_blocks": 25,
  "presets": [{ "name": "Product specs" }]
}
{% endschema %}
