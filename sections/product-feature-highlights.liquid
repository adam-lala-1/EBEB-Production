{%- if section.blocks.size > 0 -%}
<section class="eeb-section eeb-section--cream">
  <div class="eeb-container">
    {%- if section.settings.heading != blank -%}
      <h2 style="text-align:center;margin-bottom:2.5rem;">{{ section.settings.heading }}</h2>
    {%- endif -%}
    <div class="eeb-feature-grid">
      {%- for block in section.blocks -%}
        <div class="eeb-feature-card" {{ block.shopify_attributes }}>
          {%- if block.settings.icon != blank -%}
            <div class="eeb-feature-card__icon">{% render 'icon', name: block.settings.icon %}</div>
          {%- endif -%}
          <h3>{{ block.settings.title }}</h3>
          <p>{{ block.settings.text }}</p>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "Product feature highlights",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Why you'll love it" }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon", "options": [
          { "value": "shield", "label": "Shield" },
          { "value": "battery", "label": "Battery" },
          { "value": "gauge", "label": "Gauge" },
          { "value": "weight", "label": "Weight" },
          { "value": "users", "label": "Users" },
          { "value": "leaf", "label": "Leaf" }
        ], "default": "shield" },
        { "type": "text", "id": "title", "label": "Title", "default": "Built to last" },
        { "type": "textarea", "id": "text", "label": "Description", "default": "Add a short benefit sentence here." }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [{ "name": "Product feature highlights" }]
}
{% endschema %}
