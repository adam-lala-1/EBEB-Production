<style>
  .eeb-pdp__enquire { display: block; width: 100%; margin-top: 10px; padding: 12px 18px; background: #fff; color: var(--color-orange, #E86C2C); border: 2px solid var(--color-orange, #E86C2C); border-radius: 8px; font-weight: 600; font-size: 14px; cursor: pointer; font-family: inherit; }
  .eeb-pdp__enquire:hover { background: var(--color-orange, #E86C2C); color: #fff; }
  .eeb-pdp__enquire[hidden] { display: none; }
  .eeb-trust-bullets { list-style: none; padding: 0; margin: 16px 0 0; display: flex; flex-direction: column; gap: 8px; }
  .eeb-trust-bullets li { display: flex; align-items: center; gap: 10px; font-size: 14px; color: var(--color-foreground, #1B2A4A); }
  .eeb-trust-bullets li svg { color: var(--color-orange, #E86C2C); flex-shrink: 0; }
</style>
<section class="eeb-section" id="EebPdp-{{ section.id }}" data-section-id="{{ section.id }}">
  <div class="eeb-container">
    {%- if section.settings.show_breadcrumb -%}
      <nav class="eeb-breadcrumb" aria-label="Breadcrumb">
        <a href="{{ routes.root_url }}">Home</a>
        <span>/</span>
        {%- if collection -%}
          <a href="{{ collection.url }}">{{ collection.title }}</a><span>/</span>
        {%- endif -%}
        <span>{{ product.title }}</span>
      </nav>
    {%- endif -%}

    <div class="eeb-pdp">
      {%- comment -%} Gallery {%- endcomment -%}
      <div class="eeb-pdp__gallery">
        <div class="eeb-pdp__main">
          {%- if product.images.size > 1 -%}
            <button type="button" class="eeb-pdp__nav eeb-pdp__nav--prev" data-dir="-1" aria-label="Previous image">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
            </button>
            <button type="button" class="eeb-pdp__nav eeb-pdp__nav--next" data-dir="1" aria-label="Next image">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
            </button>
          {%- endif -%}
          {%- if product.featured_image -%}
            <img class="eeb-pdp__main-img" src="{{ product.featured_image | image_url: width: 1400 }}" alt="{{ product.featured_image.alt | default: product.title | escape }}" loading="eager">
          {%- else -%}
            <div class="eeb-pdp__placeholder">{{ 'product-1' | placeholder_svg_tag }}</div>
          {%- endif -%}
        </div>
        {%- if product.images.size > 1 -%}
          <div class="eeb-pdp__thumbs">
            {%- for image in product.images limit: 12 -%}
              <button type="button" class="eeb-pdp__thumb {% if forloop.first %}is-active{% endif %}" data-index="{{ forloop.index0 }}" data-image-id="{{ image.id }}" data-full="{{ image | image_url: width: 1400 }}" aria-label="View image {{ forloop.index }}">
                <img src="{{ image | image_url: width: 200 }}" alt="" loading="lazy">
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      {%- comment -%} Buy box {%- endcomment -%}
      <div class="eeb-pdp__info">
        {%- assign eyebrow = '' -%}
        {%- case section.settings.eyebrow_source -%}
          {%- when 'vendor' -%}{%- assign eyebrow = product.vendor -%}
          {%- when 'type' -%}{%- assign eyebrow = product.type -%}
          {%- when 'custom' -%}{%- assign eyebrow = section.settings.eyebrow_custom -%}
        {%- endcase -%}
        {%- if eyebrow != blank -%}<span class="eeb-eyebrow">{{ eyebrow }}</span>{%- endif -%}

        <h1>{{ product.title }}</h1>

        {%- assign variant = product.selected_or_first_available_variant -%}
        <div class="eeb-pdp__price" data-price-wrap>
          <span class="eeb-pdp__price-now" data-price-now>{{ variant.price | money }}</span>
          <span class="eeb-pdp__price-was" data-price-was {% unless variant.compare_at_price > variant.price %}hidden{% endunless %}>{{ variant.compare_at_price | money }}</span>
          <span class="eeb-pdp__price-save" data-price-save {% unless variant.compare_at_price > variant.price %}hidden{% endunless %}>
            {%- if variant.compare_at_price > variant.price -%}
              {%- assign saving = variant.compare_at_price | minus: variant.price -%}Save {{ saving | money }}
            {%- endif -%}
          </span>
        </div>

        {%- if product.description != blank and product.description contains '<!-- split -->' -%}
          <div class="eeb-pdp__short rte">{{ product.description | split: '<!-- split -->' | first }}</div>
        {%- endif -%}

        {%- form 'product', product, novalidate: 'novalidate', class: 'eeb-pdp__form' -%}
          {%- unless product.has_only_default_variant -%}
            {%- for option in product.options_with_values -%}
              {%- assign is_colour = false -%}
              {%- if option.name contains 'Colour' or option.name contains 'Color' -%}{%- assign is_colour = true -%}{%- endif -%}
              <div class="eeb-pdp__option">
                <p class="eeb-pdp__option-label">{{ option.name }}: <span class="eeb-pdp__option-value" data-option-index="{{ forloop.index0 }}">{{ option.selected_value }}</span></p>
                <div class="eeb-pdp__option-values {% if is_colour %}is-swatches{% endif %}">
                  {%- for value in option.values -%}
                    <button type="button" class="eeb-pdp__option-btn {% if option.selected_value == value %}is-active{% endif %}"
                            data-option-index="{{ forloop.parentloop.index0 }}"
                            data-value="{{ value | escape }}"
                            {% if is_colour %}style="background: {{ value | downcase | handle }};" aria-label="{{ value }}" title="{{ value }}"{% endif %}>
                      {%- unless is_colour -%}{{ value }}{%- endunless -%}
                    </button>
                  {%- endfor -%}
                </div>
              </div>
            {%- endfor -%}

            <select name="id" class="eeb-pdp__variant-select" hidden>
              {%- for v in product.variants -%}
                <option value="{{ v.id }}" {% if v == variant %}selected{% endif %} {% unless v.available %}disabled{% endunless %}>{{ v.title }} - {{ v.price | money }}</option>
              {%- endfor -%}
            </select>
          {%- else -%}
            <input type="hidden" name="id" value="{{ variant.id }}">
          {%- endunless -%}

          <div class="eeb-pdp__qty-row">
            <div class="eeb-pdp__qty">
              <button type="button" class="eeb-pdp__qty-btn" data-step="-1" aria-label="Decrease quantity">−</button>
              <input type="number" name="quantity" value="1" min="1" inputmode="numeric" aria-label="Quantity">
              <button type="button" class="eeb-pdp__qty-btn" data-step="1" aria-label="Increase quantity">+</button>
            </div>
            <button type="submit" name="add" class="eeb-btn eeb-btn--primary eeb-pdp__atc" {% unless variant.available %}disabled{% endunless %}>
              {%- if variant.available -%}{{ section.settings.atc_text }}{%- else -%}Sold out{%- endif -%}
            </button>
          </div>

          <button type="button" class="eeb-btn eeb-pdp__enquire" data-enquire {% if variant.available %}hidden{% endif %}>
            {{ section.settings.enquire_text | default: 'Notify me / Enquire' }}
          </button>
        {%- endform -%}

        {%- if section.settings.bullet_1 != blank or section.settings.bullet_2 != blank or section.settings.bullet_3 != blank -%}
          <ul class="eeb-pdp__trust">
            {%- if section.settings.bullet_1 != blank -%}<li>{{ section.settings.bullet_1 }}</li>{%- endif -%}
            {%- if section.settings.bullet_2 != blank -%}<li>{{ section.settings.bullet_2 }}</li>{%- endif -%}
            {%- if section.settings.bullet_3 != blank -%}<li>{{ section.settings.bullet_3 }}</li>{%- endif -%}
          </ul>
        {%- endif -%}
      </div>
    </div>

    {%- if section.settings.show_full_description and product.description != blank -%}
      {%- assign desc_parts = product.description | split: '<!-- split -->' -%}
      {%- if desc_parts.size > 1 -%}
        {%- assign full_desc = desc_parts | slice: 1, 999 | join: '' -%}
      {%- else -%}
        {%- assign full_desc = product.description -%}
      {%- endif -%}
      {%- assign clamp = section.settings.details_max_height | default: 0 -%}
      <div class="eeb-pdp__details {% if clamp > 0 %}is-clampable{% endif %}" data-clamp="{{ clamp }}">
        {%- if section.settings.details_heading != blank -%}
          <h2 class="eeb-pdp__details-heading">{{ section.settings.details_heading }}</h2>
        {%- endif -%}
        <div class="eeb-pdp__details-body rte" {% if clamp > 0 %}style="max-height:{{ clamp }}px;"{% endif %}>
          {{ full_desc }}
        </div>
        {%- if clamp > 0 -%}
          <button type="button" class="eeb-pdp__details-toggle" aria-expanded="false">
            <span data-more>Read more</span>
            <span data-less hidden>Show less</span>
          </button>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</section>

<script type="application/json" id="EebPdpVariants-{{ section.id }}">
  [
    {%- for v in product.variants -%}
      {
        "id": {{ v.id }},
        "options": {{ v.options | json }},
        "available": {{ v.available }},
        "price": {{ v.price | json }},
        "compare_at_price": {{ v.compare_at_price | json }},
        "price_formatted": {{ v.price | money | json }},
        "compare_at_formatted": {% if v.compare_at_price %}{{ v.compare_at_price | money | json }}{% else %}null{% endif %},
        "save_formatted": {% if v.compare_at_price > v.price %}{{ v.compare_at_price | minus: v.price | money | json }}{% else %}null{% endif %},
        "image": {% if v.featured_image %}{{ v.featured_image | image_url: width: 1400 | json }}{% else %}null{% endif %},
        "image_id": {% if v.featured_image %}{{ v.featured_image.id | json }}{% else %}null{% endif %}
      }{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
  ]
</script>

<script>
  (function(){
    var root = document.getElementById('EebPdp-{{ section.id }}');
    if(!root) return;
    var main = root.querySelector('.eeb-pdp__main-img');
    var thumbs = Array.prototype.slice.call(root.querySelectorAll('.eeb-pdp__thumb'));
    var current = 0;
    function show(i){
      if(!thumbs.length || !main) return;
      current = (i + thumbs.length) % thumbs.length;
      thumbs.forEach(function(x){ x.classList.remove('is-active'); });
      var t = thumbs[current];
      t.classList.add('is-active');
      main.src = t.dataset.full;
      try { t.scrollIntoView({ block: 'nearest', inline: 'nearest', behavior: 'smooth' }); } catch(e){}
    }
    thumbs.forEach(function(t, i){
      t.addEventListener('click', function(){ show(i); });
    });
    root.querySelectorAll('.eeb-pdp__nav').forEach(function(b){
      b.addEventListener('click', function(){ show(current + parseInt(b.dataset.dir, 10)); });
    });

    var qty = root.querySelector('.eeb-pdp__qty input');
    root.querySelectorAll('.eeb-pdp__qty-btn').forEach(function(b){
      b.addEventListener('click', function(){
        var step = parseInt(b.dataset.step, 10);
        qty.value = Math.max(1, (parseInt(qty.value,10)||1) + step);
      });
    });

    var select = root.querySelector('.eeb-pdp__variant-select');
    var variantsData = [];
    try {
      var vd = document.getElementById('EebPdpVariants-{{ section.id }}');
      if (vd) variantsData = JSON.parse(vd.textContent);
    } catch(e){}
    var selected = {};
    root.querySelectorAll('.eeb-pdp__option-btn.is-active').forEach(function(b){
      selected[b.dataset.optionIndex] = b.dataset.value;
    });
    function findVariant(){
      return variantsData.find(function(v){
        return Object.keys(selected).every(function(idx){
          return v.options[parseInt(idx,10)] === selected[idx];
        });
      });
    }
    function swapImageForVariant(variant){
      if(!variant || !variant.image || !main) return;
      // Try to find a matching thumb by image id and activate it
      var matched = thumbs.find(function(t){ return String(t.dataset.imageId) === String(variant.image_id); });
      if(matched){
        var idx = thumbs.indexOf(matched);
        show(idx);
      } else {
        main.src = variant.image;
      }
    }
    var priceNow = root.querySelector('[data-price-now]');
    var priceWas = root.querySelector('[data-price-was]');
    var priceSave = root.querySelector('[data-price-save]');
    var atcBtn = root.querySelector('.eeb-pdp__atc');
    var atcDefault = atcBtn ? atcBtn.textContent.trim() : 'Add to cart';
    var enquireBtn = root.querySelector('[data-enquire]');
    var productTitle = {{ product.title | json }};
    var currentVariantTitle = {{ variant.title | json }};
    function updateVariant(){
      var variant = findVariant();
      if(select && variant){ select.value = String(variant.id); }
      if(variant){
        currentVariantTitle = variant.options ? variant.options.join(' / ') : currentVariantTitle;
        if(priceNow) priceNow.textContent = variant.price_formatted;
        if(variant.compare_at_price && variant.compare_at_price > variant.price){
          if(priceWas){ priceWas.textContent = variant.compare_at_formatted; priceWas.hidden = false; }
          if(priceSave){ priceSave.textContent = 'Save ' + variant.save_formatted; priceSave.hidden = false; }
        } else {
          if(priceWas) priceWas.hidden = true;
          if(priceSave) priceSave.hidden = true;
        }
        if(atcBtn){
          atcBtn.disabled = !variant.available;
          atcBtn.textContent = variant.available ? atcDefault : 'Sold out';
        }
        if(enquireBtn){
          enquireBtn.hidden = !!variant.available;
        }
      }
      swapImageForVariant(variant);
    }
    if(enquireBtn){
      enquireBtn.addEventListener('click', function(){
        try {
          window.dispatchEvent(new CustomEvent('eeb:enquiry:open', {
            detail: {
              topic: 'Sold out — ' + productTitle,
              product: productTitle,
              variant: currentVariantTitle,
              enquiry_type: 'sold_out'
            }
          }));
        } catch(e){}
      });
    }
    root.querySelectorAll('.eeb-pdp__option-btn').forEach(function(b){
      b.addEventListener('click', function(){
        var idx = b.dataset.optionIndex;
        root.querySelectorAll('.eeb-pdp__option-btn[data-option-index="'+idx+'"]').forEach(function(x){x.classList.remove('is-active');});
        b.classList.add('is-active');
        selected[idx] = b.dataset.value;
        var label = root.querySelector('.eeb-pdp__option-value[data-option-index="'+idx+'"]');
        if(label) label.textContent = b.dataset.value;
        updateVariant();
      });
    });

    var details = root.querySelector('.eeb-pdp__details.is-clampable');
    if (details) {
      var body = details.querySelector('.eeb-pdp__details-body');
      var toggle = details.querySelector('.eeb-pdp__details-toggle');
      var more = details.querySelector('[data-more]');
      var less = details.querySelector('[data-less]');
      // Only show toggle if content actually exceeds the clamp.
      if (body && toggle && body.scrollHeight <= body.clientHeight + 4) {
        toggle.style.display = 'none';
      } else if (toggle) {
        toggle.addEventListener('click', function(){
          var expanded = toggle.getAttribute('aria-expanded') === 'true';
          if (expanded) {
            body.style.maxHeight = details.dataset.clamp + 'px';
            toggle.setAttribute('aria-expanded', 'false');
            more.hidden = false; less.hidden = true;
          } else {
            body.style.maxHeight = 'none';
            toggle.setAttribute('aria-expanded', 'true');
            more.hidden = true; less.hidden = false;
          }
        });
      }
    }
  })();
</script>

{% schema %}
{
  "name": "Product main",
  "settings": [
    { "type": "checkbox", "id": "show_breadcrumb", "label": "Show breadcrumb", "default": true },
    { "type": "select", "id": "eyebrow_source", "label": "Eyebrow source", "options": [
      { "value": "vendor", "label": "Product vendor" },
      { "value": "type", "label": "Product type" },
      { "value": "custom", "label": "Custom text" },
      { "value": "none", "label": "None" }
    ], "default": "type" },
    { "type": "text", "id": "eyebrow_custom", "label": "Custom eyebrow (if selected above)" },
    { "type": "text", "id": "atc_text", "label": "Add to cart button text", "default": "Add to cart" },
    { "type": "text", "id": "enquire_text", "label": "Sold-out enquire button text", "default": "Notify me / Enquire" },
    { "type": "header", "content": "Trust bullets" },
    { "type": "text", "id": "bullet_1", "label": "Bullet 1", "default": "Free shipping Australia-wide over $99" },
    { "type": "text", "id": "bullet_2", "label": "Bullet 2", "default": "12-month warranty" },
    { "type": "text", "id": "bullet_3", "label": "Bullet 3", "default": "Service & support through EEB dealer network" },
    { "type": "header", "content": "Full description" },
    { "type": "paragraph", "content": "Renders the full product description below the buy box. Insert <!-- split --> in the description to split a short teaser (above) from the full content (below)." },
    { "type": "checkbox", "id": "show_full_description", "label": "Show full description section", "default": true },
    { "type": "text", "id": "details_heading", "label": "Section heading", "default": "Product details" },
    { "type": "range", "id": "details_max_height", "label": "Clamp height (px, 0 = no clamp)", "min": 0, "max": 1200, "step": 50, "default": 0 }
  ],
  "presets": [{ "name": "Product main (standard)" }]
}
{% endschema %}
