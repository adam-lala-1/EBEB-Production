{%- comment -%}
  If an Article is picked, it can auto-populate the image, quote (excerpt)
  and link. Section-level settings override the article values when set.
{%- endcomment -%}
{%- assign art = section.settings.article -%}
{%- assign story_image = section.settings.image -%}
{%- if story_image == blank and art != blank and art.image != blank -%}
  {%- assign story_image = art.image -%}
{%- endif -%}
{%- assign story_quote = section.settings.quote -%}
{%- if story_quote == blank and art != blank -%}
  {%- assign story_quote = art.excerpt_or_content | strip_html | truncatewords: 45 -%}
{%- endif -%}
{%- assign story_link = section.settings.link -%}
{%- if story_link == blank and art != blank -%}
  {%- assign story_link = art.url -%}
{%- endif -%}

<section class="eeb-section eeb-section--cream">
  <div class="eeb-container">
    <span class="eeb-eyebrow">{{ section.settings.eyebrow }}</span>
    <div class="ride-story">
      <div class="ride-story__img">{% if story_image != blank %}<img src="{{ story_image | image_url: width: 1200 }}" alt="" loading="lazy">{% endif %}</div>
      <div class="ride-story__quote">
        <p>{{ story_quote }}</p>
        <div class="ride-story__attr">
          <strong>{{ section.settings.attribution }}</strong>
          <span>{{ section.settings.bike }}</span>
        </div>
        {%- if story_link != blank and section.settings.link_label != blank -%}
          <a class="ride-story__link eeb-btn eeb-btn--ghost" href="{{ story_link }}" style="margin-top:1rem;display:inline-block;">
            {{ section.settings.link_label }} &rarr;
          </a>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "EEB Product ride story",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "My Ride Story" },
    { "type": "image_picker", "id": "image", "label": "Photo" },
    { "type": "textarea", "id": "quote", "label": "Quote", "default": "I thought my cycling days were behind me. The Trident gave me my independence back — I ride to the shops, the park, everywhere. Life is a journey!" },
    { "type": "text", "id": "attribution", "label": "Attribution", "default": "Active at 72" },
    { "type": "text", "id": "bike", "label": "Bike model", "default": "Trident Semi-Recumbent" },
    { "type": "header", "content": "Pull from blog story (optional)" },
    { "type": "article", "id": "article", "label": "Blog story", "info": "If set, image / quote / link will pull from this article unless overridden above." },
    { "type": "header", "content": "Call to action" },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "Read the full story" },
    { "type": "url", "id": "link", "label": "Link", "info": "Overrides the article URL when set." }
  ],
  "presets": [{ "name": "EEB Product ride story" }]
}
{% endschema %}
