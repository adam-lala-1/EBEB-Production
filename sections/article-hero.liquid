{%- liquid
  assign word_count = article.content | strip_html | split: ' ' | size
  assign read_time = word_count | divided_by: 200 | at_least: 1
  assign use_image = section.settings.show_image
-%}
<section class="article-hero {% if use_image and article.image %}article-hero--image{% else %}article-hero--cream{% endif %}" {% if use_image and article.image %}style="background-image: linear-gradient(rgba(27,42,74,.55), rgba(27,42,74,.75)), url('{{ article.image | image_url: width: 2000 }}'); background-size: cover; background-position: center;"{% endif %}>
  <div class="eeb-container" style="max-width: 820px; text-align: center;">
    <nav class="article-hero__crumbs"><a href="{{ blog.url }}">← {{ blog.title }}</a></nav>
    {%- if article.tags.size > 0 -%}
      <span class="eeb-eyebrow article-hero__tag">{{ article.tags.first }}</span>
    {%- endif -%}
    <h1 class="article-hero__title">{{ article.title }}</h1>
    <div class="article-hero__meta">
      {%- if article.author != blank -%}<span>By {{ article.author }}</span><span class="dot">·</span>{%- endif -%}
      <span>{{ article.published_at | date: '%B %d, %Y' }}</span>
      <span class="dot">·</span>
      <span>{{ read_time }} min read</span>
    </div>
  </div>
</section>

<style>
  .article-hero { padding: 4rem 0 3rem; }
  .article-hero--cream { background: var(--color-cream); color: var(--color-navy); }
  .article-hero--image { color: #fff; padding: 6rem 0 4.5rem; }
  .article-hero__crumbs { font-size: .85rem; margin-bottom: 1rem; opacity: .85; }
  .article-hero__crumbs a { color: inherit; text-decoration: none; }
  .article-hero__crumbs a:hover { color: var(--color-orange); }
  .article-hero__tag { display: inline-block; margin-bottom: .75rem; }
  .article-hero__title { font-family: var(--font-heading); font-size: clamp(2rem, 4vw, 3rem); line-height: 1.15; margin: 0 0 1.25rem; }
  .article-hero__meta { display: flex; gap: .5rem; justify-content: center; flex-wrap: wrap; font-size: .9rem; opacity: .85; }
  .article-hero__meta .dot { opacity: .5; }
</style>

{% schema %}
{
  "name": "Article hero",
  "settings": [
    { "type": "checkbox", "id": "show_image", "label": "Use article image as background", "default": true }
  ],
  "presets": [{ "name": "Article hero" }]
}
{% endschema %}
