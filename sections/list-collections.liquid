{%- assign coll_source = section.settings.source | default: 'all' -%}
{%- if coll_source == 'all' -%}
  {%- assign collections_to_show = collections -%}
{%- else -%}
  {%- assign collections_to_show = section.blocks -%}
{%- endif -%}

<section class="eeb-collection-hero">
  <div class="eeb-container">
    {% if section.settings.eyebrow != blank %}<span class="eeb-eyebrow">{{ section.settings.eyebrow }}</span>{% endif %}
    <h1>{{ section.settings.heading }}</h1>
    {% if section.settings.subheading != blank %}<p class="eeb-collection-hero__desc">{{ section.settings.subheading }}</p>{% endif %}
  </div>
</section>

<section class="eeb-section">
  <div class="eeb-container">
    <div class="eeb-grid eeb-grid--{{ section.settings.columns | default: 3 }}">
      {%- if coll_source == 'all' -%}
        {%- for c in collections -%}
          {%- if c.handle != 'frontpage' and c.products_count > 0 -%}
            <a href="{{ c.url }}" class="eeb-card eeb-card--collection">
              <div class="eeb-card__img">
                {%- if c.image -%}
                  <img src="{{ c.image | image_url: width: 800 }}" alt="{{ c.title | escape }}" loading="lazy">
                {%- elsif c.products.first.featured_image -%}
                  <img src="{{ c.products.first.featured_image | image_url: width: 800 }}" alt="{{ c.title | escape }}" loading="lazy" style="object-fit:contain;background:#fff;padding:1rem;">
                {%- endif -%}
                <span class="eeb-card__overlay">
                  <span class="eeb-card__cta">Shop {{ c.title }} →</span>
                </span>
              </div>
              <div class="eeb-card__body">
                <h3>{{ c.title }}</h3>
                <p>{{ c.products_count }} {% if c.products_count == 1 %}product{% else %}products{% endif %}</p>
              </div>
            </a>
          {%- endif -%}
        {%- endfor -%}
      {%- else -%}
        {%- for block in section.blocks -%}
          {%- assign c = block.settings.collection -%}
          {%- if c != blank -%}
            <a href="{{ c.url }}" class="eeb-card eeb-card--collection" {{ block.shopify_attributes }}>
              <div class="eeb-card__img">
                {%- assign img = block.settings.image | default: c.image -%}
                {%- if img -%}
                  <img src="{{ img | image_url: width: 800 }}" alt="{{ c.title | escape }}" loading="lazy">
                {%- endif -%}
                <span class="eeb-card__overlay">
                  <span class="eeb-card__cta">Shop {{ c.title }} →</span>
                </span>
              </div>
              <div class="eeb-card__body">
                <h3>{{ block.settings.title | default: c.title }}</h3>
                <p>{{ block.settings.description | default: c.products_count | append: ' products' }}</p>
              </div>
            </a>
          {%- endif -%}
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Collections list",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Browse" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop all collections" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Find the perfect ride or upgrade — from family cargo bikes to adaptive trikes and everyday gear." },
    { "type": "select", "id": "source", "label": "Source", "options": [
      { "value": "all", "label": "All store collections (auto)" },
      { "value": "manual", "label": "Manually picked (use blocks below)" }
    ], "default": "all" },
    { "type": "select", "id": "columns", "label": "Columns (desktop)", "options": [
      { "value": "2", "label": "2" }, { "value": "3", "label": "3" }, { "value": "4", "label": "4" }
    ], "default": "3" }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Featured collection",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "image_picker", "id": "image", "label": "Override image (optional)" },
        { "type": "text", "id": "title", "label": "Override title (optional)" },
        { "type": "text", "id": "description", "label": "Override description (optional)" }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [{ "name": "Collections list" }]
}
{% endschema %}
