{%- liquid
  assign show_title = section.settings.show_title
  assign max_width = section.settings.max_width | default: 760
-%}
<section class="eeb-section page-body">
  <div class="eeb-container" style="max-width: {{ max_width }}px;">
    {%- if show_title -%}
      <h1 class="page-body__title">{{ page.title }}</h1>
    {%- endif -%}
    <div class="rte page-body__rte">
      {{ page.content }}
    </div>
  </div>
</section>

<style>
  .page-body { padding: 3.5rem 0; }
  .page-body__title { font-family: var(--font-heading); font-size: clamp(1.8rem, 3vw, 2.6rem); color: var(--color-navy); margin-bottom: 1.5rem; }
  .page-body__rte { font-size: 1.05rem; line-height: 1.75; color: var(--color-foreground); }
  .page-body__rte h2 { font-family: var(--font-heading); font-size: 1.75rem; color: var(--color-navy); margin: 2.5rem 0 1rem; }
  .page-body__rte h3 { font-family: var(--font-heading); font-size: 1.35rem; color: var(--color-navy); margin: 2rem 0 .75rem; }
  .page-body__rte p { margin: 0 0 1.25rem; }
  .page-body__rte ul, .page-body__rte ol { margin: 0 0 1.5rem 1.25rem; }
  .page-body__rte li { margin-bottom: .5rem; }
  .page-body__rte a { color: var(--color-orange); text-decoration: underline; text-underline-offset: 3px; }
  .page-body__rte img { border-radius: 1rem; margin: 2rem 0; max-width: 100%; height: auto; }
  .page-body__rte blockquote { border-left: 4px solid var(--color-orange); padding: .5rem 0 .5rem 1.25rem; margin: 2rem 0; font-style: italic; color: var(--color-navy); font-size: 1.15rem; }
</style>

{% schema %}
{
  "name": "Page main",
  "settings": [
    { "type": "checkbox", "id": "show_title", "label": "Show page title", "default": false, "info": "Turn off if using Page hero section above." },
    { "type": "range", "id": "max_width", "label": "Content max width (px)", "min": 600, "max": 1100, "step": 20, "default": 760 }
  ],
  "presets": [{ "name": "Page main" }]
}
{% endschema %}
