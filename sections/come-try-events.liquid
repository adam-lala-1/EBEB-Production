<section class="eeb-section" id="events">
  <div class="eeb-container">
    <div style="max-width: 640px; margin-bottom: 2.5rem;">
      {% if section.settings.eyebrow != blank %}
        <span class="eeb-eyebrow">{{ section.settings.eyebrow }}</span>
      {% endif %}
      <h2>{{ section.settings.heading }}</h2>
      {% if section.settings.subheading != blank %}
        <p style="color: var(--color-muted); font-size: 1.05rem;">{{ section.settings.subheading }}</p>
      {% endif %}
    </div>

    <div class="eeb-grid eeb-grid--2">
      {% for block in section.blocks %}
        <article class="eeb-dealer-card" {{ block.shopify_attributes }} style="display:flex;flex-direction:column;">
          <div class="eeb-dealer-card__body" style="flex:1;display:flex;flex-direction:column;">
            <div style="display:flex;justify-content:space-between;align-items:flex-start;gap:1rem;margin-bottom:.75rem;">
              {% if block.settings.tag != blank %}
                <span class="eeb-card__eyebrow">{{ block.settings.tag }}</span>
              {% endif %}
              {% if block.settings.capacity != blank %}
                <span style="font-size:.8rem;color:var(--color-muted);">{{ block.settings.capacity }}</span>
              {% endif %}
            </div>
            <h3>{{ block.settings.title }}</h3>
            <ul class="eeb-dealer-card__meta">
              {% if block.settings.date != blank %}<li><strong>Date:</strong> {{ block.settings.date }}</li>{% endif %}
              {% if block.settings.time != blank %}<li><strong>Time:</strong> {{ block.settings.time }}</li>{% endif %}
              {% if block.settings.location != blank %}<li><strong>Where:</strong> {{ block.settings.location }}</li>{% endif %}
            </ul>
            {% if block.settings.description != blank %}
              <p style="color:var(--color-muted);font-size:.95rem;margin:.75rem 0 1.25rem;flex:1;">{{ block.settings.description }}</p>
            {% endif %}
            <a class="eeb-btn eeb-btn--primary" href="{{ block.settings.rsvp_url | default: '#rsvp' }}" style="align-self:flex-start;">{{ block.settings.cta_text | default: 'RSVP' }}</a>
          </div>
        </article>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Come & Try events",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Upcoming" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Try-out events near you" },
    { "type": "textarea", "id": "subheading", "label": "Subheading" }
  ],
  "blocks": [
    {
      "type": "event",
      "name": "Event",
      "settings": [
        { "type": "text", "id": "tag", "label": "Region tag", "default": "Brisbane" },
        { "type": "text", "id": "capacity", "label": "Capacity note", "default": "Drop-in" },
        { "type": "text", "id": "title", "label": "Event title", "default": "Open Workshop" },
        { "type": "text", "id": "date", "label": "Date", "default": "Sat 15 Feb 2026" },
        { "type": "text", "id": "time", "label": "Time", "default": "10:00 AM – 2:00 PM" },
        { "type": "text", "id": "location", "label": "Location", "default": "EEB HQ — 6/51 Prospect Rd, Gaythorne QLD" },
        { "type": "textarea", "id": "description", "label": "Description" },
        { "type": "text", "id": "cta_text", "label": "CTA text", "default": "RSVP" },
        { "type": "url", "id": "rsvp_url", "label": "CTA URL" }
      ]
    }
  ],
  "max_blocks": 20,
  "presets": [
    {
      "name": "Come & Try events",
      "blocks": [
        { "type": "event", "settings": { "tag": "Brisbane", "capacity": "Drop-in", "title": "Gaythorne Open Workshop", "date": "Sat 15 Feb 2026", "time": "10:00 AM – 2:00 PM", "location": "EEB HQ — 6/51 Prospect Rd, Gaythorne QLD", "description": "Test ride the full EEB range, including Trident trikes and cargo bikes. Coffee and fittings on us." } },
        { "type": "event", "settings": { "tag": "Brisbane", "capacity": "RSVP required", "title": "South Bank Riverwalk Demo", "date": "Sun 8 Mar 2026", "time": "9:30 AM – 12:30 PM", "location": "South Bank Parklands, Brisbane", "description": "Try a Trident or commuter ebike along the river. Great for first-time riders and families." } },
        { "type": "event", "settings": { "tag": "Sunshine Coast", "capacity": "Bookings essential", "title": "Sunshine Coast Adaptive Day", "date": "Sat 12 Apr 2026", "time": "10:00 AM – 3:00 PM", "location": "Cotton Tree, Maroochydore", "description": "Adaptive and accessible cycling demo. OTs and support workers welcome — bring a client to trial a fit." } },
        { "type": "event", "settings": { "tag": "Gold Coast", "capacity": "Drop-in", "title": "Gold Coast Trike Try-Out", "date": "Sat 3 May 2026", "time": "11:00 AM – 2:00 PM", "location": "Burleigh Heads Foreshore", "description": "Trident trikes on the boardwalk — stable, electric, and easy to ride for any ability." } }
      ]
    }
  ]
}
{% endschema %}
