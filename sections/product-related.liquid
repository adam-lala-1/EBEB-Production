{%- assign source = section.settings.collection -%}
{%- if source == blank and product.collections.size > 0 -%}
  {%- assign source = product.collections.first -%}
{%- endif -%}

{%- if source != blank and source.products.size > 1 -%}
<section class="eeb-section">
  <div class="eeb-container">
    <h2 style="text-align:center;margin-bottom:2rem;">{{ section.settings.heading }}</h2>
    <div class="eeb-grid eeb-grid--4">
      {%- assign shown = 0 -%}
      {%- for p in source.products -%}
        {%- if p.id != product.id and shown < 4 -%}
          <a href="{{ p.url }}" class="eeb-card">
            <div class="eeb-card__img">
              {%- if p.featured_image -%}
                <img src="{{ p.featured_image | image_url: width: 600 }}" alt="{{ p.title | escape }}" loading="lazy" style="object-fit:contain;background:#fff;padding:1rem;">
              {%- endif -%}
            </div>
            <div class="eeb-card__body">
              <h3>{{ p.title }}</h3>
              <p>{{ p.price | money }}</p>
            </div>
          </a>
          {%- assign shown = shown | plus: 1 -%}
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "Product related",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "You might also like" },
    { "type": "collection", "id": "collection", "label": "Collection (leave empty to auto-pick product's collection)" }
  ],
  "presets": [{ "name": "Product related" }]
}
{% endschema %}
