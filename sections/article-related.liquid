{%- liquid
  assign limit = section.settings.limit | default: 3
  assign count = 0
-%}
<section class="eeb-section article-related eeb-section--cream">
  <div class="eeb-container">
    <h2 class="article-related__heading">{{ section.settings.heading }}</h2>
    <div class="eeb-grid eeb-grid--3">
      {%- for related in blog.articles -%}
        {%- if related.id == article.id -%}{%- continue -%}{%- endif -%}
        {%- if count >= limit -%}{%- break -%}{%- endif -%}
        <a href="{{ related.url }}" class="eeb-card">
          {%- if related.image -%}
            <div class="eeb-card__img"><img src="{{ related.image | image_url: width: 800 }}" alt="{{ related.title | escape }}" loading="lazy"></div>
          {%- endif -%}
          <div class="eeb-card__body">
            <span class="eeb-card__eyebrow">{{ related.published_at | date: '%b %d, %Y' }}</span>
            <h3 style="font-family:var(--font-heading);color:var(--color-navy);font-size:1.15rem;margin:.5rem 0;">{{ related.title }}</h3>
            <p style="color:var(--color-muted);font-size:.9rem;line-height:1.5;">{{ related.excerpt_or_content | strip_html | truncate: 110 }}</p>
          </div>
        </a>
        {%- assign count = count | plus: 1 -%}
      {%- endfor -%}
    </div>
  </div>
</section>

<style>
  .article-related { padding: 3.5rem 0; }
  .article-related__heading { font-family: var(--font-heading); color: var(--color-navy); font-size: 1.75rem; text-align: center; margin-bottom: 2rem; }
</style>

{% schema %}
{
  "name": "Article related posts",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Keep reading" },
    { "type": "range", "id": "limit", "label": "Number of posts", "min": 2, "max": 6, "step": 1, "default": 3 }
  ],
  "presets": [{ "name": "Article related posts" }]
}
{% endschema %}
