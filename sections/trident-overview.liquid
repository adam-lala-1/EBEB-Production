<section>
  <div class="trident-overview" data-product-overview id="ProductOverview-{{ section.id }}">
    <div>
      <h1>{{ product.title | default: section.settings.title_fallback }}</h1>
      <p style="color: var(--color-muted); font-size: 1.1rem;">{{ product.metafields.eeb.subtitle | default: section.settings.subtitle }}</p>
      <p class="trident-overview__price" data-product-price>
        {%- if product -%}{{ product.price | money }}{%- else -%}{{ section.settings.price_fallback }}{%- endif -%}
      </p>
    </div>

    {% form 'product', product, data-product-form: '' %}
      <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}" data-variant-id>

      <div style="display:flex;flex-direction:column;gap:1.5rem;">
        {%- for option in product.options_with_values -%}
          {%- assign is_colour = false -%}
          {%- if option.name contains 'Colour' or option.name contains 'Color' -%}
            {%- assign is_colour = true -%}
          {%- endif -%}

          <div data-option-wrapper data-option-position="{{ option.position }}">
            <p style="font-size:.85rem;font-weight:500;color:var(--color-muted);margin-bottom:.5rem;">
              {{ option.name }}: <span data-option-selected>{{ option.selected_value }}</span>
            </p>
            <div style="display:flex;gap:.5rem;flex-wrap:wrap;" class="{% if is_colour %}swatches{% endif %}">
              {%- for value in option.values -%}
                {%- assign checked = false -%}
                {%- if value == option.selected_value -%}{%- assign checked = true -%}{%- endif -%}
                <label
                  class="{% if is_colour %}swatch{% if checked %} is-active{% endif %}{% else %}eeb-btn{% endif %}"
                  {% if is_colour %}style="background: {{ value | downcase | handle }};" aria-label="{{ value }}" title="{{ value }}"{% else %}style="padding:.5rem 1rem;font-size:.85rem;cursor:pointer;{% if checked %}background:var(--color-foreground);color:#fff;{% else %}background:var(--color-cream);color:var(--color-foreground);{% endif %}"{% endif %}
                >
                  <input
                    type="radio"
                    name="option-{{ option.position }}"
                    value="{{ value | escape }}"
                    data-option-input
                    data-option-position="{{ option.position }}"
                    {% if checked %}checked{% endif %}
                    style="position:absolute;opacity:0;pointer-events:none;width:0;height:0;"
                  >
                  {% unless is_colour %}{{ value }}{% endunless %}
                </label>
              {%- endfor -%}
            </div>
          </div>
        {%- endfor -%}

        <button type="submit" class="eeb-btn eeb-btn--primary" style="width:100%;" data-add-to-cart>
          {%- if product.available -%}{{ section.settings.cta_text | default: 'Enquire Now' }}{%- else -%}Sold out{%- endif -%}
        </button>

        <button type="button" class="eeb-btn eeb-trident__enquire" data-enquire {% if product.available %}hidden{% endif %} style="width:100%;background:#fff;color:var(--color-orange,#E86C2C);border:2px solid var(--color-orange,#E86C2C);font-weight:600;">
          {{ section.settings.enquire_text | default: 'Notify me / Enquire' }}
        </button>
      </div>
    {% endform %}

    {%- assign has_bullets = false -%}
    {%- for block in section.blocks -%}
      {%- if block.type == 'trust_bullet' and block.settings.text != blank -%}{%- assign has_bullets = true -%}{%- endif -%}
    {%- endfor -%}
    {%- if has_bullets -%}
      <ul class="eeb-trust-bullets" style="list-style:none;padding:0;margin:1.25rem 0 0;display:grid;grid-template-columns:1fr;gap:1rem;">
        {%- for block in section.blocks -%}
          {%- if block.type == 'trust_bullet' and block.settings.text != blank -%}
            <li {{ block.shopify_attributes }} style="display:flex;flex-direction:column;align-items:center;text-align:center;gap:.4rem;font-size:.8rem;color:var(--color-foreground,#1B2A4A);">
              <span style="color:var(--color-orange,#E86C2C);display:inline-flex;flex-shrink:0;">{% render 'icon', icon: block.settings.icon, size: 20 %}</span>
              <span>{{ block.settings.text }}</span>
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
      <style>
        @media (min-width: 750px) {
          #ProductOverview-{{ section.id }} .eeb-trust-bullets {
            grid-template-columns: repeat({{ section.blocks | where: 'type', 'trust_bullet' | size }}, minmax(0, 1fr));
            gap: .75rem;
          }
        }
      </style>
    {%- endif -%}
  </div>
</section>

{%- if product -%}
<script type="application/json" data-variants-json-{{ section.id }}>
  {{ product.variants | json }}
</script>
<script>
  (function() {
    var root = document.getElementById('ProductOverview-{{ section.id }}');
    if (!root) return;
    var variantsScript = document.querySelector('[data-variants-json-{{ section.id }}]');
    if (!variantsScript) return;
    var variants;
    try { variants = JSON.parse(variantsScript.textContent); } catch (e) { return; }

    var hiddenId = root.querySelector('[data-variant-id]');
    var priceEl  = root.querySelector('[data-product-price]');
    var cta      = root.querySelector('[data-add-to-cart]');
    var inputs   = root.querySelectorAll('[data-option-input]');

    function formatMoney(price) {
      var cents = typeof price === 'string' ? parseInt(price, 10) : price;
      if (isNaN(cents)) return '';
      try {
        return '$' + (cents / 100).toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 });
      } catch (e) { return '$' + (cents / 100).toFixed(2); }
    }

    function setPrice(variant) {
      if (!priceEl || !variant) return;
      // Use Shopify Ajax API for accurate localized formatting when available
      if (window.Shopify && Shopify.formatMoney) {
        priceEl.textContent = Shopify.formatMoney(variant.price);
      } else {
        priceEl.textContent = formatMoney(variant.price);
      }
    }

    function selectedValues() {
      var values = [];
      root.querySelectorAll('[data-option-wrapper]').forEach(function(wrap) {
        var pos = wrap.getAttribute('data-option-position');
        var checked = wrap.querySelector('input[data-option-input]:checked');
        if (checked) values[parseInt(pos, 10) - 1] = checked.value;
        var label = wrap.querySelector('[data-option-selected]');
        if (label && checked) label.textContent = checked.value;
      });
      return values;
    }

    function matchVariant(values) {
      return variants.find(function(v) {
        return (v.options || []).every(function(o, i) { return o === values[i]; });
      });
    }

    function update() {
      var values = selectedValues();
      var variant = matchVariant(values);

      // Update active styling
      root.querySelectorAll('[data-option-wrapper]').forEach(function(wrap) {
        wrap.querySelectorAll('label').forEach(function(label) {
          var input = label.querySelector('input[data-option-input]');
          if (!input) return;
          var isColour = label.classList.contains('swatch');
          if (input.checked) {
            if (isColour) {
              label.classList.add('is-active');
            } else {
              label.style.background = 'var(--color-foreground)';
              label.style.color = '#fff';
            }
          } else {
            if (isColour) {
              label.classList.remove('is-active');
            } else {
              label.style.background = 'var(--color-cream)';
              label.style.color = 'var(--color-foreground)';
            }
          }
        });
      });

      var enquireBtn = root.querySelector('[data-enquire]');
      var productTitle = {{ product.title | json }};

      if (variant) {
        hiddenId.value = variant.id;
        setPrice(variant);
        if (cta) {
          cta.disabled = !variant.available;
          cta.textContent = variant.available ? {{ section.settings.cta_text | default: 'Enquire Now' | json }} : 'Sold out';
        }
        if (enquireBtn) {
          enquireBtn.hidden = !!variant.available;
        }
        // Broadcast to gallery (and any other listeners) so the image can swap.
        try {
          document.dispatchEvent(new CustomEvent('eeb:variant:change', {
            detail: {
              variantId: variant.id,
              featuredImageId: variant.featured_image ? variant.featured_image.id : null,
              featuredImageSrc: variant.featured_image ? variant.featured_image.src : null
            }
          }));
        } catch (e) {}
      } else if (cta) {
        cta.disabled = true;
        cta.textContent = 'Unavailable';
      }
    }

    inputs.forEach(function(input) {
      input.addEventListener('change', update);
    });

    var enquireBtnInit = root.querySelector('[data-enquire]');
    if (enquireBtnInit) {
      enquireBtnInit.addEventListener('click', function () {
        var values = selectedValues();
        var variant = matchVariant(values);
        var variantTitle = variant && variant.options ? variant.options.join(' / ') : '';
        var title = {{ product.title | json }};
        try {
          window.dispatchEvent(new CustomEvent('eeb:enquiry:open', {
            detail: {
              topic: 'Sold out — ' + title,
              product: title,
              variant: variantTitle,
              enquiry_type: 'sold_out'
            }
          }));
        } catch (e) {}
      });
    }

    update();
  })();
</script>
{%- endif -%}

{% schema %}
{
  "name": "EEB Product overview",
  "settings": [
    { "type": "text", "id": "title_fallback", "label": "Title fallback", "default": "Trident FT v3" },
    { "type": "text", "id": "subtitle", "label": "Subtitle", "default": "Semi-Recumbent Fat Tyre Electric Tricycle" },
    { "type": "text", "id": "price_fallback", "label": "Price fallback", "default": "$6,000" },
    { "type": "text", "id": "cta_text", "label": "CTA button text", "default": "Enquire Now" },
    { "type": "text", "id": "enquire_text", "label": "Sold-out enquire button text", "default": "Notify me / Enquire" }
  ],
  "blocks": [
    {
      "type": "trust_bullet",
      "name": "Trust bullet",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "shield", "label": "Shield (warranty)" },
            { "value": "shield-check", "label": "Shield check" },
            { "value": "wrench", "label": "Wrench (service)" },
            { "value": "users", "label": "Users (community / NDIS)" },
            { "value": "bike", "label": "Bike" },
            { "value": "truck", "label": "Truck (shipping)" },
            { "value": "gauge", "label": "Gauge" },
            { "value": "heart", "label": "Heart" },
            { "value": "battery", "label": "Battery" }
          ],
          "default": "shield"
        },
        { "type": "text", "id": "text", "label": "Bullet text" }
      ]
    }
  ],
  "presets": [{ "name": "EEB Product overview" }]
}
{% endschema %}
