{%- assign s = section.settings -%}
<footer class="eeb-footer">
  <div class="eeb-footer__grid">
    {%- comment -%} Brand column {%- endcomment -%}
    <div class="eeb-footer__col eeb-footer__brand">
      {%- if s.logo != blank -%}
        <img src="{{ s.logo | image_url: width: 400 }}" alt="{{ shop.name }}" width="{{ s.logo_width | default: 160 }}" style="max-width: {{ s.logo_width | default: 160 }}px; height: auto; margin-bottom: 1rem;">
      {%- endif -%}
      {%- if s.tagline != blank -%}
        <p class="eeb-footer__tagline">{{ s.tagline }}</p>
      {%- endif -%}
      {%- if s.facebook_url != blank or s.instagram_url != blank or s.youtube_url != blank -%}
        <div class="eeb-footer__social" role="navigation" aria-label="Social media">
          {%- if s.facebook_url != blank -%}
            <a href="{{ s.facebook_url }}" target="_blank" rel="noopener noreferrer" aria-label="Facebook"><svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M22 12c0-5.52-4.48-10-10-10S2 6.48 2 12c0 4.99 3.66 9.13 8.44 9.88v-6.99H7.9V12h2.54V9.8c0-2.51 1.49-3.89 3.77-3.89 1.09 0 2.24.19 2.24.19v2.47h-1.26c-1.24 0-1.63.77-1.63 1.56V12h2.77l-.44 2.89h-2.33v6.99C18.34 21.13 22 16.99 22 12z"/></svg></a>
          {%- endif -%}
          {%- if s.instagram_url != blank -%}
            <a href="{{ s.instagram_url }}" target="_blank" rel="noopener noreferrer" aria-label="Instagram"><svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2.16c3.2 0 3.58.01 4.85.07 1.17.05 1.8.25 2.23.41.56.22.96.48 1.38.9.42.42.68.82.9 1.38.16.42.36 1.06.41 2.23.06 1.27.07 1.65.07 4.85s-.01 3.58-.07 4.85c-.05 1.17-.25 1.8-.41 2.23-.22.56-.48.96-.9 1.38-.42.42-.82.68-1.38.9-.42.16-1.06.36-2.23.41-1.27.06-1.65.07-4.85.07s-3.58-.01-4.85-.07c-1.17-.05-1.8-.25-2.23-.41-.56-.22-.96-.48-1.38-.9-.42-.42-.68-.82-.9-1.38-.16-.42-.36-1.06-.41-2.23-.06-1.27-.07-1.65-.07-4.85s.01-3.58.07-4.85c.05-1.17.25-1.8.41-2.23.22-.56.48-.96.9-1.38.42-.42.82-.68 1.38-.9.42-.16 1.06-.36 2.23-.41 1.27-.06 1.65-.07 4.85-.07M12 0C8.74 0 8.33.01 7.05.07 5.78.13 4.9.33 4.14.63c-.79.31-1.46.72-2.13 1.39C1.34 2.69.93 3.36.62 4.15.32 4.91.12 5.78.06 7.05.01 8.33 0 8.74 0 12s.01 3.67.07 4.95c.06 1.27.26 2.14.56 2.91.31.79.72 1.46 1.39 2.13.67.67 1.34 1.08 2.13 1.39.77.3 1.64.5 2.91.56C8.33 23.99 8.74 24 12 24s3.67-.01 4.95-.07c1.27-.06 2.14-.26 2.91-.56.79-.31 1.46-.72 2.13-1.39.67-.67 1.08-1.34 1.39-2.13.3-.77.5-1.64.56-2.91.06-1.28.07-1.69.07-4.95s-.01-3.67-.07-4.95c-.06-1.27-.26-2.14-.56-2.91-.31-.79-.72-1.46-1.39-2.13C21.31 1.34 20.64.93 19.85.62 19.09.32 18.22.12 16.95.06 15.67.01 15.26 0 12 0zm0 5.84a6.16 6.16 0 1 0 0 12.32 6.16 6.16 0 0 0 0-12.32zm0 10.16a4 4 0 1 1 0-8 4 4 0 0 1 0 8zm6.41-11.85a1.44 1.44 0 1 0 0 2.88 1.44 1.44 0 0 0 0-2.88z"/></svg></a>
          {%- endif -%}
          {%- if s.youtube_url != blank -%}
            <a href="{{ s.youtube_url }}" target="_blank" rel="noopener noreferrer" aria-label="YouTube"><svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M23.5 6.2a3.02 3.02 0 0 0-2.13-2.14C19.47 3.55 12 3.55 12 3.55s-7.47 0-9.37.51A3.02 3.02 0 0 0 .5 6.2C0 8.1 0 12 0 12s0 3.9.5 5.8a3.02 3.02 0 0 0 2.13 2.14c1.9.51 9.37.51 9.37.51s7.47 0 9.37-.51a3.02 3.02 0 0 0 2.13-2.14c.5-1.9.5-5.8.5-5.8s0-3.9-.5-5.8zM9.6 15.6V8.4l6.2 3.6-6.2 3.6z"/></svg></a>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>

    {%- comment -%} Link column blocks {%- endcomment -%}
    {%- for block in section.blocks -%}
      {%- if block.type == 'link_column' -%}
        <div class="eeb-footer__col" {{ block.shopify_attributes }}>
          <h4>{{ block.settings.heading }}</h4>
          {%- if block.settings.menu != blank -%}
            {%- for link in block.settings.menu.links -%}
              <a href="{{ link.url }}">{{ link.title }}</a>
            {%- endfor -%}
          {%- endif -%}
        </div>
      {%- endif -%}
    {%- endfor -%}

    {%- comment -%} Opening hours column {%- endcomment -%}
    <div class="eeb-footer__col eeb-footer__hours">
      <h4>{{ s.hours_heading | default: 'Opening Hours' }}</h4>
      {%- assign days = 'Mon,Tue,Wed,Thu,Fri,Sat,Sun' | split: ',' -%}
      {%- assign vals = s.hours_mon | append: '|' | append: s.hours_tue | append: '|' | append: s.hours_wed | append: '|' | append: s.hours_thu | append: '|' | append: s.hours_fri | append: '|' | append: s.hours_sat | append: '|' | append: s.hours_sun | split: '|' -%}
      <ul>
        {%- for d in days -%}
          {%- assign v = vals[forloop.index0] -%}
          {%- if v != blank -%}
            <li><span class="eeb-footer__day">{{ d }}</span><span class="eeb-footer__time">{{ v }}</span></li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    </div>

    {%- comment -%} Contact column {%- endcomment -%}
    <div class="eeb-footer__col">
      <h4>Contact</h4>
      {%- if s.address_line != blank -%}
        <a href="{{ s.address_map_url | default: '#' }}" target="_blank" rel="noopener">{{ s.address_line }}</a>
      {%- endif -%}
      {%- if s.phone_display != blank -%}
        <a href="tel:{{ s.phone_tel | default: s.phone_display | replace: ' ', '' }}">{{ s.phone_display }}</a>
      {%- endif -%}
      {%- if s.email != blank -%}
        <a href="mailto:{{ s.email }}">{{ s.email }}</a>
      {%- endif -%}
    </div>
  </div>

  <div class="eeb-footer__bottom">
    © {{ 'now' | date: '%Y' }} {{ shop.name }}{% if s.tagline != blank %} — {{ s.tagline }}{% endif %}
    {%- if s.bottom_text != blank %} · {{ s.bottom_text }}{% endif -%}
  </div>
</footer>

<style>
  .eeb-footer__grid { grid-template-columns: 1fr; }
  @media (min-width: 700px) { .eeb-footer__grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1000px) { .eeb-footer__grid { grid-template-columns: 1.4fr 1fr 1fr 1.1fr 1.2fr; } }
  .eeb-footer__tagline { opacity: .8; font-size: .95rem; margin-bottom: 1rem; }
  .eeb-footer__social { display: flex; gap: 12px; margin-top: 12px; }
  .eeb-footer__social a {
    width: 36px; height: 36px; border-radius: 999px;
    display: inline-flex; align-items: center; justify-content: center;
    background: rgba(255,255,255,0.1); color: #fff;
    transition: background-color 0.2s ease;
  }
  .eeb-footer__social a:hover { background: var(--color-orange, #E86C2C); }
  .eeb-footer__hours ul { list-style: none; padding: 0; margin: 0; }
  .eeb-footer__hours li { display: flex; justify-content: space-between; gap: .75rem; font-size: .9rem; padding: .2rem 0; opacity: .85; }
  .eeb-footer__hours .eeb-footer__day { font-weight: 600; opacity: .7; }
</style>

{% schema %}
{
  "name": "EEB Footer",
  "tag": "section",
  "class": "shopify-section-footer-eeb",
  "settings": [
    { "type": "header", "content": "Brand" },
    { "type": "image_picker", "id": "logo", "label": "Logo" },
    { "type": "range", "id": "logo_width", "label": "Logo width", "min": 80, "max": 300, "step": 10, "default": 160, "unit": "px" },
    { "type": "text", "id": "tagline", "label": "Tagline", "default": "Mobility for every body." },
    { "type": "header", "content": "Social links" },
    { "type": "url", "id": "facebook_url", "label": "Facebook URL" },
    { "type": "url", "id": "instagram_url", "label": "Instagram URL" },
    { "type": "url", "id": "youtube_url", "label": "YouTube URL" },
    { "type": "header", "content": "Contact" },
    { "type": "text", "id": "address_line", "label": "Address", "default": "6/51 Prospect Rd, Gaythorne QLD 4051" },
    { "type": "url", "id": "address_map_url", "label": "Map link (Google Maps URL)" },
    { "type": "text", "id": "phone_display", "label": "Phone (display)", "default": "0409 126 669" },
    { "type": "text", "id": "phone_tel", "label": "Phone (tel: link)", "default": "+61409126669" },
    { "type": "text", "id": "email", "label": "Email", "default": "hello@everybodyebikes.com.au" },
    { "type": "header", "content": "Opening hours" },
    { "type": "text", "id": "hours_heading", "label": "Heading", "default": "Opening Hours" },
    { "type": "text", "id": "hours_mon", "label": "Monday", "default": "9AM – 5PM" },
    { "type": "text", "id": "hours_tue", "label": "Tuesday", "default": "9AM – 5PM" },
    { "type": "text", "id": "hours_wed", "label": "Wednesday", "default": "9AM – 5PM" },
    { "type": "text", "id": "hours_thu", "label": "Thursday", "default": "9AM – 5PM" },
    { "type": "text", "id": "hours_fri", "label": "Friday", "default": "9AM – 5PM" },
    { "type": "text", "id": "hours_sat", "label": "Saturday", "default": "10AM – 4PM" },
    { "type": "text", "id": "hours_sun", "label": "Sunday", "default": "Closed" },
    { "type": "header", "content": "Bottom" },
    { "type": "text", "id": "bottom_text", "label": "Extra bottom text" }
  ],
  "blocks": [
    {
      "type": "link_column",
      "name": "Link column",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Shop" },
        { "type": "link_list", "id": "menu", "label": "Menu" }
      ]
    }
  ],
  "presets": [
    {
      "name": "EEB Footer",
      "blocks": [
        { "type": "link_column", "settings": { "heading": "Shop" } },
        { "type": "link_column", "settings": { "heading": "Support" } }
      ]
    }
  ]
}
{% endschema %}
